diff --git a/NativeGpuLatency.h b/NativeGpuLatency.h
new file mode 100644
index 0000000..2fe58f2
--- /dev/null
+++ b/NativeGpuLatency.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_GPU_LATENCY_H
+#define NATIVE_GPU_LATENCY_H
+#include <stdint.h>
+
+/* Runtime stages kept in the render server's frame trace: command, memory,
+ * completion and scheduling. */
+static inline bool native_gpu_latency_stage(uint32_t stage) {
+    return (stage >= 1 && stage <= 16) || (stage >= 40 && stage <= 57);
+}
+/* The kernel ring keeps GPU submission and retirement, display arrival, fence
+ * and latch, build identity, the render threads the CPU sampler follows and
+ * each process's Metal refusals (event 65, the text of what failed). */
+static inline bool native_gpu_latency_event(uint32_t event,const uint64_t *,uint32_t) {
+    switch(event) {
+    case 1:case 3:case 10:case 11:case 20:case 21:case 22:case 23:case 63:case 65:return true;
+    default:return false;
+    }
+}
+
+/* A pending display query retains transitions and a 100 ms heartbeat, plus the
+ * number of identical queries omitted. Completion is always retained. */
+struct NativeGpuLatencyWaits {
+    struct Slot {uint32_t busy=0,pid=0,reason=0;uint64_t request=0,target=0,when=0,omitted=0;};
+    Slot slots[32]{};
+    bool keep(uint64_t now,uint32_t pid,uint64_t request,uint32_t reason,uint64_t target,uint64_t &omitted) {
+        Slot &s=slots[(request ^ pid)&31];uint32_t free=0;
+        if(!__atomic_compare_exchange_n(&s.busy,&free,1,false,__ATOMIC_ACQUIRE,__ATOMIC_RELAXED))return true;
+        const bool same=s.request==request && s.pid==pid && s.target==target;
+        const bool pending=reason==3 || reason==4;
+        const bool emit=!pending || !same || s.reason!=reason || now-s.when>=100000;
+        if(emit) {
+            omitted=same?s.omitted:0;
+            s.pid=pid;s.request=request;s.target=target;s.reason=reason;s.when=now;s.omitted=0;
+        } else ++s.omitted;
+        __atomic_store_n(&s.busy,0,__ATOMIC_RELEASE);return emit;
+    }
+};
+#endif
diff --git a/NativeGpuTrace.h b/NativeGpuTrace.h
new file mode 100644
index 0000000..b940b56
--- /dev/null
+++ b/NativeGpuTrace.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_GPU_TRACE_H
+#define NATIVE_GPU_TRACE_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* Diagnostic ABI, independent of rendering policy. All times are uptime us.
+ * Event fields and joins are documented by scripts/decode-gpu-trace.py. */
+enum { NativeGpuTraceVersion=1, NativeGpuTraceNote=3, NativeGpuTraceMethod=0x7102,
+       NativeGpuTraceCapacity=65536, NativeGpuTraceMetadata=4096 };
+enum {
+    GpuTraceConfig=1, GpuTraceBuild=3,
+    GpuTraceSubmit=10, GpuTraceRetire=11,
+    GpuTraceDisplay=20, GpuTraceDisplaySurface=21, GpuTraceDisplayFence=22,
+    GpuTraceDisplayLatch=23, GpuTraceTurnipPass=36, GpuTraceTurnipGmemSide=37, GpuTraceTurnipAttachment=44,
+    GpuTraceThread=63, GpuTraceProblem=65
+};
+struct NativeGpuTraceRecord {
+    uint64_t sequence,us;
+    uint32_t event,pid;
+    uint64_t value[12];
+};
+struct NativeGpuTraceHeader {
+    uint32_t magic,version,record_bytes,count;
+    uint64_t issued,dropped;
+};
+#ifdef __cplusplus
+static_assert(sizeof(NativeGpuTraceRecord)==120,"GPU trace record ABI");
+extern "C" {
+#endif
+#ifdef NATIVE_GPU_TRACE_OPTIONAL
+#define NATIVE_GPU_TRACE_LINK __attribute__((weak_import))
+#else
+#define NATIVE_GPU_TRACE_LINK
+#endif
+int native_gpu_trace_enabled(void) NATIVE_GPU_TRACE_LINK;
+void native_gpu_trace_record(uint32_t event,uint32_t pid,const uint64_t *values,uint32_t count) NATIVE_GPU_TRACE_LINK;
+uint32_t native_gpu_trace_snapshot(void *out,uint32_t bytes);
+#ifdef __cplusplus
+}
+template<typename... T> static inline void gpuTraceEvent(uint32_t event,uint32_t pid,T... args) {
+#ifdef NATIVE_GPU_TRACE_OPTIONAL
+    if(!&native_gpu_trace_record)return;
+#endif
+    const uint64_t words[]={uint64_t(args)...};
+    native_gpu_trace_record(event,pid,words,sizeof...(args));
+}
+#endif
+#undef NATIVE_GPU_TRACE_LINK
+#endif
