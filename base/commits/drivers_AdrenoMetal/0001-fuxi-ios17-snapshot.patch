++struct Slot {
++    when: AtomicU64,
++    id: AtomicU64,
++    /// stage | arg << 16 | sequence << 32: a reader takes the slot only where the sequence is the
++    /// one it asked for.
++    word: AtomicU64,
++}
++
++#[allow(clippy::declare_interior_mutable_const)]
