+            char *end = strchr(line, '\n');
+            if (end) *end = 0;
+            if (pass % 5 == 0) os_log(OS_LOG_DEFAULT, "NativeAdrenoMetal table: %{public}s", line);
+            if (row < 48 && strncmp(sent[row], line, sizeof sent[row] - 1)) {
+                strlcpy(sent[row], line, sizeof sent[row]);
