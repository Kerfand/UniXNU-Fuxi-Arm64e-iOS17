+                    g->mark(0x8000u | (a << 7) | b);
+                }
+            }
+            if (!end) {++row; break;}
+            line = end + 1;
+        }
+        for (; row < 48; ++row)
+            if (sent[row][0]) {sent[row][0] = 0; g->mark(0xC000u | row);}
+        sleep(6);
+    }
