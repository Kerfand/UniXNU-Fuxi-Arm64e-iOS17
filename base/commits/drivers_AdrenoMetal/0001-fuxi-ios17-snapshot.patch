++/// One record as [`read`] gives it.
++#[derive(Clone, Copy, Debug, Default)]
++#[repr(C)]
++pub struct StageRecord {
++    /// Host uptime nanoseconds.
++    pub when: u64,
++    /// The command buffer's id (0: the scheduler's thread).
++    pub id: u64,
++    /// Its place among all records.
++    pub sequence: u32,
++    /// [`Stage`] as its number.
++    pub stage: u16,
++    /// The stage's argument.
++    pub arg: u16,
++}
