++        let body = format!(
++            r#"  %p = getelementptr i32, ptr addrspace(2) getelementptr ([{count} x i32], ptr addrspace(2) @table, i64 0, i64 128), i32 %t
++  %v0 = load volatile i32, ptr addrspace(2) %p, align 4
