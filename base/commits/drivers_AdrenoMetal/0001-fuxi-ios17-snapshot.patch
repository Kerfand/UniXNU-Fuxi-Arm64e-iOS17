++            // In a section of the exit guard, as every Vulkan call of a thread of the runtime's is:
++            // a parked image or buffer, a kept empty block and a spare whose time is up go here.
++            device.age_parked();
++            let parts = device.shared();
++            crate::memory::age_spares(&parts.memory, parts.vk());
++        }
++        // Outside the state's lock: it may be the device's last handle, whose teardown stops
++        // this thread.
++        drop(device);
++    }
++}
