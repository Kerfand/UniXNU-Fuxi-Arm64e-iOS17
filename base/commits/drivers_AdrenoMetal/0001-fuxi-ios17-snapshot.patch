++    let slot = &SLOTS[(sequence as usize) & (RING - 1)];
++    slot.word.store(0, Ordering::Release);
++    slot.when.store(now_nanos(), Ordering::Relaxed);
++    slot.id.store(id as u64, Ordering::Relaxed);
