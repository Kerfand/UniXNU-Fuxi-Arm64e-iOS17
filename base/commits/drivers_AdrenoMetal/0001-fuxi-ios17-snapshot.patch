+    self.counts.font = [NSFont monospacedDigitSystemFontOfSize:13 weight:NSFontWeightRegular];
+    self.counts.maximumNumberOfLines = 2;
+    self.current = [NSTextField labelWithString:@""];
+    self.current.lineBreakMode = NSLineBreakByTruncatingMiddle;
+    self.current.maximumNumberOfLines = 1;
+    self.current.font = [NSFont systemFontOfSize:11];
+    self.current.textColor = NSColor.secondaryLabelColor;
+    self.start = [NSButton buttonWithTitle:text(@"Start", @"开始") target:self action:@selector(startCompilation:)];
+    self.start.keyEquivalent = @"\r";
+    self.stop = [NSButton buttonWithTitle:text(@"Stop", @"停止") target:self action:@selector(stopCompilation:)];
+    NSStackView *buttons = [NSStackView stackViewWithViews:@[self.start,self.stop]];
+    buttons.orientation = NSUserInterfaceLayoutOrientationHorizontal;
+    buttons.spacing = 8;
+    NSStackView *stack = [NSStackView stackViewWithViews:@[self.state,self.progress,self.counts,self.current,buttons]];
+    stack.orientation = NSUserInterfaceLayoutOrientationVertical;
+    stack.alignment = NSLayoutAttributeLeading;
+    stack.spacing = 16;
+    stack.translatesAutoresizingMaskIntoConstraints = NO;
+    [self.window.contentView addSubview:stack];
+    [NSLayoutConstraint activateConstraints:@[
+        [stack.leadingAnchor constraintEqualToAnchor:self.window.contentView.leadingAnchor constant:24],
+        [stack.trailingAnchor constraintEqualToAnchor:self.window.contentView.trailingAnchor constant:-24],
+        [stack.topAnchor constraintEqualToAnchor:self.window.contentView.topAnchor constant:24],
+        [self.progress.widthAnchor constraintEqualToAnchor:stack.widthAnchor],
+        [self.current.widthAnchor constraintEqualToAnchor:stack.widthAnchor]
+    ]];
+    self.timer = [NSTimer scheduledTimerWithTimeInterval:1 target:self selector:@selector(refresh) userInfo:nil repeats:YES];
+    [self refresh];
+    [self.window center];
+    [self.window makeKeyAndOrderFront:nil];
+    [NSApp activateIgnoringOtherApps:YES];
+}
+- (void)refresh {
+    NSDictionary *value = SCReadState();
+    NSDictionary *labels = @{
+        @"idle":text(@"Not started", @"未开始"), @"running":text(@"Compiling", @"正在编译"),
+        @"stopping":text(@"Stopping", @"正在停止"), @"stopped":text(@"Stopped", @"已停止"),
+        @"interrupted":text(@"Interrupted", @"已中断"), @"complete":text(@"Complete", @"已完成"),
+        @"incomplete":text(@"Incomplete", @"未完成"), @"failed":text(@"Failed", @"失败"),
+        @"outdated":text(@"Update available", @"缓存待更新")
+    };
+    self.state.stringValue = self.authorizing ? text(@"Authorizing", @"正在授权") : labels[value[@"state"]] ?: text(@"Not started", @"未开始");
+    double total = [value[@"total"] doubleValue];
+    [NSAnimationContext runAnimationGroup:^(NSAnimationContext *context) {
+        context.duration = 0.2;
+        [[self.progress animator] setDoubleValue:total ? [value[@"libraries"] doubleValue] / total : 0];
+    } completionHandler:nil];
+    self.counts.stringValue = [NSString stringWithFormat:text(@"Libraries %@/%@  Functions %@\nFailed libraries %@  Functions %@  Missing %@", @"库 %@/%@  函数 %@\n失败库 %@  失败函数 %@  缺失 %@"),
+        value[@"libraries"] ?: @0,value[@"total"] ?: @0,value[@"functions"] ?: @0,value[@"failedLibraries"] ?: @0,value[@"failedFunctions"] ?: @0,value[@"missing"] ?: @0];
+    self.current.stringValue = [value[@"error"] length] ? value[@"error"] : [value[@"function"] length] ? value[@"function"] : value[@"library"] ?: @"";
+    self.current.toolTip = self.current.stringValue;
+    self.start.enabled = ![value[@"running"] boolValue] && !self.authorizing;
+    self.stop.enabled = [value[@"running"] boolValue] && !self.authorizing && ![value[@"state"] isEqual:@"stopping"];
+}
+- (void)perform:(const char *)operation {
+    if (self.authorizing) return;
+    self.authorizing = YES;
+    [self refresh];
+    NSString *worker = [NSBundle.mainBundle.bundlePath stringByAppendingPathComponent:@"Contents/MacOS/ShaderCacheWorker"];
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        OSStatus status = errAuthorizationSuccess;
+        AuthorizationRef authorization = self.authorization;
+        if (!authorization) status = AuthorizationCreate(nullptr, kAuthorizationEmptyEnvironment, kAuthorizationFlagDefaults, &authorization);
+        if (status == errAuthorizationSuccess) {
+            AuthorizationItem item = {kAuthorizationRightExecute,0,nullptr,0};
+            AuthorizationRights rights = {1,&item};
+            status = AuthorizationCopyRights(authorization,&rights,kAuthorizationEmptyEnvironment,
+                kAuthorizationFlagInteractionAllowed|kAuthorizationFlagExtendRights|kAuthorizationFlagPreAuthorize,nullptr);
+        }
+        if (status == errAuthorizationSuccess) {
+            char *arguments[] = {const_cast<char *>(operation),nullptr};
+            FILE *channel = nullptr;
+            status = AuthorizationExecuteWithPrivileges(authorization,worker.fileSystemRepresentation,kAuthorizationFlagDefaults,arguments,&channel);
+            if (channel) fclose(channel);
+        }
+        dispatch_async(dispatch_get_main_queue(), ^{
+            self.authorization = authorization;
+            self.authorizing = NO;
+            [self refresh];
+            if (status != errAuthorizationSuccess && status != errAuthorizationCanceled) {
+                NSAlert *alert = [NSAlert new];
+                alert.messageText = text(@"Could not start the worker", @"无法启动工作进程");
+                alert.informativeText = [NSString stringWithFormat:@"%d",(int)status];
+                [alert beginSheetModalForWindow:self.window completionHandler:nil];
+            }
+        });
+    });
+}
+- (void)startCompilation:(id)sender {(void)sender; [self perform:"--run"];}
+- (void)stopCompilation:(id)sender {(void)sender; [self perform:"--stop"];}
+- (BOOL)applicationShouldTerminateAfterLastWindowClosed:(NSApplication *)sender {(void)sender; return YES;}
+@end
+
+int main(int argc, const char **argv) {
+    @autoreleasepool {
+        if (argc == 2 && !strcmp(argv[1], "--status")) {
+            NSMutableDictionary *value = SCReadState().mutableCopy;
+            [value removeObjectForKey:@"updated"];
+            NSData *json = [NSJSONSerialization dataWithJSONObject:value options:NSJSONWritingPrettyPrinted error:nil];
+            fwrite(json.bytes,1,json.length,stdout);
+            putchar('\n');
+            return 0;
+        }
+        NSApplication *application = NSApplication.sharedApplication;
+        ShaderCacheApp *delegate = [ShaderCacheApp new];
+        application.delegate = delegate;
+        [application setActivationPolicy:NSApplicationActivationPolicyRegular];
+        [application run];
+    }
+    return 0;
+}
diff --git a/ShaderCache/ShaderCacheRegister.mm b/ShaderCache/ShaderCacheRegister.mm
new file mode 100644
index 0000000..c43e3bb
--- /dev/null
+++ b/ShaderCache/ShaderCacheRegister.mm
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: MIT
+#import <Foundation/Foundation.h>
+#import <CoreServices/CoreServices.h>
+#include "ShaderCacheState.h"
+
+static BOOL registeredAt(NSString *path) {
+    CFArrayRef urls = LSCopyApplicationURLsForBundleIdentifier(CFSTR("org.unixnu.ShaderCache"), nullptr);
+    if (!urls) return NO;
+    NSArray<NSURL *> *applications = CFBridgingRelease(urls);
+    for (NSURL *url in applications) {
+        if ([url.path.stringByStandardizingPath isEqual:path.stringByStandardizingPath]) return YES;
+    }
+    return NO;
+}
+
+static void record(NSString *path, OSStatus status) {
+    NSString *message = [NSString stringWithFormat:@"%@ - %@ - status %d - %@\n", NSDate.date,
+        status == noErr ? @"Registered" : @"Registration failed", int(status), path];
+    fputs(message.UTF8String, status == noErr ? stdout : stderr);
+    NSString *directory = [NSHomeDirectory() stringByAppendingPathComponent:@"Library/Logs/UniXNU"];
+    if ([NSFileManager.defaultManager createDirectoryAtPath:directory withIntermediateDirectories:YES attributes:nil error:nullptr]) {
+        [message writeToFile:[directory stringByAppendingPathComponent:@"ShaderCacheRegister.log"]
+                 atomically:YES encoding:NSUTF8StringEncoding error:nullptr];
+    }
+}
+
+int main(int argc, const char **argv) {
+    @autoreleasepool {
+        NSString *path = SCApplication;
+        if (argc == 3 && !strcmp(argv[1], "--application")) path = @(argv[2]);
+        else if (argc != 1) return 64;
+        NSBundle *app = [NSBundle bundleWithPath:path];
+        if (![app.bundleIdentifier isEqual:@"org.unixnu.ShaderCache"] || !app.executableURL) {
+            record(path, kLSNotAnApplicationErr);
+            return 66;
+        }
+        // Registration belongs to the logged-in user's LaunchServices domain.
+        // A finite retry window covers login while the service is still starting.
+        OSStatus status = kLSUnknownErr;
+        for (unsigned attempt = 0; attempt < 10; ++attempt) {
+            status = LSRegisterURL((__bridge CFURLRef)[NSURL fileURLWithPath:path isDirectory:YES], true);
+            if (status == noErr && registeredAt(path)) break;
+            if (status == noErr) status = kLSUnknownErr;
+            if (attempt != 9) [NSThread sleepForTimeInterval:2];
+        }
+        record(path, status);
+        return status == noErr ? 0 : 1;
+    }
+}
diff --git a/ShaderCache/ShaderCacheState.h b/ShaderCache/ShaderCacheState.h
new file mode 100644
index 0000000..949f3af
--- /dev/null
+++ b/ShaderCache/ShaderCacheState.h
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#import <Foundation/Foundation.h>
+#include <fcntl.h>
+#include <sys/file.h>
+#include <unistd.h>
+
+static NSString *const SCStorage = @"/private/var/tmp/NativeAdrenoMetal.cache";
+static NSString *const SCPlugin = @"/Library/GPUBundles/NativeAdrenoMetal.bundle";
+static NSString *const SCApplication = @"/Applications/Shader Cache.app";
+
+static NSString *SCPath(NSString *name) {return [SCStorage stringByAppendingPathComponent:name];}
+static NSString *SCInstalledBuild() {
+    NSData *data = [NSData dataWithContentsOfFile:[SCPlugin stringByAppendingPathComponent:@"Contents/Resources/gpu-build.json"]];
+    if (!data) return @"";
+    NSDictionary *build = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+    if ([build[@"cache_build"] isKindOfClass:NSString.class]) return build[@"cache_build"];
+    return [build[@"metal_source_sha256"] isKindOfClass:NSString.class] ? build[@"metal_source_sha256"] : @"";
+}
+
+static BOOL SCWorkerRunning() {
+    int fd = open(SCPath(@"shader-cache.lock").fileSystemRepresentation, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+    if (fd < 0) return NO;
+    const BOOL locked = flock(fd, LOCK_SH | LOCK_NB) != 0 && errno == EWOULDBLOCK;
+    close(fd);
+    return locked;
+}
+
+static NSDictionary *SCReadState() {
+    NSDictionary *saved = [NSDictionary dictionaryWithContentsOfFile:SCPath(@"shader-cache.plist")];
+    NSMutableDictionary *state = saved ? saved.mutableCopy : [NSMutableDictionary dictionary];
+    const BOOL running = SCWorkerRunning();
+    state[@"running"] = @(running);
+    if (running) {
+        state[@"state"] = access(SCPath(@"shader-cache.stop").fileSystemRepresentation, F_OK) == 0 ? @"stopping" : @"running";
+    } else if ([state[@"state"] isEqual:@"running"] || [state[@"state"] isEqual:@"stopping"]) {
+        state[@"state"] = @"interrupted";
+    } else if (!state[@"state"]) state[@"state"] = @"idle";
+    if (!running && saved && ![saved[@"build"] isEqual:SCInstalledBuild()]) state[@"state"] = @"outdated";
+    return state;
+}
diff --git a/ShaderCache/ShaderCacheWorker.mm b/ShaderCache/ShaderCacheWorker.mm
new file mode 100644
index 0000000..79d0df3
--- /dev/null
+++ b/ShaderCache/ShaderCacheWorker.mm
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: MIT
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include "ShaderCacheState.h"
+#include "ShaderCacheActivity.h"
+#include "../SharedShaderCache.h"
+#include "../PrimeShaders.h"
+#include <signal.h>
+#include <sys/resource.h>
+
+static void *pluginHandle;
+static volatile sig_atomic_t interrupted;
+static void interruptWorker(int) {interrupted = 1;}
+
+extern "C" const char *nmb_runtime_build() {
+    auto build = reinterpret_cast<const char *(*)()>(dlsym(pluginHandle, "nmb_runtime_build"));
+    return build ? build() : "unknown";
+}
+extern "C" void native_bridge_metal_quiet_problems(bool quiet) {
+    auto set = reinterpret_cast<void (*)(bool)>(dlsym(pluginHandle, "native_bridge_metal_quiet_problems"));
+    if (set) set(quiet);
+}
+
+static void saveState(NSString *state, const std::string &library = {}, const std::string &function = {}, NSString *error = @"") {
+    NSDictionary *value = @{
+        @"state":state, @"build":SCInstalledBuild(), @"updated":NSDate.date,
+        @"libraries":@(native_prime_libraries_done), @"total":@(native_prime_libraries_total),
+        @"functions":@(native_prime_made + native_prime_functions_resumed),
+        @"failedLibraries":@(native_prime_libraries_failed), @"failedFunctions":@(native_prime_functions_refused),
+        @"missing":@(native_prime_inventory_failed), @"library":@(library.c_str()), @"function":@(function.c_str()), @"error":error
+    };
+    [value writeToFile:SCPath(@"shader-cache.plist") atomically:YES];
+}
+
+static void startState() {
+    NSDictionary *saved = [NSDictionary dictionaryWithContentsOfFile:SCPath(@"shader-cache.plist")];
+    if (![saved[@"build"] isEqual:SCInstalledBuild()]) {saveState(@"running"); return;}
+    NSMutableDictionary *state = saved.mutableCopy;
+    state[@"state"] = @"running";
+    state[@"updated"] = NSDate.date;
+    state[@"error"] = @"";
+    [state writeToFile:SCPath(@"shader-cache.plist") atomically:YES];
+}
+
+int main(int argc, const char **argv) {
+    @autoreleasepool {
+        if (argc != 2 || (strcmp(argv[1], "--run") && strcmp(argv[1], "--stop"))) return 64;
+        if (geteuid() != 0 || setuid(0) != 0 || systemcache::writerDirectory().empty()) return 77;
+        umask(0022);
+        if (!strcmp(argv[1], "--stop")) {
+            if (!SCWorkerRunning()) return 0;
+            return [NSData.data writeToFile:SCPath(@"shader-cache.stop") atomically:YES] ? 0 : 74;
+        }
+        int lock = open(SCPath(@"shader-cache.lock").fileSystemRepresentation, O_CREAT | O_RDWR | O_NOFOLLOW | O_CLOEXEC, 0644);
+        if (lock < 0 || flock(lock, LOCK_EX | LOCK_NB)) {if (lock >= 0) close(lock); return 75;}
+        freopen("/dev/null", "w", stdout);
+        freopen(SCPath(@"shader-cache-worker.log").fileSystemRepresentation, "a", stderr);
+        unlink(SCPath(@"shader-cache.stop").fileSystemRepresentation);
+        signal(SIGTERM, interruptWorker);
+        signal(SIGINT, interruptWorker);
+        SCCompilationActivity activity;
+        const IOReturn powerStatus = activity.begin();
+        if (powerStatus != kIOReturnSuccess) {
+            fprintf(stderr, "Shader Cache - power assertion creation failed - 0x%x\n", (unsigned)powerStatus);
+            saveState(@"failed", {}, {}, @"Could not prevent idle sleep during compilation");
+            return 71;
+        }
+        fprintf(stderr, "Shader Cache - preventing display and idle system sleep\n");
+        startState();
+        setpriority(PRIO_PROCESS, 0, 10);
+        setenv("NATIVE_METAL_PRIMER", "1", 1);
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        NSString *executable = [SCPlugin stringByAppendingPathComponent:@"Contents/MacOS/NativeAdrenoMetal"];
+        pluginHandle = dlopen(executable.fileSystemRepresentation, RTLD_NOW | RTLD_LOCAL);
+        if (!device || !pluginHandle || !dlsym(pluginHandle, "nmb_runtime_build") || ![NSStringFromClass([device class]) isEqual:@"NativeBridgeMetalDevice"]) {
+            saveState(@"failed", {}, {}, @"AdrenoMetal is unavailable");
+            return 69;
+        }
+        prime::cancelled = [] {return interrupted || access(SCPath(@"shader-cache.stop").fileSystemRepresentation, F_OK) == 0;};
+        prime::progress = [](const std::string &library, const std::string &function) {
+            saveState(prime::stopping() ? @"stopping" : @"running", library, function);
+        };
+        prime::run(device, SCStorage.fileSystemRepresentation, 0,
+                   "/Library/GPUBundles/NativeAdrenoMetal.primelist", true);
+        activity.end();
+        fprintf(stderr, "Shader Cache - restored normal idle sleep policy\n");
+        saveState(prime::stopping() ? @"stopped" : native_prime_pass_complete == 1 ? @"complete" : @"incomplete");
+        unlink(SCPath(@"shader-cache.stop").fileSystemRepresentation);
+        close(lock);
+        return native_prime_pass_complete == 1 ? 0 : prime::stopping() ? 130 : 1;
+    }
+}
diff --git a/SharedShaderCache.h b/SharedShaderCache.h
new file mode 100644
index 0000000..5492786
--- /dev/null
+++ b/SharedShaderCache.h
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <string>
+#include <pwd.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <stdlib.h>
+#include <vector>
+
+// Processes of one user share immutable, version-keyed shader entries. A sandbox
+// that cannot write this directory continues with its container's cache. The
+// sandbox is asked first without a report: a refused probe file made the sandbox
+// write a violation report (with a backtrace) at every launch of every sandboxed
+// Metal process (iconservicesagent, widgets).
+extern "C" int sandbox_check(pid_t pid, const char *operation, int type, ...);
+inline std::string sharedShaderCacheDirectory() {
+    static const std::string path = []() -> std::string {
+        std::string root;
+        if (const char *override = getenv("NATIVE_METAL_SHARED_CACHE_DIR")) {
+            if (!*override) return {};
+            root = override;
+        } else {
+            passwd user{}, *found=nullptr;
+            std::vector<char> bytes(16384);
+            if (getpwuid_r(getuid(), &user, bytes.data(), bytes.size(), &found) || !found || !user.pw_dir) return {};
+            root = std::string(user.pw_dir) + "/Library/Caches/org.unixnu.metal";
+        }
+        mkdir(root.c_str(), 0700);
+        struct stat st = {};
+        if (lstat(root.c_str(), &st) || !S_ISDIR(st.st_mode) || st.st_uid != getuid() || (st.st_mode & 0022)) return {};
+        // A sandboxed process (sandbox_check with no operation answers 1) asks for the write first: SANDBOX_FILTER_PATH (1) |
+        // SANDBOX_CHECK_NO_REPORT (0x40000000), nonzero is a refusal.
+        if (sandbox_check(getpid(), nullptr, 0) == 1 &&
+            sandbox_check(getpid(), "file-write-create", 1 | 0x40000000, (root + "/.write-probe").c_str()) != 0) return {};
+        std::string probe = root + "/.write-XXXXXX";
+        int fd = mkstemp(probe.data());
+        if (fd < 0) return {};
+        close(fd); unlink(probe.c_str());
+        return root;
+    }();
+    return path;
+}
+
+// The system shader cache (macOS): one directory the render server fills and every process reads.
+// The render server (WindowServer, the user _windowserver) is not the console user, so the per-user directory above serves it alone,
+// and its sandbox lets it write only its own cache and temporary directories, /private/tmp and /private/var/tmp, while the one
+// directory every sandbox that may use graphics can read is /Library/GPUBundles (system.sb's system-graphics, the WebKit GPU
+// process's profile). No path is both, so the kernel makes the directory at boot where the render server may write it
+// (kWriterPath: owner _windowserver, mode 0755) and shows it read-only where everyone may read it (kReaderPath, a read-only bind
+// mount beside the plugin). The render server opens its device in the first (its cache directory, made readable by everyone) and
+// primes the system's Metal libraries into it; every other process asks the second for what its own cache lacks.
+// A reader trusts the directory only by who can write it: it, every directory on the way to an entry and the entry must be owned by
+// the superuser or the render server's user and not writable by group or others, each opened without following a link (the
+// runtime's system layer, bridge patch 0036). An entry is then checked as one of the process's own cache is (name, build, key,
+// profile, checksum). gpu-prime-system=0 turns all of it off.
+namespace systemcache {
+static const char kWriterPath[] = "/private/var/tmp/NativeAdrenoMetal.cache";
+static const char kReaderPath[] = "/Library/GPUBundles/NativeAdrenoMetal.cache";
+static const uint32_t kOwners[] = {0, 88};   // the superuser and _windowserver
+// The directory this process fills, when the kernel made it for this process's user (or this process is the superuser): never
+// made here, since /private/var/tmp takes anyone's directories.
+inline std::string writerDirectory() {
+    struct stat st = {};
+    if (lstat(kWriterPath, &st) || !S_ISDIR(st.st_mode) || (st.st_mode & 0022)) return {};
+    if (st.st_uid != kOwners[0] && st.st_uid != kOwners[1]) return {};
+    if (st.st_uid != getuid() && getuid() != 0) return {};
+    return access(kWriterPath, W_OK) == 0 ? std::string(kWriterPath) : std::string();
+}
+}  // namespace systemcache
+
+// Call before the first Vulkan device is opened, including the optional smoke path.
+inline void configureShaderDiskCache(const std::string &root) {
+    if (root.empty()) return;
+    const std::string ir3 = root + "/ir3";
+    mkdir(ir3.c_str(), 0700);
+    if (access(ir3.c_str(), W_OK) == 0) setenv("MESA_SHADER_CACHE_DIR", ir3.c_str(), 0);
+}
