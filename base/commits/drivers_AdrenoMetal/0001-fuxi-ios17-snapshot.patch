++            let mut state = lock(&self.shared.state);
++            if state.stopping {
++                return;
++            }
++            state.asked = true;
++        }
++        self.shared.work.notify_all();
++        let mut thread = lock(&self.thread);
++        if thread.is_some() {
++            return;
++        }
++        let shared = Arc::clone(&self.shared);
