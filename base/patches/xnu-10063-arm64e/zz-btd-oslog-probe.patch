+	/* zz-btd-oslog-probe.patch (fuxi): bluetoothd mirrors its os_log to stderr (written to the serial log by write/writev). */
+	if (imgp->ip_strings && strncmp(imgp->ip_strings + strlen(EXECUTABLE_KEY), "/usr/sbin/bluetoothd", 21) == 0 &&
