+	    "/Library/Wallpaper/Collections/iOS_17~iphone.wallpaperCollection/Wallpapers/7565.iOS_17-393w-852h@3x~iphone.wallpaper/" "7565.iOS_17_Background-393w-852h@3x~iphone.ca/assets/Background Light.HEIC",
+	    "/Library/Wallpaper/Collections/iOS_17~iphone.wallpaperCollection/Wallpapers/7565.iOS_17-393w-852h@3x~iphone.wallpaper/" "7565.iOS_17_Background-393w-852h@3x~iphone.ca/Background-Light.png",
+	    &native_gpu_addon3_stage, &native_gpu_addon3_status);
