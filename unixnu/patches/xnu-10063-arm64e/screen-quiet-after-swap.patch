+/* fuxi (screen-quiet-after-swap.patch): no drawing on the boot framebuffer once the compositor's swaps reach the display. The GOP
+ * scanout is the system's from then on: the beat block (blue/white every tick), the stage marks and the text lines were repainted over
+ * the UI and flickered at the top of the screen. native_legacy_swapstat[0] counts swaps validated (NativeLegacyDisplay.cpp); before the
+ * first one the marks still report the boot. */
+extern volatile uint32_t native_legacy_swapstat[16] __attribute__((weak_import));
+static inline bool
+unixnu_screen_quiet(void)
+{
+	return &native_legacy_swapstat[0] != NULL && native_legacy_swapstat[0] != 0;
+}
