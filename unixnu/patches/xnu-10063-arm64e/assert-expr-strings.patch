+	(__builtin_expect(!!(((!kext_assertions_enable) || (ex))), 1L) ? (void)0 : __Panic("%s:%d Assertion failed: %s : " fmt, __FILE_NAME__, __LINE__, "" /* assert-expr-strings.patch */, ##args))
 #define __assert_only
 
 #else                           /* APPLE_KEXT_ASSERTIONS && !XNU_KERNEL_PRIVATE */
diff --git a/bsd/sys/mcache.h b/bsd/sys/mcache.h
--- a/bsd/sys/mcache.h
+++ b/bsd/sys/mcache.h
@@ -52,7 +52,7 @@
  * Unlike VERIFY(), ASSERT() is evaluated only in DEBUG/DEVELOPMENT build.
  */
 #define VERIFY(EX)      \
-	((void)(__probable((EX)) || assfail(#EX, __FILE__, __LINE__)))
+	((void)(__probable((EX)) || assfail("" /* assert-expr-strings.patch */, __FILE__, __LINE__)))
 #if (DEBUG || DEVELOPMENT)
 #define ASSERT(EX)      VERIFY(EX)
 #else
diff --git a/bsd/skywalk/core/skywalk_common.h b/bsd/skywalk/core/skywalk_common.h
