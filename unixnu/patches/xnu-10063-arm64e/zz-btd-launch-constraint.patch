diff --git a/security/mac_process.c b/security/mac_process.c
--- a/security/mac_process.c
+++ b/security/mac_process.c
@@ -895,6 +895,21 @@
 int
 mac_proc_check_launch_constraints(proc_t curp, struct image_params *imgp, os_reason_t *reasonp)
 {
+	/* zz-btd-launch-constraint.patch (fuxi): the patched bluetoothd, seen at /usr/sbin through the addon's bindfs union, cannot meet
+	 * its system-volume self constraint. Only that executable is let through. */
+	if (imgp && imgp->ip_vp) {
+		mount_t btd_mp = vnode_mount(imgp->ip_vp);
+		const char *btd_name = vnode_getname_printable(imgp->ip_vp);
+		int btd_skip = btd_mp && strncmp(vfs_statfs(btd_mp)->f_fstypename, "bindfs", MFSTYPENAMELEN) == 0 &&
+		    btd_name && strcmp(btd_name, "bluetoothd") == 0;
+		if (btd_name) {
+			vnode_putname_printable(btd_name);
+		}
+		if (btd_skip) {
+			printf("fuxi btd: launch constraints skipped for the bindfs bluetoothd\n");
+			return 0;
+		}
+	}
 	char *fatal_failure_desc = NULL;
 	size_t fatal_failure_desc_len = 0;
 
