+    // (Digitizer/Touch Screen) and the Built-In flag, which a combined keyboard-first descriptor would not provide.
+    bool touchOnly=false;
+    bool eventDriverFound=false;
+    IOReturn submitReport(IOMemoryDescriptor *report) {
