+
+// The touch interrupt: GPIO 25, active low (DT fts,irq-gpio flags 0x2008, IRQF_TRIGGER_LOW | IRQF_ONESHOT). The controller
+// holds the line low while its FIFO is not empty. The TLMM detects the falling edge (INTR_CFG detection 2, polarity bit set,
+// raw status on, target the application processor) and raises the summary interrupt SPI 208; the handler acknowledges the
+// pin and wakes the thread, which drains the FIFO until the line reads high again, so an edge that came while it was
+// reading is not lost. A timed wait also checks the line in case an edge is missed.
+extern "C" int armcpu_spi_attach(uint32_t, bool, void (*)(void *), void *, uint32_t *, uint64_t *) __attribute__((weak_import));
+static volatile uint32_t gTouchIrqEvents;
+static volatile uint32_t *gTouchPin;
+static void touchIrq(void *) {
+    if (!(gTouchPin[0xc / 4] & 1)) {native_touch_irq_stats[2] = native_touch_irq_stats[2] + 1; return;}
+    gTouchPin[0xc / 4] = 0;
+    native_touch_irq_stats[1] = native_touch_irq_stats[1] + 1;
+    __atomic_fetch_add(&gTouchIrqEvents, 1, __ATOMIC_RELEASE);
+    thread_wakeup((event_t)&gTouchIrqEvents);
+}
+static bool armTouchIrq(Session &s) {
+    gTouchPin = reinterpret_cast<volatile uint32_t *>(s.tlmmIrq.va);
+    uint32_t cfg = gTouchPin[0x8 / 4];
+    cfg &= ~((7u << 5) | (3u << 2) | (1u << 1) | 1u);
+    cfg |= (3u << 5) | (2u << 2) | (1u << 1) | (1u << 4);
+    gTouchPin[0x8 / 4] = cfg;
+    gTouchPin[0xc / 4] = 0;
+    __asm__ volatile("dsb sy" ::: "memory");
+    if (!armcpu_spi_attach) {native_touch_irq_stats[0] = 2; native_touch_irq_stats[3] = 0xffff; return false;}
+    const int rc = armcpu_spi_attach(32 + FTB_TLMM_SUMMARY_GIC_SPI, false, touchIrq, nullptr, nullptr, nullptr);
+    native_touch_irq_stats[3] = static_cast<uint32_t>(rc);
+    if (rc) {native_touch_irq_stats[0] = 2; return false;}
+    gTouchPin[0x8 / 4] = cfg | 1u;   // enable last
+    native_touch_irq_stats[0] = 1;
+    return true;
+}
+static bool lineLow(const Session &s) {return (rd32(s.tlmmIrq.va, 4) & 1) == 0;}
+
+// Secondary-core state of ArmCpu (UniXNU drivers/ArmCpu/ArmCpu.cpp) on a boot with sheng-smp=1. Step of each core 1..7:
+// 1 nub started, 2 registered, 3 start thread running, 4 PSCI CPU_ON issued, 5 initCPU entered on the new core,
+// 6 redistributor ready, 7 running. A failure code parks the core (1 MPIDR differs, 2 or 3 redistributor, 4 registration);
+// psci is the CPU_ON result (0 success; -1000 no start thread, -1001 no PSCI method in the DT). Weak like armcpu_spi_attach:
+// a kernel without ArmCpu reports no SMP rows.
+extern "C" {
+extern volatile uint32_t __attribute__((weak_import)) armcpu_smp_requested, armcpu_smp_running, armcpu_smp_conduit,
+    armcpu_boot_mpidr, armcpu_smp_step[8], armcpu_smp_fail[8], armcpu_core_timer[8], armcpu_core_sgi[8];
+extern volatile int32_t __attribute__((weak_import)) armcpu_smp_psci_rc[8];
+extern volatile uint64_t __attribute__((weak_import)) armcpu_ipi_sent, armcpu_ipi_interrupts;
+extern uint32_t processor_avail_count;   // osfmk/kern/processor.h: processors the scheduler runs threads on
+int cpu_number(void);
+}
+// Two report rows: running cores, PSCI conduit (1 smc, 2 hvc), boot MPIDR, the core this thread reports from, the
+// scheduler's processor count, then per secondary core its step, failure code and CPU_ON result, IPIs sent and taken;
+// the second row has the timer interrupts and IPIs each core took. Empty without sheng-smp, so that report is unchanged.
+static char gSmpText[320];
+static const char *smpText() {
+    if (!&armcpu_smp_requested || !armcpu_smp_requested) return "";
+    char st[8], f[8];
+    for (unsigned c = 1; c < 8; ++c) {
+        st[c - 1] = static_cast<char>('0' + armcpu_smp_step[c] % 10);
+        f[c - 1] = static_cast<char>('0' + armcpu_smp_fail[c] % 10);
+    }
+    st[7] = f[7] = 0;
+    const volatile int32_t *rc = armcpu_smp_psci_rc;
+    const volatile uint32_t *t = armcpu_core_timer, *i = armcpu_core_sgi;
+    snprintf(gSmpText, sizeof gSmpText,
+        "\nSMP run%u c%u b%x cpu%d av%u st%s f%s psci%d,%d,%d,%d,%d,%d,%d ipi%llu/%llu"
+        "\nSMP tmr%u/%u/%u/%u/%u/%u/%u/%u ipi%u/%u/%u/%u/%u/%u/%u/%u",
+        armcpu_smp_running, armcpu_smp_conduit, armcpu_boot_mpidr & 0xffffffu, cpu_number(), processor_avail_count, st, f,
+        rc[1], rc[2], rc[3], rc[4], rc[5], rc[6], rc[7],
+        static_cast<unsigned long long>(armcpu_ipi_sent), static_cast<unsigned long long>(armcpu_ipi_interrupts),
+        t[0], t[1], t[2], t[3], t[4], t[5], t[6], t[7], i[0], i[1], i[2], i[3], i[4], i[5], i[6], i[7]);
+    return gSmpText;
+}
+
+// The HID digitizer (FuxiHidProbe.cpp, in this archive): started from stage 4 with fuxi-touch-hid=1, reported as one more row.
+extern "C" void fuxi_hid_start(void);
+extern "C" bool fuxi_hid_settled(void);
+extern "C" const char *fuxi_hid_row(char *out, size_t size);
+static bool gHidRequested;
+static char gHidText[768];   // T0: four diagnostic rows now share this buffer
+static const char *hidText() {return gHidRequested ? fuxi_hid_row(gHidText, sizeof gHidText) : "";}
+
+// Where the digitizer reports went: published by the touch core, submitted by NativeHidInput, dispatched by the event
+// driver. install is the vtable wrap (3 = wrapped); stats[1] is the only counter that proves the event driver ran.
+static bool gHidRegistryPrinted;
+static void printHidPath(void) {
+    if (!&native_touch_edge_stats) return;
+    printf("FTS hid path install%u/%u/%u stats%u/%u/%u/%u multi%u/%u/%u rep%u\n",
+           native_touch_edge_install[0], native_touch_edge_install[1], native_touch_edge_install[2],
+           native_touch_edge_stats[0], native_touch_edge_stats[1], native_touch_edge_stats[2], native_touch_edge_stats[3],
+           native_touch_hid_multi[0], native_touch_hid_multi[1], native_touch_hid_multi[2], native_touch_hid_reports);
+    if (&native_hid_input_props && native_hid_input_props[0]) printf("FTS hid props %s\n", native_hid_input_props);
+    // open: the device is opened by the event driver, and handleReport returns kIOReturnNotReady without it.
+    // es: the event-service object handleReportWithTime dispatches each report to; null means no report ever reaches a driver.
+    if (&native_hid_input_object && native_hid_input_object) {
+        const uint8_t *object = (const uint8_t *)(uintptr_t)native_hid_input_object;
+        printf("FTS hid dev open%u es%llx\n", (unsigned)*(const volatile uint8_t *)(object + 0xb0),
+               (unsigned long long)*(const volatile uint64_t *)(object + 0xc8));
+    }
+    // Dump only once the checkpoint has found the event driver: on the first printHidPath the driver has not attached
+    // yet, and the dump then lists just NativeHidInput/IOHIDInterface, which reads as a matching failure.
+    static unsigned rounds;
+    ++rounds;
+    if (!gHidRegistryPrinted && &native_hid_input_registry && native_hid_input_registry[0] &&
+        &native_hid_input_props && native_hid_input_props[0] && (rounds >= 10 || native_hid_input_props[0] == 'B')) {
+        gHidRegistryPrinted = true;
+        printf("FTS hid registry\n%s<end>\n", native_hid_input_registry);
+    }
+}
+
+// Refreshes the diagnostic rows and prints them to the kernel log.
+static void report(const Session &s) {
+    rows(s);
+    printf("fuxi-touch stage %u/%u\n%s\n%s\n%s\n%s\n", native_touch_stage_done, native_touch_stage_req, native_touch_rows[0],
+           native_touch_rows[1], native_touch_rows[2], native_touch_rows[3]);
+    printHidPath();
+}
+
+// Reads every queued event, applies it and publishes the contact set when it changed. Returns false on a bus error.
+static bool drain(Session &s) {
+    for (unsigned round = 0; round < 8; ++round) {
+        unsigned count = 0;
+        native_touch_loop_step = 2;
+        if (fts_read_events(&s.chip, s.events, &count)) {fail(11, FTS_ERR_BUS); return false;}
+        ++s.reads;
+        if (!count) return true;
+        s.drained += count;
+        native_touch_valid = native_touch_valid + 1;
+        native_touch_loop_step = 3;
+        if (fts_touch_apply_events(&s.core, s.events, count)) {
+            fts_point pts[FTS_SLOTS];
+            const unsigned n = fts_touch_contacts(&s.core, pts, FTS_SLOTS);
+            native_touch_contacts = n;
+            if (n) {native_touch_last_x = pts[0].x; native_touch_last_y = pts[0].y;}
+            native_touch_frames = native_touch_frames + 1;
+            publish(s, n, pts);
+        }
+        if (s.core.reset_needed) {
+            // Watchdog, ESD or a reset of its own: reset again and restart sensing, as the driver's error handler does.
+            ++s.rearms;
+            s.core.reset_needed = 0;
+            s.resetRc = fts_reset(&s.chip);
+            s.senseRc = fts_start_sensing(&s.chip);
+        }
+        if (!lineLow(s)) return true;
+    }
+    return true;
+}
+
+static void touchThread(void *, wait_result_t) {
+    thread_set_thread_name(current_thread(), "fuxi-touch");
+    Session *s = static_cast<Session *>(IOMallocType(Session));
+    if (!s) {fail(0, -12); return;}
+    bzero(static_cast<void *>(s), sizeof *s);   // IOMallocType runs no constructor: every field starts at zero
+    s->idRc = s->resetRc = s->senseRc = 99;
+    unsigned stage = native_touch_stage_req, hz = FTB_SPI_HZ, power = 1, tcs = 2, mapFlags = 0, panicReport = 0;
+    PE_parse_boot_argn("fuxi-touch-hz", &hz, sizeof hz);
+    if (hz < 100000 || hz > FTB_SPI_HZ) hz = FTB_SPI_HZ;
+    PE_parse_boot_argn("fuxi-touch-power", &power, sizeof power);
+    PE_parse_boot_argn("fuxi-touch-tcs", &tcs, sizeof tcs);
+    s->tcs = tcs < kActiveTcs ? tcs : 2;
+    PE_parse_boot_argn("fuxi-touch-map", &mapFlags, sizeof mapFlags);
+    PE_parse_boot_argn("fuxi-touch-panic", &panicReport, sizeof panicReport);
+    s->map = (struct fts_map){FTB_X_MAX, FTB_Y_MAX, kHidXMax, kHidYMax, mapFlags & 7u};
+    fts_touch_init(&s->core, 1, FTB_X_MAX, FTB_Y_MAX);
+    do {
+        if (!snapshot(*s)) break;
+        native_touch_stage_done = 1;
+        report(*s);
+        if (stage < 2) break;
+        if (!enable(*s, power != 0)) break;
+        native_touch_stage_done = 2;
+        report(*s);
+        if (stage < 3) break;
+        if (!openBus(*s, hz)) break;
+        s->tx = static_cast<uint8_t *>(IOMalloc(FTS_XFER_MAX));
+        s->rx = static_cast<uint8_t *>(IOMalloc(FTS_XFER_MAX));
+        s->events = static_cast<uint8_t *>(IOMalloc(FTS_FIFO_DEPTH * FTS_EVENT_SIZE));
+        if (!s->tx || !s->rx || !s->events) {fail(6, -12); break;}
+        s->bus = (struct fts_bus){s, busXfer, busDelay, busReset};
+        s->chip = {};
+        s->chip.bus = &s->bus;
+        s->chip.tx = s->tx;
+        s->chip.rx = s->rx;
+        mark(*s, 7);
+        s->resetRc = fts_reset(&s->chip);
+        s->idRc = fts_read_chip_id(&s->chip);
+        rows(*s);
+        if (s->resetRc) {fail(7, s->resetRc); break;}
+        if (s->idRc) {fail(8, s->idRc); break;}
+        native_touch_stage_done = 3;
+        report(*s);
+        if (stage < 4) break;
+        mark(*s, 9);
+        s->senseRc = fts_start_sensing(&s->chip);
+        if (s->senseRc) {fail(9, s->senseRc); break;}
+        native_touch_stage_done = 4;
+        report(*s);
+        unsigned hid = 0;
+        PE_parse_boot_argn("fuxi-touch-hid", &hid, sizeof hid);
+        gHidRequested = hid == 1;
+        if (gHidRequested) fuxi_hid_start();   // its own thread: loading IOHIDFamily does not delay the touch loop
+        mark(*s, 10);
+        unsigned autotapSec = 0, autotapCount = 3;
+        PE_parse_boot_argn("fuxi-touch-autotap", &autotapSec, sizeof autotapSec);
+        PE_parse_boot_argn("fuxi-touch-autotap-count", &autotapCount, sizeof autotapCount);
+        if (autotapCount > 8) autotapCount = 8;
+        uint64_t autotapAt = 0;
+        bool autotapDown = false;
+        unsigned pollOnly = 0;
+        PE_parse_boot_argn("fuxi-touch-poll", &pollOnly, sizeof pollOnly);
+        const bool irqArmed = !pollOnly && armTouchIrq(*s);
+        uint32_t seen = gTouchIrqEvents;
+        unsigned tick = 0;
+        // With the HID digitizer the run ends at the first lift after its start has settled; otherwise at the first lift.
+        bool settled = !gHidRequested;
+        uint32_t leavesBefore = 0;
+        for (;;) {
+            native_touch_loop_step = 1;
+            if (irqArmed) {
+                // Event driven; a 100 ms timeout re-checks the line in case an edge was missed.
+                assert_wait_timeout((event_t)&gTouchIrqEvents, THREAD_UNINT, 100, kMillisecondScale);
+                if (gTouchIrqEvents != seen || lineLow(*s)) clear_wait(current_thread(), THREAD_AWAKENED);
+                else if (thread_block(THREAD_CONTINUE_NULL) == THREAD_TIMED_OUT) ++s->idleWakes;
+                seen = gTouchIrqEvents;
+                if (!lineLow(*s)) {if ((++tick & 63) == 0) rows(*s); continue;}
+            } else {
+                IOSleep(pollOnly ? 8 : 10);
+            }
+            if (!drain(*s)) break;
+            if ((++tick & 15) == 0) rows(*s);
+            if (!settled && fuxi_hid_settled()) {settled = true; leavesBefore = s->core.leaves;}
+            if (autotapSec && settled && gAutotapSent < autotapCount) {
+                static const int kTapX[3] = {15240, 7620, 22860}, kTapY[3] = {10160, 5080, 5080};
+                const uint64_t now = nowMs();
+                if (!autotapAt) autotapAt = now + (uint64_t)autotapSec * 1000;
+                if (!autotapDown && now >= autotapAt) {
+                    const unsigned k = gAutotapSent % 3;
+                    publishSynthetic(1, kTapX[k], kTapY[k]);
+                    autotapDown = true; autotapAt = now + 80;
+                } else if (autotapDown && now >= autotapAt) {
+                    publishSynthetic(0, 0, 0);
+                    autotapDown = false; gAutotapSent = gAutotapSent + 1; autotapAt = now + 15000;
+                    printf("FTS autotap %u rep%u up%u/%x fail%u\n", gAutotapSent, native_touch_hid_reports,
+                           native_hid_input_events_weak(6), (unsigned)native_hid_input_result_weak(6), native_hid_input_events_weak(7));
+                }
+            }
+            if (panicReport == 2 && settled && s->core.leaves > leavesBefore) break;   // one complete touch seen: report it
+        }
+    } while (0);
+    report(*s);
+    if (panicReport) {
+        panic("fuxi-touch report (stage %u of %u)\n%s\n%s\n%s\n%s%s%s", native_touch_stage_done, native_touch_stage_req,
+              native_touch_rows[0], native_touch_rows[1], native_touch_rows[2], native_touch_rows[3], smpText(), hidText());
+    }
+}
+
+extern "C" void native_touch_probe(void) {
+    unsigned stage = 0;
+    if (!PE_parse_boot_argn("fuxi-touch", &stage, sizeof stage) || stage < 1 || native_touch_stage_req) return;
+    if (stage > 4) stage = 4;
+    native_touch_stage_req = stage;
+    thread_t thread = nullptr;
+    if (kernel_thread_start(touchThread, nullptr, &thread) == KERN_SUCCESS) thread_deallocate(thread);
+    else native_touch_error = -12;
+}
+
+// fuxi USB control (INPUT verb, fuxi-usb-control-20261112): op 1 puts one contact down / moves it to panel pixel (a, b) of the
+// 1080x2400 panel, op 2 lifts it. Published like a drained frame in the probe's mapped space (30480 x 20320, autotap's centre
+// is 15240,10160). Returns 0 when no HID sink is attached.
+extern "C" int fuxi_control_touch(unsigned op, unsigned a, unsigned b) {
+    if (!__atomic_load_n(&gTouchSink, __ATOMIC_ACQUIRE)) return 0;
+    if (op == 1) {
+        if (a >= 1080u || b >= 2400u) return 0;
+        publishSynthetic(1, int(a * 30480u / 1080u), int(b * 20320u / 2400u));
+        return 1;
+    }
+    if (op == 2) { publishSynthetic(0, 0, 0); return 1; }
+    return 0;
+}
diff --git a/package/FuxiWifiClock.h b/package/FuxiWifiClock.h
new file mode 100644
index 0000000..d4c4440
--- /dev/null
+++ b/package/FuxiWifiClock.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// PMK8550 gpio3 (the WCN7850 32 kHz sleep clock pin, PPID 0x0ba) as UniXNU-sheng's pmicPrepare sets it: pull disabled, power source 0,
+// function func1 (source 2), output mode, master enable, in that order. Each register is read, changed only in its own field (masked
+// read-modify-write) and read back. A transaction whose status reports failed or dropped is retried a bounded number of times; a denied
+// one is not repeated. Pure callback code so a host test can drive it against a model of the arbiter.
+#ifndef FUXI_WIFI_CLOCK_H
+#define FUXI_WIFI_CLOCK_H
+#include <stdint.h>
+
+// arbiter channel status: bit 0 done, bit 1 failed, bit 2 denied, bit 3 dropped
+enum {FUXI_CLK_STATUS_DENIED = 1u << 2, FUXI_CLK_TRIES = 4};
+// results: 0 written and verified, 1 already an enabled func1 output (nothing written); negative: the step that failed
+enum {FUXI_CLK_WRITTEN = 0, FUXI_CLK_ALREADY = 1, FUXI_CLK_READ = -1, FUXI_CLK_DENIED = -2, FUXI_CLK_WRITE = -3, FUXI_CLK_VERIFY = -4};
+
+typedef struct FuxiWifiClockIo {
+  void *ctx;
+  // one byte through the arbiter: return 0 on success, the raw channel status in *status either way
+  int (*read)(void *ctx, uint8_t reg, uint8_t *value, uint32_t *status);
+  int (*write)(void *ctx, uint8_t reg, uint8_t value, uint32_t *status);
+  // one line per register attempt (may be null)
+  void (*trace)(void *ctx, uint8_t reg, uint8_t before, uint8_t wanted, uint8_t after, unsigned attempt, int writeRc, int readRc,
+                uint32_t writeStatus, uint32_t readStatus);
+  void (*delay)(void *ctx);
+} FuxiWifiClockIo;
+
+static inline int fuxi_wifi_clock_read(const FuxiWifiClockIo *io, uint8_t reg, uint8_t *value, uint32_t *status) {
+  int rc = 1;
+  for (unsigned i = 0; i < FUXI_CLK_TRIES; ++i) {
+    *status = 0;
+    rc = io->read(io->ctx, reg, value, status);
+    if (!rc || (*status & FUXI_CLK_STATUS_DENIED)) break;
+    if (io->delay) io->delay(io->ctx);
+  }
+  return rc;
+}
+
+// The pin's mode (0x40 bits 1:0 = 1 output), source (0x44 bits 3:0 = 2 func1) and enable (0x46 bit 7).
+static inline int fuxi_wifi_clock_ready(uint8_t mode, uint8_t source, uint8_t enable) {
+  return (enable & 0x80) && (mode & 3) == 1 && (source & 0xf) == 2;
+}
+
+static inline int fuxi_wifi_sleep_clock(const FuxiWifiClockIo *io) {
+  static const uint8_t regs[5] = {0x42, 0x41, 0x44, 0x40, 0x46}, values[5] = {5, 0, 2, 1, 0x80}, masks[5] = {0x07, 0x07, 0x8f, 0x03, 0x80};
+  uint8_t mode = 0, source = 0, enable = 0;
+  uint32_t status = 0;
+  if (fuxi_wifi_clock_read(io, 0x40, &mode, &status) || fuxi_wifi_clock_read(io, 0x44, &source, &status) ||
+      fuxi_wifi_clock_read(io, 0x46, &enable, &status))
+    return (status & FUXI_CLK_STATUS_DENIED) ? FUXI_CLK_DENIED : FUXI_CLK_READ;
+  if (fuxi_wifi_clock_ready(mode, source, enable)) return FUXI_CLK_ALREADY;
+  for (unsigned r = 0; r < 5; ++r) {
+    int done = 0;
+    for (unsigned attempt = 0; attempt < FUXI_CLK_TRIES && !done; ++attempt) {
+      uint8_t before = 0, after = 0xff;
+      uint32_t ws = 0, rs = 0;
+      int rr = fuxi_wifi_clock_read(io, regs[r], &before, &rs);
+      if (rr) {
+        if (io->trace) io->trace(io->ctx, regs[r], 0, values[r], 0, attempt, 0, rr, 0, rs);
+        return (rs & FUXI_CLK_STATUS_DENIED) ? FUXI_CLK_DENIED : FUXI_CLK_READ;
+      }
+      const uint8_t wanted = (uint8_t)((before & ~masks[r]) | (values[r] & masks[r]));
+      int wr = 0;
+      if (before != wanted) wr = io->write(io->ctx, regs[r], wanted, &ws);
+      if (!wr) rr = fuxi_wifi_clock_read(io, regs[r], &after, &rs);
+      if (io->trace) io->trace(io->ctx, regs[r], before, wanted, after, attempt, wr, rr, ws, rs);
+      if ((ws | rs) & FUXI_CLK_STATUS_DENIED) return FUXI_CLK_DENIED;
+      done = !wr && !rr && (after & masks[r]) == (wanted & masks[r]);
+      if (!done && io->delay) io->delay(io->ctx);
+    }
+    if (!done) return FUXI_CLK_WRITE;
+  }
+  if (fuxi_wifi_clock_read(io, 0x40, &mode, &status) || fuxi_wifi_clock_read(io, 0x44, &source, &status) ||
+      fuxi_wifi_clock_read(io, 0x46, &enable, &status))
+    return FUXI_CLK_READ;
+  return fuxi_wifi_clock_ready(mode, source, enable) ? FUXI_CLK_WRITTEN : FUXI_CLK_VERIFY;
+}
+#endif
diff --git a/package/FuxiWifiFirmware.S b/package/FuxiWifiFirmware.S
new file mode 100644
index 0000000..1e98116
--- /dev/null
+++ b/package/FuxiWifiFirmware.S
@@ -0,0 +1,23 @@
+// WCN7850 hw2.0 firmware, SHA-256 equal to UniXNU-sheng firmware/wcn7850/manifest.json (see wifi-firmware/manifest.json), embedded as zlib
+// streams (build-native-legacy-display.py writes the .zlib files) and inflated on first use by fuxi_wifi_firmware_get (FuxiWifiNw.cpp):
+// DarwinBoot refuses a kernel.macho over 128 MiB, which the plain files (8.8 MB) pushed it past. In __DATA, after the kernel's code: in
+// __DATA,__const (before __TEXT_EXEC) they would move late objects out of the +/-128 MB branch range of the prelinked kexts.
+.section __DATA,__data
+.p2align 4
+.globl _fuxi_wifi_amss_z_start
+_fuxi_wifi_amss_z_start:
+.incbin "/home/xiaomi/sadnut-fuxi-local-20261103/wifi-firmware/amss.bin.zlib"
+.globl _fuxi_wifi_amss_z_end
+_fuxi_wifi_amss_z_end:
+.p2align 4
+.globl _fuxi_wifi_m3_z_start
+_fuxi_wifi_m3_z_start:
+.incbin "/home/xiaomi/sadnut-fuxi-local-20261103/wifi-firmware/m3.bin.zlib"
+.globl _fuxi_wifi_m3_z_end
+_fuxi_wifi_m3_z_end:
+.p2align 4
+.globl _fuxi_wifi_board2_z_start
+_fuxi_wifi_board2_z_start:
+.incbin "/home/xiaomi/sadnut-fuxi-local-20261103/wifi-firmware/board-2.bin.zlib"
+.globl _fuxi_wifi_board2_z_end
+_fuxi_wifi_board2_z_end:
diff --git a/package/FuxiWifiFwPart.cpp b/package/FuxiWifiFwPart.cpp
new file mode 100755
index 0000000..31f103b
--- /dev/null
+++ b/package/FuxiWifiFwPart.cpp
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// The WCN7850 firmware from the partition named "oops" (iOS 17 arm64e build, 2026-11-12), the way the UniXNU reference reads it
+// (https://unixnu.com/zh/porting/network; UniXNU-sheng package/WifiProbe.cpp pFwGet at 516a780): block 0 of the partition is a WFW1
+// container header - 'WFW1', u32 count, then count entries of name[24], u32 offset (bytes from the partition start, 4096-aligned),
+// u32 size - and each file follows uncompressed. tools: device-ios17/scripts/make-wifi-fw.py builds the image the user flashes.
+// The iPadOS build embeds the files in the kernel instead (FuxiWifiFwStore.cpp); the iOS 17 fileset kernel has no __DATA room for them
+// (the native __DATA must fit 0x171070 bytes ahead of the retained kexts' data).
+// Same interface as FuxiWifiFwStore.cpp: each file is read once, on its first request, into memory kept for the boot; its size must be
+// the one in wifi-firmware/manifest.json.
+// First source since 2026-11-12: the GPU addon of the boot payload (device-ios17/scripts/add-wifi-fw-to-addon.py adds wifi/amss.bin,
+// wifi/m3.bin, wifi/board-2.bin, each zlib-compressed). It is boot memory NativeRamBlock never frees (native_ram_block_gpu_addon), so the
+// firmware travels with the boot image. The oops partition stays the fallback: after a forced reboot the boot loader had replaced its
+// WFW1 header with a crash record ("amss.bin FAILED (rc -7)"); its first bytes are now logged when the header is wrong.
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <libkern/zlib.h>
+#include <string.h>
+
+extern "C" int native_ufs_part_find(const char *, uint32_t *, uint64_t *, uint64_t *);   // NativeUfs.cpp, read-only
+extern "C" int native_ufs_part_read(uint32_t, uint64_t, uint32_t, void *);               // NativeUfs.cpp, read-only
+extern "C" int native_ram_block_gpu_addon(const uint8_t **, uint64_t *) __attribute__((weak_import));   // NativeRamBlock.cpp
+
+namespace {
+struct PartFw {const char *name; size_t bytes; uint8_t *data;};
+PartFw gPartFw[] = {{"amss.bin", 6090816, nullptr}, {"m3.bin", 299660, nullptr}, {"board-2.bin", 2431968, nullptr}};
+uint32_t gLun; uint64_t gFirst, gBlocks;
+bool gFound;
+int gLastError;
+
+// zlib's state from the kernel heap, its size in front (as kern_exec.c's addon install does).
+voidpf zAlloc(voidpf, uInt items, uInt size) {
+    size_t bytes = size_t(items) * size + 16;
+    uint8_t *p = static_cast<uint8_t *>(IOMallocData(bytes));
+    if (!p) return Z_NULL;
+    memcpy(p, &bytes, sizeof bytes);
+    return p + 16;
+}
+void zFree(voidpf, voidpf address) {
+    uint8_t *p = static_cast<uint8_t *>(address) - 16;
+    size_t bytes;
+    memcpy(&bytes, p, sizeof bytes);
+    IOFreeData(p, bytes);
+}
+
+// wifi/<name> from the GPU addon ("NGPUADD2", u32 count, u32 0, u64 total; per file u32 path bytes, u32 mode, u64 size, u64 packed size,
+// path and zlib stream each padded to 8). 0 with *out set, 1 when the addon or the entry is absent, negative for a damaged entry.
+int fromAddon(const PartFw &f, uint8_t **out) {
+    const uint8_t *addon = nullptr;
+    uint64_t bytes = 0;
+    if (!native_ram_block_gpu_addon || !native_ram_block_gpu_addon(&addon, &bytes)) return 1;
+    if (bytes < 24 || memcmp(addon, "NGPUADD2", 8)) return 1;
+    uint32_t count; uint64_t total;
+    memcpy(&count, addon + 8, 4); memcpy(&total, addon + 16, 8);
+    if (total != bytes) return 1;
+    char want[40];
+    snprintf(want, sizeof want, "wifi/%s", f.name);
+    uint64_t at = 24;
+    for (uint32_t i = 0; i < count; ++i) {
+        if (bytes - at < 24) return 1;
+        uint32_t nameBytes; uint64_t size, packed;
+        memcpy(&nameBytes, addon + at, 4); memcpy(&size, addon + at + 8, 8); memcpy(&packed, addon + at + 16, 8);
+        at += 24;
+        const uint64_t namePadded = (nameBytes + 7) & ~7ull, packedPadded = (packed + 7) & ~7ull;
+        if (namePadded > bytes - at || packedPadded > bytes - at - namePadded) return 1;
+        const char *name = reinterpret_cast<const char *>(addon + at);
+        at += namePadded;
+        if (nameBytes == strlen(want) + 1 && !memcmp(name, want, nameBytes)) {
+            if (size != f.bytes) return -8;
+            uint8_t *buf = static_cast<uint8_t *>(IOMallocData(size));
+            if (!buf) return -12;
+            z_stream z;
+            memset(&z, 0, sizeof z);
+            z.zalloc = zAlloc; z.zfree = zFree;
+            z.next_in = const_cast<Bytef *>(addon + at); z.avail_in = uInt(packed);
+            z.next_out = buf; z.avail_out = uInt(size);
+            int r = inflateInit(&z);
+            if (r == Z_OK) {r = inflate(&z, Z_FINISH); inflateEnd(&z);}
+            if (r != Z_STREAM_END || z.total_out != size) {IOFreeData(buf, size); return -9;}
+            *out = buf;
+            return 0;
+        }
+        at += packedPadded;
+    }
+    return 1;
+}
+
+// The storage driver comes up a while into the boot (the WiFi worker asks for amss.bin at stage 5): wait for the partition up to 120 s.
+bool findPartition() {
+    if (gFound) return true;
+    for (unsigned i = 0; i < 240; ++i) {
+        if (native_ufs_part_find("oops", &gLun, &gFirst, &gBlocks)) {
+            gFound = gBlocks != 0;
+            IOLog("fuxi wifi fw: partition oops lun %u first %llu blocks %llu\n", gLun, gFirst, gBlocks);
+            return gFound;
+        }
+        IOSleep(500);
+    }
+    IOLog("fuxi wifi fw: no partition named oops\n");
+    return false;
+}
+}
+
+// Returns 0; -2 for a file the container does not hold, -12 out of memory, other negative values for a missing or damaged container.
+extern "C" int fuxi_wifi_firmware_get(const char *name, const uint8_t **data, size_t *size) {
+    static IOLock *lock;
+    if (!__atomic_load_n(&lock, __ATOMIC_ACQUIRE)) {
+        IOLock *created = IOLockAlloc(), *expected = nullptr;
+        if (!created) return -12;
+        if (!__atomic_compare_exchange_n(&lock, &expected, created, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) IOLockFree(created);
+    }
+    const char *base = name;
+    for (const char *c = name; *c; ++c) if (*c == '/') base = c + 1;
+    PartFw *f = nullptr;
+    for (PartFw &e : gPartFw) if (!strcmp(e.name, base)) f = &e;
+    if (!f) return -2;
+    IOLockLock(lock);
+    int rc = 0;
+    if (!f->data) {
+        uint8_t *fromBoot = nullptr;
+        const int a = fromAddon(*f, &fromBoot);
+        if (!a) {
+            f->data = fromBoot;
+            IOLog("fuxi wifi fw: %s read from the boot addon (%zu bytes)\n", f->name, f->bytes);
+        } else if (a < 0) {
+            IOLog("fuxi wifi fw: %s in the boot addon is damaged (%d); trying the oops partition\n", f->name, a);
+        }
+    }
+    if (!f->data) {
+        uint8_t *header = nullptr;
+        uint32_t offset = 0, bytes = 0;
+        if (!findPartition()) rc = -6;
+        else if (!(header = static_cast<uint8_t *>(IOMallocData(4096)))) rc = -12;
+        else if (!native_ufs_part_read(gLun, gFirst, 1, header)) rc = -5;
+        else if (memcmp(header, "WFW1", 4)) {
+            rc = -7;
+            IOLog("fuxi wifi fw: oops block 0 starts %02x%02x%02x%02x %02x%02x%02x%02x %02x%02x%02x%02x %02x%02x%02x%02x, not WFW1\n",
+                  header[0], header[1], header[2], header[3], header[4], header[5], header[6], header[7],
+                  header[8], header[9], header[10], header[11], header[12], header[13], header[14], header[15]);
+        }
+        else {
+            uint32_t count = 0;
+            memcpy(&count, header + 4, 4);
+            for (uint32_t i = 0; i < count && i < 127; ++i) {
+                const uint8_t *e = header + 8 + 32 * i;
+                if (!strncmp(reinterpret_cast<const char *>(e), f->name, 24)) {memcpy(&offset, e + 24, 4); memcpy(&bytes, e + 28, 4);}
+            }
+            if (!bytes) rc = -2;
+            else if (bytes != f->bytes || (offset & 4095) || offset / 4096 + (bytes + 4095) / 4096 > gBlocks) rc = -8;
+        }
+        if (header) IOFreeData(header, 4096);
+        if (!rc) {
+            const size_t rounded = (bytes + 4095) & ~size_t(4095);
+            uint8_t *buf = static_cast<uint8_t *>(IOMallocData(rounded));
+            if (!buf) rc = -12;
+            else if (!native_ufs_part_read(gLun, gFirst + offset / 4096, uint32_t(rounded / 4096), buf)) {IOFreeData(buf, rounded); rc = -5;}
+            else f->data = buf;
+        }
+        IOLog("fuxi wifi fw: %s %s (rc %d, %u bytes at %u)\n", f->name, rc ? "FAILED" : "read", rc, bytes, offset);
+        gLastError = rc;
+    }
+    IOLockUnlock(lock);
+    if (rc) return rc;
+    *data = f->data; *size = f->bytes;
+    return 0;
+}
diff --git a/package/FuxiWifiFwStore.cpp b/package/FuxiWifiFwStore.cpp
new file mode 100644
index 0000000..6ec0ff6
--- /dev/null
+++ b/package/FuxiWifiFwStore.cpp
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// The embedded WCN7850 firmware (FuxiWifiFirmware.S) is stored as zlib streams; each file is inflated once, on its first request, into memory
+// kept for the boot. The stream's adler32 and the exact length (wifi-firmware/manifest.json) are checked. Shared by both Ath12kWifi board
+// files (FuxiWifiNw.cpp for the mainline runtime, FuxiWifiNw21.cpp for the 21H461 one) and the MhiBoot path (FuxiWifiMhi.cpp, fuxi-wifi=3).
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <string.h>
+#include <libkern/zlib.h>
+extern "C" const unsigned char fuxi_wifi_amss_z_start[],fuxi_wifi_amss_z_end[],fuxi_wifi_m3_z_start[],fuxi_wifi_m3_z_end[];
+extern "C" const unsigned char fuxi_wifi_board2_z_start[],fuxi_wifi_board2_z_end[];
+
+namespace {
+struct EmbeddedFw {const char *name;const unsigned char *z,*zEnd;size_t bytes;uint8_t *data;};
+EmbeddedFw gEmbedded[]={{"amss.bin",fuxi_wifi_amss_z_start,fuxi_wifi_amss_z_end,6090816,nullptr},
+                        {"m3.bin",fuxi_wifi_m3_z_start,fuxi_wifi_m3_z_end,299660,nullptr},
+                        {"board-2.bin",fuxi_wifi_board2_z_start,fuxi_wifi_board2_z_end,2431968,nullptr}};
+voidpf zAlloc(voidpf,uInt items,uInt size){
+ const size_t n=(size_t)items*size+16;uint8_t *p=static_cast<uint8_t *>(IOMallocData(n));
+ if(!p)return nullptr;*reinterpret_cast<size_t *>(p)=n;return p+16;
+}
+void zFree(voidpf,voidpf q){if(!q)return;uint8_t *p=static_cast<uint8_t *>(q)-16;IOFreeData(p,*reinterpret_cast<size_t *>(p));}
+}
+// Returns 0, -2 for a file not embedded, other negative values for a failed inflate.
+extern "C" int fuxi_wifi_firmware_get(const char *name,const uint8_t **data,size_t *size){
+ static IOLock *lock;
+ if(!__atomic_load_n(&lock,__ATOMIC_ACQUIRE)){
+  IOLock *created=IOLockAlloc(),*expected=nullptr;if(!created)return -12;
+  if(!__atomic_compare_exchange_n(&lock,&expected,created,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE))IOLockFree(created);
+ }
+ EmbeddedFw *f=nullptr;
+ for(EmbeddedFw &e:gEmbedded)if(!strcmp(e.name,name))f=&e;
+ if(!f)return -2;
+ IOLockLock(lock);
+ int rc=0;
+ if(!f->data){
+  uint8_t *out=static_cast<uint8_t *>(IOMallocData(f->bytes));
+  if(!out)rc=-12;
+  else{
+   z_stream s;memset(&s,0,sizeof s);s.zalloc=zAlloc;s.zfree=zFree;
+   s.next_in=const_cast<Bytef *>(f->z);s.avail_in=(uInt)(f->zEnd-f->z);s.next_out=out;s.avail_out=(uInt)f->bytes;
+   rc=inflateInit(&s);
+   if(rc==Z_OK){rc=inflate(&s,Z_FINISH);rc=rc==Z_STREAM_END&&s.total_out==f->bytes&&s.avail_in==0?0:(rc==Z_STREAM_END?-3:rc<0?rc:-4);inflateEnd(&s);}
+   else rc=rc<0?rc:-5;
+   if(rc)IOFreeData(out,f->bytes);else f->data=out;
+  }
+ }
+ IOLockUnlock(lock);
+ if(rc)return rc;
+ *data=f->data;*size=f->bytes;return 0;
+}
