diff --git a/ios17/overlay/scripts/make-fuxi-adt.py b/ios17/overlay/scripts/make-fuxi-adt.py
new file mode 100644
index 0000000..688d899
--- /dev/null
+++ b/ios17/overlay/scripts/make-fuxi-adt.py
@@ -0,0 +1,279 @@
+#!/usr/bin/env python3
+"""Generate the minimal sheng hardware Apple-format DT for the first boot.
+
+The tree mirrors the proven QEMU entry fixture structure (same required
+nodes and properties the source XNU boot converged on) with real pinned
+sheng SM8550 values taken from the compiled board DT:
+
+  - GICv3 distributor 0x17100000/0x10000, redistributor 0x17180000/0x200000
+    (arm-io child offsets under an APSS range at 0x17000000), stride 0x40000
+  - CPU timebase 19200000 Hz (Qualcomm SM8xxx architectural counter)
+  - DRAM base 0x80000000; size comes from the actual device observation and
+    is cross-checked at build time.
+
+This is first-boot bring-up data: the platform has no matching platform
+expert yet, so the kernel is expected to reach the video console and report
+the genuine missing-driver panic on screen. No Apple device identity is
+claimed and no property is invented beyond these pinned sources.
+"""
+from pathlib import Path
+import argparse
+import os
+import struct
+import zlib
+
+ROOT = Path(__file__).resolve().parents[1]
+
+DRAM_BASE = 0x80000000
+ARMIO_BASE = 0x17000000          # APSS peripheral block containing the GIC
+GIC_DIST = 0x17100000
+GIC_DIST_SIZE = 0x10000
+GIC_REDIST = 0x17180000
+GIC_REDIST_SIZE = 0x200000
+TIMEBASE = 19200000
+UFS_HC = 0x1d84000
+UFS_HC_SIZE = 0x3000
+UFS_PHY = 0x1d80000
+UFS_PHY_SIZE = 0x2000
+
+# The phone identities this board can present: root model -> (target type, product name, artwork geometry).
+# iPhone10,3 is the iOS row of the pinned UniXNU MobileGestalt guide; iPhone15,2 is the published identifier of the
+# iPhone 14 Pro, whose target type comes from Apple's own model references.
+# artwork-device-subtype is the artwork family's native pixel height, the same reading as the guide's iPad example 2732
+# (iPad Pro 12.9). The point width is not what the cell carries: iPhone X is 1125x2436 at 3x (375 pt), iPhone 14 Pro
+# 1179x2556 at 3x (393 pt).
+PHONE_MODELS = {'iPhone10,3': ('D22', 'iPhone X', 2436), 'iPhone15,2': ('D72', 'iPhone 14 Pro', 2556)}
+# /product product-id of the real board device tree (IPSW Firmware/all_flash/DeviceTree.<board>.im4p). libMobileGestalt keys its product
+# table by these 20 bytes (MGGetProductType); without them it answers 0xffffffff, and VirtualAudio, which picks its compiled-in routing
+# database by that product type (VirtualAudio 0x6e3dc), finds no category ("Unable to locate category '%s' in the routing database"),
+# so no audio session gets an output route. iPhone15,2: DeviceTree.d73ap.im4p of iPhone15,2_17.7_21H16_Restore.ipsw (MG table index 55,
+# product type 0xaf477c2d). iPhone10,3: DeviceTree.d22ap.im4p (docs/devices/nx769j.md).
+# /product/audio acoustic-id of the real board device tree: MobileGestalt's AcousticID, which VirtualAudio turns into its tuning directory
+# (/System/Library/Audio/Tunings/AID<n>/VAD/graph_configurations.plist). Without it the answer is 0, AID0 does not exist, VirtualAudio's
+# file reader throws "Could not construct" (VirtualAudio 0x17296c) and the plug-in stays "not initialized yet" (fopen hook, 2026-11-13).
+# iPhone15,2: 8006 (DeviceTree.d73ap.im4p; the 21H16 OS volume carries Library/Audio/Tunings/AID8006).
+PHONE_ACOUSTIC_IDS = {'iPhone15,2': 8006}
+PHONE_PRODUCT_IDS = {'iPhone10,3': bytes.fromhex('fd079b298144a7deb4d7c87fef3eb474d8f0e7eb'),
+                     'iPhone15,2': bytes.fromhex('d3b5ffca33e4604460655adfd77fdfa4757e7e93')}
+
+
+def node(name, properties=(), children=()):
+    properties = [('name', name.encode() + b'\0'), *properties]
+    result = struct.pack('<II', len(properties), len(children))
+    for key, data in properties:
+        result += struct.pack('<32sI', key.encode(), len(data))
+        result += data + bytes(-len(data) % 4)
+    return result + b''.join(children)
+
+
+def empty_nvram_proxy():
+    """A fresh volatile CHRP bank for upstream IODTNVRAM, with no controller."""
+    def header(name, size):
+        raw = bytearray(struct.pack('<BBH12s', 0x70, 0, size // 16, name))
+        checksum = sum(raw)
+        while checksum > 255:
+            checksum = (checksum & 255) + (checksum >> 8)
+        raw[1] = checksum
+        return raw
+
+    image = bytearray(8192)
+    image[:16] = header(b'nvram', 32)
+    image[32:48] = header(b'common', 16 + 2048)
+    free_at = 32 + 16 + 2048
+    image[free_at:free_at + 16] = header(b'free', len(image) - free_at)
+    struct.pack_into('<I', image, 16, zlib.adler32(image[20:]))
+    return [('nvram-bank-size', struct.pack('<I', len(image))),
+            ('nvram-bank-count', struct.pack('<I', 1)),
+            ('nvram-current-bank', struct.pack('<I', 0)),
+            ('nvram-proxy-data', bytes(image))]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path,
+                        default=ROOT / 'build/sheng/boot/kernel.macho.adt')
+    parser.add_argument('--dram-size', type=lambda value: int(value, 0), required=True,
+                        help='Actual observed DRAM size, e.g. 0x230000000')
+    parser.add_argument('--owned-memory-size', type=lambda value: int(value, 0), default=None,
+                        help='Explicit DarwinBoot contiguous window request, 256 MiB..8 GiB in 2 MiB steps')
+    parser.add_argument('--root-match-volume-uuid', default=None,
+                        help='/chosen/root-matching: select the root by the UUID of an IOMedia (the standard source mechanism)')
+    parser.add_argument('--unique-chip-id', type=lambda value: int(value, 16), default=None,
+                        help='/chosen/unique-chip-id (8 bytes) and --chip-id (4 bytes) seed XNU IOPlatformUUID; software identity seeds, not Apple silicon IDs')
+    parser.add_argument('--chip-id', type=lambda value: int(value, 16), default=None)
+    parser.add_argument('--ipad-identity', action='store_true',
+                        help='/product and /buttons describe an iPad-class device without a Home button (MobileGestalt reads these from the tree); '
+                             'values follow the unchanged iPad7,1 tree, the panel geometry and button set are sheng\'s')
+    parser.add_argument('--phone-identity', action='store_true',
+                        help='/product and /buttons describe an iPhone-class device without a Home button, with the geometry of --phone-model. '
+                             'The installed System must be an iPhoneOS root for its userland to match this identity')
+    parser.add_argument('--phone-model', default='iPhone15,2', choices=sorted(PHONE_MODELS),
+                        help='root model of the phone identity')
+    parser.add_argument('--cpu-regs', default='0',
+                        help='Comma-separated CPU MPIDR affinity values (the /cpus reg of each core); the first is the running boot CPU. '
+                             'SM8550 numbers its cores 0x000..0x700 in Affinity1 (sm8550.dtsi). More than one adds /psci')
+    parser.add_argument('--psci-method', choices=['smc', 'hvc'], default='smc',
+                        help='/psci method used by the secondary-CPU start (the board DT declares smc)')
+    parser.add_argument('--packed-data-ramdisk', action='store_true', help='Hand off validated DBRDISK1 bytes to the native sparse block driver, without a dense memdev alias')
+    parser.add_argument('--data-ramdisk', action='store_true',
+                        help='/chosen/memory-map RAMDisk placeholder; the loader fills in the real range for a scratch Data seed')
+    parser.add_argument('--persistent-data', action='store_true',
+                        help='The Data disk keeps its writes across boots (sheng-data-persist): no ephemeral-storage, so first-boot data migration runs')
+    parser.add_argument('--trust-cache', action='store_true', help='Zeroed TrustCache sidecar handoff placeholder')
+    parser.add_argument('--gpu-addon', action='store_true', help='GpuAddon sidecar handoff placeholder')
+    parser.add_argument('--system-volume-auth-blob', type=Path, default=None,
+                        help='validated iOS 21H461 SystemVolume root-hash payload for /chosen')
+    parser.add_argument('--vmm-present', action='store_true',
+                        help='/defaults/vmm-present = 1: kern.hv_vmm_present (bsd/kern/hvg_sysctl.c, IODTGetDefault) reports '
+                             'a virtual machine, so the original AMFI skips its ApplePMGRNub wait instead of panicking '
+                             '"AMFI: No PMGR?" on a board without the original PMGR')
+    parser.add_argument('--text-fixup', action='append', default=[],
+                        help='/chosen/text-fixups entry <file name>,<file offset>,<original>,<replacement> for the kernel\'s signed-text fixups')
+    args = parser.parse_args()
+    if (args.unique_chip_id is None) != (args.chip_id is None):
+        parser.error('--unique-chip-id and --chip-id must be supplied together')
+    if args.unique_chip_id is not None and not (0 < args.unique_chip_id < 1 << 64 and 0 < args.chip_id < 1 << 32):
+        parser.error('--unique-chip-id must fit 8 bytes and --chip-id 4 bytes, both nonzero')
+    if args.owned_memory_size is not None and (
+            not 0x10000000 <= args.owned_memory_size <= 0x200000000
+            or args.owned_memory_size % 0x200000):
+        parser.error('Owned memory must be 256 MiB to 8 GiB, aligned to 2 MiB')
+    system_volume_auth_blob = None
+    auth_blob = args.system_volume_auth_blob or (ROOT / '.cache/firmware/fuxi/system-volume-auth-blob.bin')
+    if auth_blob.exists() or args.system_volume_auth_blob is not None:
+        if not auth_blob.is_file():
+            parser.error(f'--system-volume-auth-blob not found: {auth_blob}')
+        system_volume_auth_blob = auth_blob.read_bytes()
+        if len(system_volume_auth_blob) != 208 or struct.unpack_from('<4I', system_volume_auth_blob) != (2, 0, 1, 32):
+            parser.error('--system-volume-auth-blob must be the pinned 208-byte 21H461 SystemVolume payload')
+
+    try:
+        cpu_regs = [int(value, 0) for value in args.cpu_regs.split(',')]
+    except ValueError:
+        parser.error('--cpu-regs must be integers')
+    if (not cpu_regs or cpu_regs[0] != 0 or len(set(cpu_regs)) != len(cpu_regs) or len(cpu_regs) > 8
+            or any(reg < 0 or reg > 0xffff or reg & 0xff for reg in cpu_regs)):
+        parser.error('--cpu-regs: up to eight distinct Affinity1-numbered cores, boot CPU 0 first')
+    cpus = [node('cpu%d' % index, [('state', b'running\0' if index == 0 else b'waiting\0'),
+                                   ('reg', struct.pack('<I', reg)),
+                                   ('device_type', b'cpu\0'), ('compatible', b'arm,cortex-a715\0'),
+                                   ('timebase-frequency', struct.pack('<I', TIMEBASE))])
+            for index, reg in enumerate(cpu_regs)]
+    if args.ipad_identity and args.phone_identity:
+        parser.error('--ipad-identity and --phone-identity select one identity each')
+    if args.ipad_identity:
+        identity = {'model': 'iPad7,1', 'target': 'J120', 'name': 'iPad Pro (12.9-inch) (2nd generation)',
+                    'idiom': 'pad', 'subtype': 2732, 'scale': 2, 'gamut': 'sRGB', 'fallback': 'iPad6,7'}
+    elif args.phone_identity:
+        target, name, subtype = PHONE_MODELS[args.phone_model]
+        # No compatible-device-fallback: its value comes from an iPhone device tree, which no pinned source here carries.
+        identity = {'model': args.phone_model, 'target': target, 'name': name,
+                    # gamut sRGB (2026-11-12): with P3 the 21H16 render server composes into 'b3a8' (BGR10_XR) surfaces, which the
+                    # display's GPU copy does not take, so NativeLegacyDisplay converted every frame on the CPU (convertXrRows: a third
+                    # of backboardd's samples, frames 40-50 ms apart). The iPad identity's sRGB gets BGRA.
+                    'idiom': 'phone', 'subtype': subtype, 'scale': 3, 'gamut': 'sRGB', 'fallback': None,
+                    'product_id': PHONE_PRODUCT_IDS.get(args.phone_model), 'acoustic_id': PHONE_ACOUSTIC_IDS.get(args.phone_model)}
+    else:
+        identity = None
+    tree = node('device-tree', [
+        # hw.product/hw.machine/hw.target come from the root 'model'/'target-type' (IODTPlatformExpert);
+        # libMobileGestalt prefix-matches hw.product against iPhone/iPod/iPad, so a device identity needs both here.
+        ('model', identity['model'].encode() + b'\0' if identity else b'sheng-first-boot\0'),
+        *([('target-type', identity['target'].encode() + b'\0')] if identity else []),
+        # Root compatible strings of the compiled board DT (xiaomi,sheng / qcom,sm8550).
+        ('compatible', b'xiaomi,sheng\0qcom,sm8550\0'),
+        ('#address-cells', struct.pack('<I', 2)),
+        ('#size-cells', struct.pack('<I', 2)),
+    ], [
+        node('chosen', [('random-seed', os.urandom(64)),
+                        # Without these XNU never publishes IOPlatformUUID and gethostuuid() blocks forever
+                        # for callers (configd) that pass a zero timeout.
+                        *([('unique-chip-id', struct.pack('<Q', args.unique_chip_id)), ('chip-id', struct.pack('<I', args.chip_id))]
+                          if args.unique_chip_id is not None else []),
+                        # This boots the normal target OS. Volatile Data is
+                        # described separately by ephemeral-storage below.
+                        ('osenvironment', b'main\0'),
+                        # Security status as on a dev-fused, undemoted board (tuple 0,0,1,1), as read by MobileGestalt: mobileactivationd's
+                        # DeviceType then takes its native "Hactivation" branch (Activated without an activation record; no SEP or
+                        # baseband). Values established on hardware by github.com/dipa-studio/ios-sweet (tools/mkadt.py).
+                        *([('certificate-production-status', struct.pack('<I', 0)), ('effective-production-status-ap', struct.pack('<I', 0)),
+                           ('certificate-security-mode', struct.pack('<I', 1)), ('effective-security-mode-sep', struct.pack('<I', 1))]
+                          if identity else []),
+                        # This property describes the actual volatile Data RAM disk. A persistent one is not ephemeral: with the property
+                        # datamigrator skips every migration (os_variant_uses_ephemeral_storage), so the staged system apps never install.
+                        *([('ephemeral-storage', struct.pack('<I', 1))]
+                          if (args.data_ramdisk or args.packed_data_ramdisk) and not args.persistent_data else []),
+                        *( [('darwinboot-memory-size', struct.pack('<Q', args.owned_memory_size))]
+                           if args.owned_memory_size else [] ),
+                        ('dram-base', struct.pack('<Q', DRAM_BASE)),
+                        ('dram-size', struct.pack('<Q', args.dram_size)),
+                        # Image4 hash algorithm. The target iPad's DT specifies sha2-384 in /chosen; this
+                        # selects the algorithm only and asserts nothing about Apple silicon or fuses.
+                        ('crypto-hash-method', b'sha2-384\0'),
+                        # Keeps /sbin/mount -P 1 from exiting 66 during the launchd mount phase.
+                        *([('text-fixups', b''.join(f.encode() + b'\0' for f in args.text_fixup))] if args.text_fixup else []),
+                        *( [('root-matching', ('<dict><key>IOProviderClass</key><string>IOMedia</string>'
+                                               '<key>IOPropertyMatch</key><dict><key>UUID</key><string>' +
+                                               args.root_match_volume_uuid.upper() + '</string></dict></dict>\0').encode())]
+                           if args.root_match_volume_uuid else [] ),
+                        # Strict policy for the original AMFI: platform code only. This keeps AMFI
+                        # enforcing; it does not relax it.
+                        ('amfi-only-platform-code', struct.pack('<I', 1)),
+                        *([('system-volume-auth-blob', system_volume_auth_blob)]
+                          if system_volume_auth_blob is not None else []),
+                        *empty_nvram_proxy()],
+             [node('memory-map', ([("PackedRAMDisk" if args.packed_data_ramdisk else "RAMDisk", bytes(16))] if (args.data_ramdisk or args.packed_data_ramdisk) else []) +
+                                 ([('TrustCache', bytes(16))] if args.trust_cache else []) +
+                                 ([('GpuAddon', bytes(16))] if args.gpu_addon else [])),
+              # Read by the original AppleImage4 at start-up; present and empty here.
+              node('manifest-properties')]),
+        node('cpus', children=cpus),
+        *([node('psci', [('compatible', b'arm,psci-1.0\0'), ('method', args.psci_method.encode() + b'\0')])] if len(cpus) > 1 else []),
+        # Suspend/resume is not implemented for this board. Use the original
+        # root-domain policy input rather than allowing the CPU to park forever.
+        node('defaults', [('sleep-disabled', struct.pack('<I', 1)), ('kern.maxvnodes', struct.pack('<I', 66560)),
+                          *([('vmm-present', struct.pack('<I', 1))] if args.vmm_present else [])]),
+        node('options', []),
+        # The original AppleImage4 panics without a product node. Name and model are the
+        # board DT's own strings.
+        *( [node('buttons', [('compatible', b'buttons\0'), ('device_type', b'buttons\0'),
+                             # No 'menu' entry: sheng has no Home button. 2 = the non-mechanical answer BSPlatform passes through.
+                             ('button-names', b'hold\0voldown\0volup\0'),
+                             ('home-button-type', struct.pack('<I', 2))])] if identity else [] ),
+        node('product', [('product-name', identity['name'].encode() + b'\0' if identity else b'Xiaomi Pad 6S Pro 12.4\0'),
+                         ('model', b'xiaomi,sheng\0'),
+                         *( [('product-description', identity['name'].encode() + b'\0'),
+                             ('artwork-device-idiom', identity['idiom'].encode() + b'\0'),
+                             ('artwork-device-subtype', struct.pack('<I', identity['subtype'])),
+                             ('artwork-scale-factor', struct.pack('<I', identity['scale'])),
+                             ('artwork-display-gamut', identity['gamut'].encode() + b'\0'),
+                             *([('compatible-device-fallback', identity['fallback'].encode() + b'\0')] if identity['fallback'] else []),
+                             *([('product-id', identity['product_id'])] if identity.get('product_id') else []),
+                             ('thin-bezel', struct.pack('<I', 1))] if identity else [] )],
+             [node('audio', [('acoustic-id', struct.pack('<I', identity['acoustic_id']))])]
+             if identity and identity.get('acoustic_id') else []),
+        node('arm-io', [('device_type', b'arm-io\0'),
+                        ('#address-cells', struct.pack('<I', 2)),
+                        ('#size-cells', struct.pack('<I', 2)),
+                        ('ranges', struct.pack('<QQQ', 0, ARMIO_BASE, 0x08000000))],
+             [node('intc', [('compatible', b'arm,gic-v3\0'),
+                            ('reg', struct.pack('<4Q',
+                                                GIC_DIST - ARMIO_BASE, GIC_DIST_SIZE,
+                                                GIC_REDIST - ARMIO_BASE, GIC_REDIST_SIZE)),
+                            ('redistributor-stride', struct.pack('<Q', 0x40000))]),
+              # UFS (0x1d84000) lies below the arm-io window, so a child reg offset would be
+              # negative. The node exists only for class matching; NativeUfs takes its
+              # physical windows from the board DT constants in GccUfs.h.
+              node('ufshc', [('compatible', b'qcom,sm8550-ufshc\0')]),
+              # The radio, for launchd: com.apple.wifid.plist (21H461) is _LimitLoadToDeviceTree ["wlan", "marconi-wifi"], so without a
+              # device-tree node of that name wifid is never loaded and Settings shows Wi-Fi greyed out (log 204929: wifid absent all
+              # session). As UniXNU-sheng dts/sheng.dts exports it; FuxiWifiNw21.cpp owns the PCIe resources and fills local-mac-address.
+              node('wlan', [('compatible', b'qcom,wcn7850\0'), ('device_type', b'wlan\0')])]),
+    ])
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_bytes(tree)
+    print(f'sheng ADT: {len(tree)} bytes, dram {args.dram_size:#x}, timebase {TIMEBASE}')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/ios17/overlay/scripts/make-wifi-fw.py b/ios17/overlay/scripts/make-wifi-fw.py
new file mode 100755
index 0000000..38111ed
--- /dev/null
+++ b/ios17/overlay/scripts/make-wifi-fw.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Build the WCN7850 firmware container for the partition named "oops" (fuxi iOS 17, FuxiWifiFwPart.cpp).
+Usage: make-wifi-fw.py <wifi-firmware dir> <output image> [partition bytes]
+
+Layout, as the UniXNU reference reads it (https://unixnu.com/zh/porting/network, UniXNU-sheng package/WifiProbe.cpp): block 0 (4096 bytes)
+holds 'WFW1', u32 count, then count entries of name[24] (NUL padded), u32 offset (bytes from the partition start, 4096-aligned) and
+u32 size; each file follows uncompressed at its offset. Every file is checked against manifest.json (SHA-256 and size) first.
+With the partition size given the image is padded to it and refused if it does not fit (fastboot flash writes the whole image)."""
+import hashlib, json, struct, sys
+from pathlib import Path
+
+fw_dir, out = Path(sys.argv[1]), Path(sys.argv[2])
+part_bytes = int(sys.argv[3], 0) if len(sys.argv) > 3 else 0
+manifest = json.loads((fw_dir / 'manifest.json').read_text())['files']
+order = ['amss.bin', 'm3.bin', 'board-2.bin']
+assert set(order) == set(manifest), sorted(manifest)
+files = []
+for name in order:
+    data = (fw_dir / name).read_bytes()
+    want = manifest[name]
+    if hashlib.sha256(data).hexdigest() != want['sha256'] or len(data) != want['bytes']:
+        raise SystemExit(f'{name}: does not match manifest.json')
+    files.append((name, data))
+header = bytearray(4096)
+header[0:8] = b'WFW1' + struct.pack('<I', len(files))
+offset, body = 4096, bytearray()
+for i, (name, data) in enumerate(files):
+    raw = name.encode()
+    assert len(raw) < 24
+    struct.pack_into('<24sII', header, 8 + 32 * i, raw, offset, len(data))
+    padded = data + bytes(-len(data) % 4096)
+    body += padded
+    offset += len(padded)
+image = bytes(header) + bytes(body)
+if part_bytes:
+    if len(image) > part_bytes:
+        raise SystemExit(f'image {len(image)} bytes does not fit the {part_bytes}-byte partition')
+    image += bytes(part_bytes - len(image))
+out.write_bytes(image)
+print(f'{out}: {len(image)} bytes, sha256 {hashlib.sha256(image).hexdigest()}')
+for i, (name, data) in enumerate(files):
+    n, off, size = struct.unpack_from('<24sII', header, 8 + 32 * i)
+    print(f'  {name:12s} offset {off:#x} size {size}')
diff --git a/ios17/overlay/statusbar/FuxiStatusBar.c b/ios17/overlay/statusbar/FuxiStatusBar.c
new file mode 100755
index 0000000..1b34a95
--- /dev/null
+++ b/ios17/overlay/statusbar/FuxiStatusBar.c
@@ -0,0 +1,244 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// fuxi status bar layout (iOS 17.7 21H16, arm64e): the 1080x2400 panel at 3x is 360x800 pt, a size no iPhone has, so UIKit
+// (_UIStatusBar) and SystemStatusUI (STUIStatusBar) choose their Fallback visual provider, which draws only a red "rdar" strip.
+// Following the fuxi iPadOS fix (状态栏修复-20261107.md), this library gives both status bars a subclass of the 1080-wide
+// DynamicSplitMedium provider with the class method it lacks (+referenceScreenScale = 3.0) and the panel's island rectangle
+// (-sensorAreaRect). Unlike that fix it writes no framework static variable: the status bar's own -_visualProviderClass is wrapped
+// through the Objective-C runtime and answers the subclass where it would answer Fallback, so no address is version-specific.
+// Status bars built before the library loaded are rebuilt from -layoutSubviews and from a 2 s scan of all windows (the lock screen's
+// bar no longer lays out). The system still draws the time, battery and every other item itself. Skipped in backboardd.
+// Loaded as a weak dylib of the NativeAdrenoMetal plugin (device-ios17/scripts/build-fuxi-statusbar.py).
+#include <objc/runtime.h>
+#include <objc/message.h>
+#include <dispatch/dispatch.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <IOKit/IOKitLib.h>
+
+// The kernel IOKit probe (unixnu-iokit-probe=1) logs every service lookup with the caller's name; a lookup of a class that does not
+// exist is the library's only diagnostic channel on a device without a readable unified log.
+static void fsbBeacon(const char *what) {
+    char name[200];   // the scr: row ends with the screen type: 96 bytes cut it off
+    snprintf(name, sizeof name, "FSB:%s", what);
+    io_service_t s = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching(name));
+    if (s) IOObjectRelease(s);
+}
+
+typedef struct { double x, y, w, h; } FsbRect;   // CGRect's layout (two CGPoint/CGSize double pairs)
+
+enum { kUI = 0, kST = 1, kKinds = 2, kMaxRebuilds = 12, kScanRounds = 31, kInstallTries = 30 };
+static const char *const kBar[kKinds] = {"_UIStatusBar", "STUIStatusBar"};
+static const char *const kFallback[kKinds] = {"_UIStatusBarVisualProvider_Fallback", "STUIStatusBarVisualProvider_Fallback"};
+static const char *const kBase[kKinds] = {"_UIStatusBarVisualProvider_DynamicSplitMedium", "STUIStatusBarVisualProvider_DynamicSplitMedium"};
+static const char *const kSub[kKinds] = {"FuxiUIStatusBarVisualProvider", "FuxiSTUIStatusBarVisualProvider"};
+static Class gBar[kKinds], gFallback[kKinds], gSub[kKinds];
+static IMP gOrigProviderClass[kKinds], gOrigLayout[kKinds];
+static int gRebuilds[kKinds];
+
+static double fsbReferenceScreenScale(id self, SEL cmd) { (void)self; (void)cmd; return 3.0; }
+// The island on this panel, in points, as measured on the fuxi screenshots of the iPadOS fix.
+static FsbRect fsbSensorAreaRect(id self, SEL cmd) { (void)self; (void)cmd; return (FsbRect){118, 12, 125, 36}; }
+
+static int gChoiceReported[kKinds];
+static Class fsbProviderClass(int k, id self, SEL cmd) {
+    Class chosen = ((Class (*)(id, SEL))gOrigProviderClass[k])(self, cmd);
+    if (gChoiceReported[k] < 3) {
+        char what[80];
+        snprintf(what, sizeof what, "choice%d:%s", k, chosen ? class_getName(chosen) : "nil");
+        ++gChoiceReported[k]; fsbBeacon(what);
+    }
+    return (chosen == gFallback[k] && gSub[k]) ? gSub[k] : chosen;
+}
+static Class fsbProviderClassUI(id self, SEL cmd) { return fsbProviderClass(kUI, self, cmd); }
+static Class fsbProviderClassST(id self, SEL cmd) { return fsbProviderClass(kST, self, cmd); }
+
+// A bar still holding a Fallback provider (built before the wrap) is rebuilt; at most kMaxRebuilds per kind, in case the choice still
+// comes back as Fallback.
+static void fsbRebuild(int k, id bar) {
+    if (!gSub[k] || gRebuilds[k] >= kMaxRebuilds) return;
+    id provider = ((id (*)(id, SEL))objc_msgSend)(bar, sel_registerName("visualProvider"));
+    if (!provider || object_getClass(provider) != gFallback[k]) return;
+    ++gRebuilds[k];
+    fsbBeacon(k == kUI ? "rebuild0" : "rebuild1");
+    ((void (*)(id, SEL))objc_msgSend)(bar, sel_registerName("resetVisualProvider"));
+    Ivar ivar = class_getInstanceVariable(gBar[k], "_visualProvider");
+    if (ivar) object_setIvar(bar, ivar, nil);
+    ((void (*)(id, SEL, Class))objc_msgSend)(bar, sel_registerName("_setVisualProviderClass:"), Nil);
+    ((void (*)(id, SEL))objc_msgSend)(bar, sel_registerName("_prepareVisualProviderIfNeeded"));
+    ((void (*)(id, SEL))objc_msgSend)(bar, sel_registerName("setNeedsLayout"));
+}
+static void fsbLayout(int k, id self, SEL cmd) {
+    ((void (*)(id, SEL))gOrigLayout[k])(self, cmd);
+    fsbRebuild(k, self);
+}
+static void fsbLayoutUI(id self, SEL cmd) { fsbLayout(kUI, self, cmd); }
+static void fsbLayoutST(id self, SEL cmd) { fsbLayout(kST, self, cmd); }
+
+static bool fsbInstall(int k) {
+    if (gOrigProviderClass[k]) return true;
+    Class bar = objc_getClass(kBar[k]), fallback = objc_getClass(kFallback[k]), base = objc_getClass(kBase[k]);
+    if (!bar || !fallback || !base) return false;
+    Class sub = objc_getClass(kSub[k]);
+    if (!sub) {
+        sub = objc_allocateClassPair(base, kSub[k], 0);
+        if (!sub) return false;
+        class_addMethod(object_getClass((id)sub), sel_registerName("referenceScreenScale"), (IMP)fsbReferenceScreenScale, "d16@0:8");
+        class_addMethod(sub, sel_registerName("sensorAreaRect"), (IMP)fsbSensorAreaRect, "{CGRect={CGPoint=dd}{CGSize=dd}}16@0:8");
+        objc_registerClassPair(sub);
+    }
+    Method chooser = class_getInstanceMethod(bar, sel_registerName("_visualProviderClass"));
+    Method layout = class_getInstanceMethod(bar, sel_registerName("layoutSubviews"));
+    if (!chooser || !layout) return false;
+    gBar[k] = bar; gFallback[k] = fallback; gSub[k] = sub;
+    gOrigLayout[k] = method_setImplementation(layout, k == kUI ? (IMP)fsbLayoutUI : (IMP)fsbLayoutST);
+    gOrigProviderClass[k] = method_setImplementation(chooser, k == kUI ? (IMP)fsbProviderClassUI : (IMP)fsbProviderClassST);
+    fsbBeacon(k == kUI ? "installed0" : "installed1");
+    return true;
+}
+
+static void fsbWalk(id view, unsigned depth) {
+    if (!view || depth > 14) return;
+    for (int k = 0; k < kKinds; ++k)
+        if (gBar[k] && ((bool (*)(id, SEL, Class))objc_msgSend)(view, sel_registerName("isKindOfClass:"), gBar[k])) fsbRebuild(k, view);
+    id subviews = ((id (*)(id, SEL))objc_msgSend)(view, sel_registerName("subviews"));
+    unsigned long count = subviews ? ((unsigned long (*)(id, SEL))objc_msgSend)(subviews, sel_registerName("count")) : 0;
+    for (unsigned long i = 0; i < count; ++i)
+        fsbWalk(((id (*)(id, SEL, unsigned long))objc_msgSend)(subviews, sel_registerName("objectAtIndex:"), i), depth + 1);
+}
+static void fsbScanWindows(void) {
+    Class window = objc_getClass("UIWindow");
+    if (!window) return;
+    id windows = nil;
+    SEL all = sel_registerName("allWindowsIncludingInternalWindows:onlyVisibleWindows:");
+    if (class_getClassMethod(window, all)) windows = ((id (*)(id, SEL, bool, bool))objc_msgSend)((id)window, all, true, false);
+    unsigned long count = windows ? ((unsigned long (*)(id, SEL))objc_msgSend)(windows, sel_registerName("count")) : 0;
+    for (unsigned long i = 0; i < count; ++i)
+        fsbWalk(((id (*)(id, SEL, unsigned long))objc_msgSend)(windows, sel_registerName("objectAtIndex:"), i), 0);
+}
+
+
+// fuxi layout probe (2026-11-13, Control Center cut on the right, keyboard taps dead): the geometry UIKit, Control Center and the keyboard
+// actually use, as beacons (the kernel IOKit probe always logs "FSB" lookups). Read-only.
+#include <dlfcn.h>
+typedef struct { double top, left, bottom, right; } FsbInsets;
+static void fsbRect(char *out, size_t size, const char *tag, FsbRect r) { snprintf(out, size, "%s=%.1f,%.1f,%.1fx%.1f", tag, r.x, r.y, r.w, r.h); }
+static int gProbeRounds;
+static void fsbLayoutProbe(void) {
+    if (gProbeRounds >= 4) return;
+    Class screenClass = objc_getClass("UIScreen");
+    if (!screenClass) return;
+    id screen = ((id (*)(id, SEL))objc_msgSend)((id)screenClass, sel_registerName("mainScreen"));
+    if (!screen) return;
+    ++gProbeRounds;
+    char what[200], a[64], b[64], c[64];
+    FsbRect bounds = ((FsbRect (*)(id, SEL))objc_msgSend)(screen, sel_registerName("bounds"));
+    FsbRect ref = ((FsbRect (*)(id, SEL))objc_msgSend)(screen, sel_registerName("_referenceBounds"));
+    FsbRect native = ((FsbRect (*)(id, SEL))objc_msgSend)(screen, sel_registerName("nativeBounds"));
+    double scale = ((double (*)(id, SEL))objc_msgSend)(screen, sel_registerName("scale"));
+    double nscale = ((double (*)(id, SEL))objc_msgSend)(screen, sel_registerName("nativeScale"));
+    long type = ((long (*)(id, SEL))objc_msgSend)(screen, sel_registerName("_screenType"));
+    fsbRect(a, sizeof a, "b", bounds); fsbRect(b, sizeof b, "ref", ref); fsbRect(c, sizeof c, "nat", native);
+    snprintf(what, sizeof what, "scr:%s:%s:%s:%s:s%.2f:ns%.3f:t%ld", getprogname(), a, b, c, scale, nscale, type);
+    fsbBeacon(what);
+    double (*edge)(void) = (double (*)(void))dlsym(RTLD_DEFAULT, "CCUIItemEdgeSize");
+    double (*gutter)(void) = (double (*)(void))dlsym(RTLD_DEFAULT, "CCUILayoutGutter");
+    FsbRect (*ccref)(void) = (FsbRect (*)(void))dlsym(RTLD_DEFAULT, "CCUIReferenceScreenBounds");
+    FsbInsets (*insets)(long) = (FsbInsets (*)(long))dlsym(RTLD_DEFAULT, "CCUILayoutEdgeInsetsForInterfaceOrientation");
+    if (edge || gutter || ccref || insets) {
+        FsbRect r = ccref ? ccref() : (FsbRect){0, 0, 0, 0};
+        FsbInsets in = insets ? insets(1) : (FsbInsets){0, 0, 0, 0};
+        snprintf(what, sizeof what, "cc:%s:edge%.1f:gut%.1f:ref%.1fx%.1f:ins%.1f,%.1f,%.1f,%.1f", getprogname(), edge ? edge() : -1.0,
+                 gutter ? gutter() : -1.0, r.w, r.h, in.top, in.left, in.bottom, in.right);
+        fsbBeacon(what);
+    }
+    Class kb = objc_getClass("UIKeyboardImpl");
+    if (kb) {
+        typedef struct { double w, h; } FsbSize;
+        FsbSize s = ((FsbSize (*)(id, SEL, long))objc_msgSend)((id)kb, sel_registerName("defaultSizeForInterfaceOrientation:"), 1);
+        snprintf(what, sizeof what, "kb:%s:%.1fx%.1f", getprogname(), s.w, s.h);
+        fsbBeacon(what);
+    }
+}
+// fuxi audio route probe (2026-11-13): the audio server loads the ShengAudio plug-in and answers every property, but never starts output
+// for a ringtone preview. What this process's audio session routes to (AVAudioSession currentRoute) and what the system offers as
+// routes (AVSystemController PickableRoutes) tell whether iOS made a port of the plug-in's device at all. Two rounds, beacons "FSB:au:".
+#include <dlfcn.h>
+static id fsbStr(const char *s) {
+    return ((id (*)(id, SEL, const char *))objc_msgSend)((id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), s);
+}
+static const char *fsbUtf8(id o) {
+    if (!o) return "-";
+    id d = ((id (*)(id, SEL))objc_msgSend)(o, sel_registerName("description"));
+    const char *s = d ? ((const char *(*)(id, SEL))objc_msgSend)(d, sel_registerName("UTF8String")) : NULL;
+    return s ? s : "?";
+}
+static long fsbCount(id a) {return a ? ((long (*)(id, SEL))objc_msgSend)(a, sel_registerName("count")) : -1;}
+static id fsbAt(id a, long i) {return ((id (*)(id, SEL, long))objc_msgSend)(a, sel_registerName("objectAtIndex:"), i);}
+static id fsbGet(id o, const char *sel) {return o ? ((id (*)(id, SEL))objc_msgSend)(o, sel_registerName(sel)) : NULL;}
+static int gAudioRounds;
+static void fsbAudioProbe(void) {
+    if (gAudioRounds >= 2) return;
+    ++gAudioRounds;
+    char what[200];
+    const char *prog = getprogname();
+    dlopen("/System/Library/Frameworks/AVFAudio.framework/AVFAudio", RTLD_LAZY);
+    Class sc = objc_getClass("AVAudioSession");
+    if (sc) {
+        id ses = fsbGet((id)sc, "sharedInstance");
+        id route = fsbGet(ses, "currentRoute");
+        id outs = fsbGet(route, "outputs"), ins = fsbGet(route, "inputs");
+        snprintf(what, sizeof what, "au:%s:r%d:cat=%s:outs%ld:ins%ld", prog, gAudioRounds, fsbUtf8(fsbGet(ses, "category")), fsbCount(outs), fsbCount(ins));
+        fsbBeacon(what);
+        for (long i = 0; i < fsbCount(outs) && i < 4; ++i) {
+            id port = fsbAt(outs, i);
+            snprintf(what, sizeof what, "au:%s:out%ld:%s:%s:%s", prog, i, fsbUtf8(fsbGet(port, "portType")), fsbUtf8(fsbGet(port, "portName")),
+                     fsbUtf8(fsbGet(port, "UID")));
+            fsbBeacon(what);
+        }
+        id avail = fsbGet(ses, "availableInputs");
+        for (long i = 0; i < fsbCount(avail) && i < 4; ++i) {
+            id port = fsbAt(avail, i);
+            snprintf(what, sizeof what, "au:%s:in%ld:%s:%s", prog, i, fsbUtf8(fsbGet(port, "portType")), fsbUtf8(fsbGet(port, "portName")));
+            fsbBeacon(what);
+        }
+    } else {
+        snprintf(what, sizeof what, "au:%s:noAVAudioSession", prog);
+        fsbBeacon(what);
+    }
+    dlopen("/System/Library/PrivateFrameworks/Celestial.framework/Celestial", RTLD_LAZY);
+    Class ac = objc_getClass("AVSystemController");
+    id ctl = ac ? fsbGet((id)ac, "sharedAVSystemController") : NULL;
+    if (ctl) {
+        id routes = ((id (*)(id, SEL, id))objc_msgSend)(ctl, sel_registerName("attributeForKey:"), fsbStr("AVSystemController_PickableRoutesAttribute"));
+        snprintf(what, sizeof what, "au:%s:pick%ld", prog, fsbCount(routes));
+        fsbBeacon(what);
+        for (long i = 0; i < fsbCount(routes) && i < 6; ++i) {
+            id r = fsbAt(routes, i);
+            id name = ((id (*)(id, SEL, id))objc_msgSend)(r, sel_registerName("objectForKey:"), fsbStr("RouteName"));
+            id type = ((id (*)(id, SEL, id))objc_msgSend)(r, sel_registerName("objectForKey:"), fsbStr("AVAudioRouteName"));
+            id uid = ((id (*)(id, SEL, id))objc_msgSend)(r, sel_registerName("objectForKey:"), fsbStr("RouteUID"));
+            snprintf(what, sizeof what, "au:%s:pick%ld:%s:%s:%s", prog, i, fsbUtf8(name), fsbUtf8(type), fsbUtf8(uid));
+            fsbBeacon(what);
+        }
+    }
+}
+static int gTick;
+static void fsbTick(void *context) {
+    (void)context;
+    for (int k = 0; k < kKinds; ++k) (void)fsbInstall(k);   // SystemStatusUI may load after the plugin
+    fsbScanWindows();
+    if (gTick == 3 || gTick == 15) fsbLayoutProbe();
+    if (gTick == 10 || gTick == 28) fsbAudioProbe();
+    if (++gTick < (kScanRounds > kInstallTries ? kScanRounds : kInstallTries))
+        dispatch_after_f(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), dispatch_get_main_queue(), NULL, fsbTick);
+}
+
+__attribute__((constructor)) static void fsbStart(void) {
+    const char *name = getprogname();
+    if (name && !strcmp(name, "backboardd")) return;
+    fsbBeacon("loaded");
+    for (int k = 0; k < kKinds; ++k) (void)fsbInstall(k);
+    dispatch_after_f(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), dispatch_get_main_queue(), NULL, fsbTick);
+}
