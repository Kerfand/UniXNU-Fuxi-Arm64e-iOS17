diff --git a/drivers/FuxiFtsTouch/FtsProtocol.c b/drivers/FuxiFtsTouch/FtsProtocol.c
new file mode 100755
index 0000000..72c843f
--- /dev/null
+++ b/drivers/FuxiFtsTouch/FtsProtocol.c
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// FTM5 host protocol; see FtsProtocol.h for the sources of the facts. No allocation and no libc: callers are kernel code.
+#include "FtsProtocol.h"
+
+static void put_addr(uint8_t *out, uint32_t addr) {
+    for (unsigned i = 0; i < FTS_HW_ADDR_BYTES; ++i) out[i] = (uint8_t)(addr >> (8 * (FTS_HW_ADDR_BYTES - 1 - i)));
+}
+
+size_t fts_frame_hw_write(uint8_t *out, uint32_t addr, const uint8_t *data, size_t len) {
+    out[0] = FTS_OP_HW_REG_W;
+    put_addr(out + 1, addr);
+    for (size_t i = 0; i < len; ++i) out[1 + FTS_HW_ADDR_BYTES + i] = data[i];
+    return 1 + FTS_HW_ADDR_BYTES + len;
+}
+
+size_t fts_frame_hw_read(uint8_t *out, uint32_t addr) {
+    out[0] = FTS_OP_HW_REG_R;
+    put_addr(out + 1, addr);
+    return 1 + FTS_HW_ADDR_BYTES;
+}
+
+static int xfer(struct fts_chip *c, size_t len) {
+    if (!c || !c->bus || !c->bus->xfer || !c->tx || !c->rx || len > FTS_XFER_MAX) return FTS_ERR_PARAM;
+    return c->bus->xfer(c->bus->ctx, c->tx, c->rx, len) ? FTS_ERR_BUS : FTS_OK;
+}
+
+static void wait_ms(struct fts_chip *c, unsigned ms) {
+    if (c->bus->delay_ms) c->bus->delay_ms(c->bus->ctx, ms);
+}
+
+// A read is one full-duplex transfer: the command goes out while the first bytes clocked in are ignored, then one
+// dummy byte, then the data. The transmit side is zero after the command.
+static int read_after(struct fts_chip *c, size_t cmd_len, uint8_t *out, size_t len) {
+    const size_t total = cmd_len + FTS_DUMMY_BYTES + len;
+    if (total > FTS_XFER_MAX) return FTS_ERR_PARAM;
+    for (size_t i = cmd_len; i < total; ++i) c->tx[i] = 0;
+    int r = xfer(c, total);
+    if (r) return r;
+    for (size_t i = 0; i < len; ++i) out[i] = c->rx[cmd_len + FTS_DUMMY_BYTES + i];
+    return FTS_OK;
+}
+
+int fts_hw_write(struct fts_chip *c, uint32_t addr, const uint8_t *data, size_t len) {
+    if (!c || !c->tx || 1 + FTS_HW_ADDR_BYTES + len > FTS_XFER_MAX) return FTS_ERR_PARAM;
+    return xfer(c, fts_frame_hw_write(c->tx, addr, data, len));
+}
+
+int fts_hw_read(struct fts_chip *c, uint32_t addr, uint8_t *out, size_t len) {
+    if (!c || !c->tx) return FTS_ERR_PARAM;
+    return read_after(c, fts_frame_hw_read(c->tx, addr), out, len);
+}
+
+int fts_read_chip_id(struct fts_chip *c) {
+    int r = fts_hw_read(c, FTS_ADDR_CHIP_ID, c->id, 2);
+    if (r) return r;
+    return c->id[0] == FTS_CHIP_ID0 && c->id[1] == FTS_CHIP_ID1 ? FTS_OK : FTS_ERR_CHIP;
+}
+
+int fts_read_fifo(struct fts_chip *c, uint8_t *out, unsigned count) {
+    if (!c || !c->tx || !count || count > FTS_FIFO_DEPTH) return FTS_ERR_PARAM;
+    c->tx[0] = FTS_OP_FIFO_READ;
+    return read_after(c, 1, out, (size_t)count * FTS_EVENT_SIZE);
+}
+
+int fts_read_events(struct fts_chip *c, uint8_t *out, unsigned *count) {
+    *count = 0;
+    int r = fts_read_fifo(c, out, 1);
+    if (r) return r;
+    if (out[0] == FTS_EVT_NOEVENT) return FTS_OK;
+    unsigned more = out[FTS_EVT_REMAINING_POS] & FTS_EVT_REMAINING_MASK;
+    if (more > FTS_FIFO_DEPTH - 1) more = FTS_FIFO_DEPTH - 1;
+    if (more) {
+        r = fts_read_fifo(c, out + FTS_EVENT_SIZE, more);
+        if (r) {*count = 1; return r;}
+    }
+    *count = 1 + more;
+    return FTS_OK;
+}
+
+int fts_wait_event(struct fts_chip *c, uint8_t id, unsigned timeout_ms) {
+    uint8_t ev[FTS_EVENT_SIZE];
+    const unsigned limit = timeout_ms / FTS_POLL_STEP_MS ? timeout_ms / FTS_POLL_STEP_MS : 1;
+    c->polls = 0;
+    while (c->polls < limit) {
+        int r = fts_read_fifo(c, ev, 1);
+        if (r) return r;
+        ++c->polls;
+        for (unsigned i = 0; i < FTS_EVENT_SIZE; ++i) c->last_event[i] = ev[i];
+        if (fts_event_class(ev[0]) == FTS_CLASS_ERROR) ++c->errors_seen;
+        if (ev[0] == id) return FTS_OK;
+        wait_ms(c, FTS_POLL_STEP_MS);
+    }
+    return FTS_ERR_TIMEOUT;
+}
+
+int fts_reset(struct fts_chip *c) {
+    if (!c || !c->bus) return FTS_ERR_PARAM;
+    int r = FTS_ERR_TIMEOUT;
+    c->spi4_fallback = 0;
+    for (c->reset_attempts = 1; c->reset_attempts <= FTS_RESET_RETRIES; ++c->reset_attempts) {
+        if (c->bus->reset) {
+            c->bus->reset(c->bus->ctx, 0);
+            wait_ms(c, FTS_RESET_LOW_MS);
+            c->bus->reset(c->bus->ctx, 1);
+        } else {
+            const uint8_t v = FTS_SYSTEM_RESET_VALUE;
+            r = fts_hw_write(c, FTS_ADDR_SYSTEM_RESET, &v, 1);
+            if (r) continue;
+        }
+        r = fts_wait_event(c, FTS_EVT_CONTROLLER_READY, FTS_POLL_TIMEOUT_MS);
+        if (!r) return FTS_OK;
+        if (r == FTS_ERR_BUS || r == FTS_ERR_PARAM) return r;
+    }
+    c->reset_attempts = FTS_RESET_RETRIES;
+    c->spi4_fallback = 1;
+    const uint8_t icr = FTS_ICR_SPI4;
+    int w = fts_hw_write(c, FTS_ADDR_ICR, &icr, 1);
+    if (w) return w;
+    wait_ms(c, 1);
+    for (unsigned i = 0; i < FTS_ID_RETRIES; ++i) {
+        wait_ms(c, 10);
+        w = fts_read_chip_id(c);
+        if (w != FTS_ERR_CHIP) break;
+    }
+    if (w == FTS_ERR_BUS) return w;
+    return w ? FTS_ERR_CHIP : FTS_ERR_TIMEOUT;   // with the id: the chip answers but its firmware never reported ready
+}
+
+int fts_set_scan(struct fts_chip *c, uint8_t mode, uint8_t settings) {
+    if (!c || !c->tx) return FTS_ERR_PARAM;
+    c->tx[0] = FTS_OP_SCAN_MODE;
+    c->tx[1] = mode;
+    c->tx[2] = settings;
+    return xfer(c, 3);
+}
+
+int fts_start_sensing(struct fts_chip *c) {
+    int r = fts_set_scan(c, FTS_SCAN_ACTIVE, FTS_SCAN_SENSE_OFF);
+    if (r) return r;
+    wait_ms(c, FTS_SENSE_OFF_WAIT_MS);
+    return fts_set_scan(c, FTS_SCAN_ACTIVE, FTS_SCAN_SENSE_ON);
+}
diff --git a/drivers/FuxiFtsTouch/FtsProtocol.h b/drivers/FuxiFtsTouch/FtsProtocol.h
new file mode 100755
index 0000000..069b017
--- /dev/null
+++ b/drivers/FuxiFtsTouch/FtsProtocol.h
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// ST FingerTip (FTM5, chip id 36 40) host protocol over an abstract full-duplex SPI transport.
+// Protocol facts follow a study of the Xiaomi fts_spi driver that the fuxi kernel loads (LineageOS
+// android_kernel_xiaomi_sm8550 drivers/input/touchscreen/fts_spi, built with SALIXP, SPI4_WIRE, no I2C_INTERFACE
+// and support-super-resolution). No code is copied from it. No board addresses, clocks or pins here.
+#ifndef FTS_PROTOCOL_H
+#define FTS_PROTOCOL_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// ---- Operation codes (SPI form) ----
+#define FTS_OP_HW_REG_W 0xFA        // ftsHardware.h FTS_CMD_HW_REG_W
+#define FTS_OP_HW_REG_R 0xFB        // FTS_CMD_HW_REG_R for SPI (0xFA is the I2C form)
+#define FTS_OP_FIFO_READ 0x87       // FIFO_CMD_READALL and FIFO_CMD_READONE for SPI (0x86 for I2C)
+#define FTS_OP_SCAN_MODE 0xA0       // ftsSoftware.h FTS_CMD_SCAN_MODE: A0 <mode> <settings>
+#define FTS_HW_ADDR_BYTES 4         // ADDR_SIZE_HW_REG = BITS_32, sent big-endian
+#define FTS_DUMMY_BYTES 1           // DUMMY_HW_REG / DUMMY_FIFO: the first byte clocked in after the command is discarded
+
+// ---- Hardware registers (through FA / FB) ----
+#define FTS_ADDR_CHIP_ID 0x20000000u    // ADDR_DCHIP_ID: two bytes, 36 40
+#define FTS_ADDR_FW_VER 0x20000004u
+#define FTS_ADDR_SYSTEM_RESET 0x20000024u
+#define FTS_SYSTEM_RESET_VALUE 0x81     // soft reset, used only without a reset GPIO
+#define FTS_ADDR_ICR 0x2000002Du        // interface control; SPI4_MASK selects 4-wire SPI
+#define FTS_ICR_SPI4 0x02
+#define FTS_CHIP_ID0 0x36               // DCHIP_ID_0 (SALIXP)
+#define FTS_CHIP_ID1 0x40               // DCHIP_ID_1; the firmware header target of st_fts_m3.ftb is 0x4036
+
+// ---- Scan mode ----
+#define FTS_SCAN_ACTIVE 0x00
+#define FTS_SCAN_SENSE_OFF 0x00         // settings byte of A0 00 00
+#define FTS_SCAN_SENSE_ON 0x01          // settings byte of A0 00 01 (fts_init_sensing and the resume path)
+
+// ---- FIFO and events ----
+#define FTS_EVENT_SIZE 8
+#define FTS_FIFO_DEPTH 32
+#define FTS_EVT_REMAINING_POS 7         // EVENTS_REMAINING_POS: low five bits count the events still queued
+#define FTS_EVT_REMAINING_MASK 0x1F
+#define FTS_EVT_NOEVENT 0x00
+#define FTS_EVT_CONTROLLER_READY 0x03   // whole byte: the chip finished a reset
+// The interrupt handler dispatches on the high nibble of byte 0 (fts_event_handler: eventId = data[0] >> 4); the low
+// bits of byte 0 also carry the top bits of the contact major axis, so 0x13 and 0x17 are both an enter event.
+#define FTS_CLASS_ENTER 0x1
+#define FTS_CLASS_MOTION 0x2
+#define FTS_CLASS_LEAVE 0x3
+#define FTS_CLASS_STATUS 0x4
+#define FTS_CLASS_USER 0x5
+#define FTS_CLASS_DEBUG 0xE
+#define FTS_CLASS_ERROR 0xF
+#define FTS_ERROR_WATCHDOG 0x06         // EVT_TYPE_ERROR_WATCHDOG: the driver resets the chip
+#define FTS_ERROR_ESD 0xF0              // EVT_TYPE_ERROR_ESD: the driver power-cycles and resets the chip
+#define FTS_TOUCH_INVALID 0x00
+#define FTS_TOUCH_FINGER 0x01
+#define FTS_TOUCH_GLOVE 0x02
+#define FTS_TOUCH_STYLUS 0x03
+#define FTS_TOUCH_PALM 0x04
+#define FTS_TOUCH_HOVER 0x05
+#define FTS_TOUCH_ID_MAX 10             // TOUCH_ID_MAX
+
+// ---- Timing ----
+#define FTS_RESET_LOW_MS 10             // fts_system_reset: reset low for 10 ms, then high
+#define FTS_POLL_STEP_MS 2              // TIMEOUT_RESOLUTION
+#define FTS_POLL_TIMEOUT_MS 100         // GENERAL_TIMEOUT
+#define FTS_RESET_RETRIES 3             // RETRY_SYSTEM_RESET
+#define FTS_SENSE_OFF_WAIT_MS 50        // WAIT_AFTER_SENSEOFF
+#define FTS_ID_RETRIES 3                // fts_init: chip id read three times, 10 ms apart, after a failed reset
+
+// ---- Buffers ----
+// Largest transfer: the command byte, the dummy byte and a full FIFO.
+#define FTS_XFER_MAX (1 + FTS_DUMMY_BYTES + FTS_EVENT_SIZE * FTS_FIFO_DEPTH)
+
+#define FTS_OK 0
+#define FTS_ERR_BUS (-5)
+#define FTS_ERR_PARAM (-22)
+#define FTS_ERR_CHIP (-19)
+#define FTS_ERR_TIMEOUT (-110)
+
+// Transport: full-duplex SPI mode 0, one transfer with chip select held for its whole length. rx receives len bytes.
+// reset drives the reset line (0 low, 1 high); NULL means the board has no reset GPIO and the soft reset register is used.
+struct fts_bus {
+    void *ctx;
+    int (*xfer)(void *ctx, const uint8_t *tx, uint8_t *rx, size_t len);
+    void (*delay_ms)(void *ctx, unsigned ms);
+    void (*reset)(void *ctx, int level);
+};
+
+struct fts_chip {
+    const struct fts_bus *bus;
+    uint8_t *tx, *rx;                 // caller supplied, FTS_XFER_MAX bytes each (DMA-safe if the transport needs it)
+    uint8_t id[2];
+    uint8_t last_event[FTS_EVENT_SIZE];   // last event read while polling, for diagnostics
+    unsigned polls;                   // FIFO reads spent in the last wait
+    unsigned reset_attempts;          // attempts used by the last fts_reset
+    unsigned errors_seen;             // error events met while polling
+    int spi4_fallback;                // 1: the reset gave no ready event and the ICR fallback ran
+};
+
+static inline unsigned fts_event_class(uint8_t id) {return id >> 4;}
+static inline int fts_is_touch_event(uint8_t id) {
+    const unsigned c = fts_event_class(id);
+    return id != FTS_EVT_NOEVENT && (c == FTS_CLASS_ENTER || c == FTS_CLASS_MOTION || c == FTS_CLASS_LEAVE);
+}
+
+// Command frames. Each returns the number of bytes written to out.
+size_t fts_frame_hw_write(uint8_t *out, uint32_t addr, const uint8_t *data, size_t len);
+size_t fts_frame_hw_read(uint8_t *out, uint32_t addr);
+
+int fts_hw_write(struct fts_chip *c, uint32_t addr, const uint8_t *data, size_t len);
+int fts_hw_read(struct fts_chip *c, uint32_t addr, uint8_t *out, size_t len);
+int fts_read_chip_id(struct fts_chip *c);
+// Reads count (1..FTS_FIFO_DEPTH) events in one transfer into out (count * 8 bytes).
+int fts_read_fifo(struct fts_chip *c, uint8_t *out, unsigned count);
+// Reads the head event and then the rest of the queue it announces; *count is the number of events in out
+// (out holds FTS_FIFO_DEPTH * 8 bytes). A queue that starts with NOEVENT gives *count = 0.
+int fts_read_events(struct fts_chip *c, uint8_t *out, unsigned *count);
+// Polls the FIFO every FTS_POLL_STEP_MS until an event whose first byte is id arrives.
+int fts_wait_event(struct fts_chip *c, uint8_t id, unsigned timeout_ms);
+// fts_system_reset: pulse the reset line (or write the soft reset), then wait for CONTROLLER_READY; up to three attempts.
+// Without a ready event it falls back as fts_init does: select 4-wire SPI in the ICR and read the chip id, so a chip
+// without firmware is told from a missing one (FTS_ERR_TIMEOUT with id 36 40, FTS_ERR_CHIP without).
+int fts_reset(struct fts_chip *c);
+int fts_set_scan(struct fts_chip *c, uint8_t mode, uint8_t settings);
+// fts_init_sensing with FTS_FOD_AREA_REPORT: sense off, wait 50 ms, sense on.
+int fts_start_sensing(struct fts_chip *c);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
+
diff --git a/drivers/FuxiFtsTouch/FtsTouchCore.c b/drivers/FuxiFtsTouch/FtsTouchCore.c
new file mode 100755
index 0000000..fca1c0d
--- /dev/null
+++ b/drivers/FuxiFtsTouch/FtsTouchCore.c
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Contact tracking for FTM5 events. The handling of each event class follows the driver's handlers: finger, glove
+// and palm touch, hover does not, an invalid type is ignored; watchdog and ESD errors make the driver reset the chip.
+#include "FtsTouchCore.h"
+
+void fts_decode_point(const uint8_t ev[FTS_EVENT_SIZE], int super_resolution, struct fts_point *p) {
+    p->type = ev[1] & 0x0F;
+    p->id = (ev[1] & 0xF0) >> 4;
+    if (super_resolution) {
+        p->x = (ev[3] << 8) | ev[2];
+        p->y = (ev[5] << 8) | ev[4];
+    } else {
+        p->x = ((ev[3] & 0x0F) << 8) | ev[2];
+        p->y = (ev[4] << 4) | ((ev[3] & 0xF0) >> 4);
+    }
+    p->major = ((ev[0] & 0x0C) << 2) | ((ev[6] & 0xF0) >> 4);
+    p->minor = ((ev[7] & 0xC0) >> 2) | (ev[6] & 0x0F);
+}
+
+void fts_touch_init(struct fts_touch_core *t, int super_resolution, int x_max, int y_max) {
+    uint8_t *b = (uint8_t *)t;
+    for (unsigned i = 0; i < sizeof *t; ++i) b[i] = 0;
+    t->super_resolution = super_resolution;
+    t->x_max = x_max;
+    t->y_max = y_max;
+}
+
+void fts_touch_release_all(struct fts_touch_core *t) {t->down = 0;}
+
+static int set_slot(struct fts_touch_core *t, const struct fts_point *p) {
+    struct fts_point *s = &t->slot[p->id];
+    const uint16_t bit = (uint16_t)(1u << p->id);
+    const int changed = !(t->down & bit) || s->x != p->x || s->y != p->y;
+    *s = *p;
+    t->down |= bit;
+    return changed;
+}
+
+static int clear_slot(struct fts_touch_core *t, int id) {
+    const uint16_t bit = (uint16_t)(1u << id);
+    const int changed = (t->down & bit) != 0;
+    t->down &= (uint16_t)~bit;
+    return changed;
+}
+
+int fts_touch_apply(struct fts_touch_core *t, const uint8_t ev[FTS_EVENT_SIZE]) {
+    if (ev[0] == FTS_EVT_NOEVENT) return 0;
+    if (ev[0] == FTS_EVT_CONTROLLER_READY) {
+        // Unrequested: the chip reset itself and dropped its scan mode and every contact.
+        ++t->readies;
+        t->reset_needed = 1;
+        const int changed = t->down != 0;
+        fts_touch_release_all(t);
+        return changed;
+    }
+    switch (fts_event_class(ev[0])) {
+    case FTS_CLASS_ENTER:
+    case FTS_CLASS_MOTION: {
+        struct fts_point p;
+        fts_decode_point(ev, t->super_resolution, &p);
+        if (p.id >= FTS_SLOTS) {++t->invalid; return 0;}
+        if (p.x > t->x_max) p.x = t->x_max;
+        if (p.y > t->y_max) p.y = t->y_max;
+        if (fts_event_class(ev[0]) == FTS_CLASS_ENTER) ++t->enters; else ++t->motions;
+        switch (p.type) {
+        case FTS_TOUCH_FINGER: case FTS_TOUCH_GLOVE: case FTS_TOUCH_PALM: case FTS_TOUCH_STYLUS:
+            return set_slot(t, &p);
+        case FTS_TOUCH_HOVER:
+            ++t->hovers;
+            return clear_slot(t, p.id);
+        default:
+            ++t->invalid;
+            return 0;
+        }
+    }
+    case FTS_CLASS_LEAVE: {
+        const int id = (ev[1] & 0xF0) >> 4;
+        ++t->leaves;
+        if (id >= FTS_SLOTS) {++t->invalid; return 0;}
+        return clear_slot(t, id);
+    }
+    case FTS_CLASS_STATUS:
+        ++t->status;
+        t->last_status[0] = ev[1]; t->last_status[1] = ev[2]; t->last_status[2] = ev[3];
+        return 0;
+    case FTS_CLASS_USER:
+        ++t->user;
+        return 0;
+    case FTS_CLASS_ERROR:
+        ++t->errors;
+        t->last_error[0] = ev[1]; t->last_error[1] = ev[2];
+        if (ev[1] == FTS_ERROR_WATCHDOG || ev[1] == FTS_ERROR_ESD) {
+            t->reset_needed = 1;
+            const int changed = t->down != 0;
+            fts_touch_release_all(t);
+            return changed;
+        }
+        return 0;
+    default:
+        ++t->unknown;
+        return 0;
+    }
+}
+
+int fts_touch_apply_events(struct fts_touch_core *t, const uint8_t *events, unsigned count) {
+    int changed = 0;
+    for (unsigned i = 0; i < count; ++i) {
+        const uint8_t *ev = events + (size_t)i * FTS_EVENT_SIZE;
+        if (ev[0] == FTS_EVT_NOEVENT) break;
+        changed |= fts_touch_apply(t, ev);
+    }
+    return changed;
+}
+
+unsigned fts_touch_contacts(const struct fts_touch_core *t, struct fts_point *out, unsigned capacity) {
+    unsigned n = 0;
+    for (int id = 0; id < FTS_SLOTS && n < capacity; ++id) {
+        if (t->down & (1u << id)) out[n++] = t->slot[id];
+    }
+    return n;
+}
+
+static int map_axis(int v, int from_max, int to_max) {
+    if (v < 0) v = 0;
+    if (v > from_max) v = from_max;
+    return from_max > 0 ? (int)((int64_t)v * to_max / from_max) : 0;
+}
+
+void fts_map_point(const struct fts_map *m, int x, int y, int *out_x, int *out_y) {
+    int ox, oy;
+    if (m->flags & FTS_MAP_SWAP_XY) {
+        ox = map_axis(y, m->from_y_max, m->to_x_max);
+        oy = map_axis(x, m->from_x_max, m->to_y_max);
+    } else {
+        ox = map_axis(x, m->from_x_max, m->to_x_max);
+        oy = map_axis(y, m->from_y_max, m->to_y_max);
+    }
+    if (m->flags & FTS_MAP_MIRROR_X) ox = m->to_x_max - ox;
+    if (m->flags & FTS_MAP_MIRROR_Y) oy = m->to_y_max - oy;
+    *out_x = ox;
+    *out_y = oy;
+}
diff --git a/drivers/FuxiFtsTouch/FtsTouchCore.h b/drivers/FuxiFtsTouch/FtsTouchCore.h
new file mode 100755
index 0000000..202686d
--- /dev/null
+++ b/drivers/FuxiFtsTouch/FtsTouchCore.h
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Contact tracking for FTM5 events: the controller reports per-contact enter, motion and leave events with its own
+// tracking id (0..9), so the host only keeps a slot per id. Pure: no allocation, no I/O.
+#ifndef FTS_TOUCH_CORE_H
+#define FTS_TOUCH_CORE_H
+#include <stdint.h>
+#include "FtsProtocol.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define FTS_SLOTS FTS_TOUCH_ID_MAX
+
+struct fts_point {
+    int id, x, y;          // controller units (fuxi: 0..10800 x 0..24000, ten times the panel pixels)
+    int major, minor;
+    uint8_t type;
+};
+
+struct fts_touch_core {
+    int super_resolution;  // DT fts,support-super-resolution (fuxi 1)
+    int x_max, y_max;      // DT fts,x-max / fts,y-max: coordinates are clamped to these
+    uint16_t down;         // bit n: slot n is touching
+    struct fts_point slot[FTS_SLOTS];
+    // Counters for the diagnostic page.
+    uint32_t enters, motions, leaves, hovers, invalid, status, user, errors, readies, unknown;
+    uint8_t last_error[2];         // ev[1], ev[2] of the last error event
+    uint8_t last_status[3];        // ev[1..3] of the last status event
+    int reset_needed;              // a watchdog or ESD error, or an unrequested ready event: the chip must be reset or re-armed
+};
+
+void fts_touch_init(struct fts_touch_core *t, int super_resolution, int x_max, int y_max);
+// Lifts every contact (the driver's release_all_touches).
+void fts_touch_release_all(struct fts_touch_core *t);
+// Applies one event. Returns 1 when the set of touching contacts or a position changed, 0 otherwise.
+int fts_touch_apply(struct fts_touch_core *t, const uint8_t ev[FTS_EVENT_SIZE]);
+// Applies count events (FTS_EVENT_SIZE bytes each) and stops at a NOEVENT entry, as the interrupt handler does.
+int fts_touch_apply_events(struct fts_touch_core *t, const uint8_t *events, unsigned count);
+// Copies the touching contacts in id order; returns how many.
+unsigned fts_touch_contacts(const struct fts_touch_core *t, struct fts_point *out, unsigned capacity);
+
+// Decodes the position, size, id and type of a touch event.
+void fts_decode_point(const uint8_t ev[FTS_EVENT_SIZE], int super_resolution, struct fts_point *p);
+
+// Board transform from controller units to the units a consumer expects: optional swap and mirror, then a linear
+// scale from 0..from_max to 0..to_max on each axis. Integer arithmetic, rounding down.
+#define FTS_MAP_SWAP_XY 1u
+#define FTS_MAP_MIRROR_X 2u
+#define FTS_MAP_MIRROR_Y 4u
+struct fts_map {
+    int from_x_max, from_y_max, to_x_max, to_y_max;
+    unsigned flags;
+};
+void fts_map_point(const struct fts_map *m, int x, int y, int *out_x, int *out_y);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/drivers/FuxiFtsTouch/README.md b/drivers/FuxiFtsTouch/README.md
new file mode 100755
index 0000000..e47927d
--- /dev/null
+++ b/drivers/FuxiFtsTouch/README.md
@@ -0,0 +1,32 @@
+# FuxiFtsTouch
+
+ST FingerTip FTM5 touch controller protocol and contact tracking over an abstract SPI transport, written for the
+Xiaomi 13 (fuxi, SM8550) panel. The controller keeps its firmware in its own flash, so the host only resets it, waits
+for its ready event, starts sensing and drains its event FIFO.
+
+| File | Contents |
+| --- | --- |
+| `FtsProtocol.c`, `FtsProtocol.h` | Framing, register reads and writes, FIFO reads, reset with the ready wait and the 4-wire SPI fallback, sensing start |
+| `FtsTouchCore.c`, `FtsTouchCore.h` | Contact slots by controller tracking id, event classes, error recovery flags, board coordinate transform |
+| `Test/fts-protocol.c` | Host test against a model of the controller's SPI side |
+| `Test/touch-core.c` | Host test of the event decoding and contact tracking |
+
+The code is pure C: no allocation, no libc, no board addresses. Callers provide the transport through `struct fts_bus`
+(full-duplex transfer, millisecond delay, reset line). The protocol facts follow a study of the Xiaomi `fts_spi` driver
+that the fuxi kernel loads; no code is copied from it.
+
+The fuxi board probe, its constants and the device tree facts are in
+[OddlyLabs/unixnu-fuxi](https://github.com/OddlyLabs/unixnu-fuxi). The catalog entry is in
+[OddlyLabs/UniXNU](https://github.com/OddlyLabs/UniXNU) (`components.toml`, ID `FuxiFtsTouch`).
+
+## Tests
+
+```sh
+for t in fts-protocol touch-core; do
+  cc -std=c11 -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Werror -I. Test/$t.c FtsProtocol.c FtsTouchCore.c -o /tmp/$t && /tmp/$t
+done
+```
+
