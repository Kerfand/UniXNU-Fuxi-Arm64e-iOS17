+bool waitUp(uint32_t ms) {
+    const uint64_t end = nowMs() + ms;
+    while (!__atomic_load_n(&gAudio.up, __ATOMIC_ACQUIRE)) {
+        if (nowMs() >= end) return false;
+        IOSleep(10);
+    }
+    return true;
+}
