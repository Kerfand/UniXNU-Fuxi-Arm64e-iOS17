+bool openBus(Session &s, unsigned hz) {
+    mark(s, 4);
+    s.spi.poll_limit = 400000;
+    s.spi.poll_only = 2;
+    if (s.spi.info.fifo_disabled && !prepareDma(s)) return false;
+    int r = geni_spi_init(&s.spi);
+    if (r) {fail(4, r); return false;}
