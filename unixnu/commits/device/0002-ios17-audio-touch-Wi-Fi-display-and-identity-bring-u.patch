+extern "C" {
+#include "ShengAdsp.h"
+#include "ShengGpr.h"
+#include "ShengAudioReach.h"
+#include "FuxiCs35l41.h"
+#include "GeniI2c.h"
+#include "TouchBoard.h"
+#include "SmmuBypass.h"
