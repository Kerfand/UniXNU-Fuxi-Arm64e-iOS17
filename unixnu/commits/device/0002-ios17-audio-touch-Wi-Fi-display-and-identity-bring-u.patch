+           'kits/sheng/BacklightProbe.cpp', 'kits/sheng/AppleARMBacklight.cpp', 'kits/sheng/GeniI2c.c', 'scripts/build-ios17-legacy-display.py']
+(OUT / 'build-report.json').write_text(json.dumps(dict(
