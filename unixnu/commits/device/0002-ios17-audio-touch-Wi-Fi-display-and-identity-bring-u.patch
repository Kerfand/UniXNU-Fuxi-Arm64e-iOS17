+  if (!name || !*name || !gHost.ready) return 0;
+  size_t nameLength = strlen (name);
+  if (nameLength > 36) return 0;
+  uint8_t *buffer = static_cast<uint8_t *> (IOMallocData (4096 * 5));   // the header block, then up to 128 entries
