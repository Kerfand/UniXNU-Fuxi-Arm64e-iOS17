+++ b/package/FuxiCpuFreqLog.cpp
@@ -0,0 +1,237 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// iOS 17 build: runs CpuFreqProbe.cpp's poll and writes its row to the console. The iPadOS build polls from its log rounds
+// (LegacyDisplayProbe.cpp); the iOS 17 probe has none, so without this the frequency domains were never voted and stayed at the boot
+// loader's level for the whole session (2026-11-12, UI at 10-23 frames per second under touch). The row reports each domain's
+// enable bit, current kHz/1000 (c), the level voted (v) and the state before the vote (pre): the before/after evidence of one boot.
+// Every 2 s for the first 90 s (the secondary clusters come up late and are voted the first time they read enabled), then every 60 s,
+// and only when the row changed.
+#include <IOKit/IOLib.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <string.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IODeviceMemory.h>
+
+extern "C" {
+extern char native_cpufreq_row[120];
+extern volatile uint32_t native_cpufreq_stage;
+void sheng_cpufreq_probe(void);
+void sheng_cpufreq_poll(void);
+// GpuPowerProbe.cpp's GPU governor (sheng-gpu-dcvs): [0] running, [1] level now, [2] changes, [3] failed votes, [4] busy % over the
+// last 10 s, [5..12] % of those 10 s at levels 1..8 (220 295 348 401 475 550 615 680 MHz), [13] touch boosts, [14] wake boosts.
+extern volatile uint32_t native_gpu_dcvs[15] __attribute__((weak_import));
+// GpuPowerProbe.cpp ringIdle: fence waits that slept until the GPU interrupt (or sheng-gpu-pause-us), that spun 20 us (no interrupt line,
+// interrupts off, preemption disabled), and sleeps that timed out. backboardd's CPU time sat in kern_SwapEnd (2026-11-12 samples):
+// spinning waits would count there.
+extern volatile uint64_t native_gpu_idle_sleeps __attribute__((weak_import));
+extern volatile uint64_t native_gpu_idle_spins __attribute__((weak_import));
+extern volatile uint64_t native_gpu_idle_timeouts __attribute__((weak_import));
+// NativeLegacyDisplay.cpp's swap event ring (always on, 65536 entries): [0] microseconds, [1] event << 56 | slot << 48 | validated << 40 |
+// fences << 24 | request tag. Events: 1 validated, 2 fence wait, 3 fence passed, 4 flipped, 5 latched, 6 retired, 7 offered to the GPU
+// copy, 8 blank.
+extern volatile uint64_t (*native_legacy_ring)[2] __attribute__((weak_import));
+extern volatile uint32_t native_legacy_ring_cap __attribute__((weak_import));
+extern volatile uint32_t native_legacy_ring_count __attribute__((weak_import));
+// CPU time per process (2026-11-12 probe: frames 40-50 ms apart with the GPU 5-23 % busy, its copy queue under 1.4 ms and the CPU
+// domains at their top; which tasks take the CPU?). Kernel-internal calls; this archive is linked into the kernel.
+typedef struct proc *proc_t;
+typedef struct task *task_t;
+int proc_iterate(unsigned int flags, int (*callout)(proc_t, void *), void *arg, int (*filterfn)(proc_t, void *), void *filterarg);
+int proc_pid(proc_t);
+void proc_name(int pid, char *buf, int size);
+task_t proc_task(proc_t);
+kern_return_t task_info(task_t, uint32_t flavor, int *info, uint32_t *count);
+}
+
+namespace {
+// The GPU row (2026-11-12 probe: the UI ran at 10-23 frames per second with the CPU domains at their top, and nothing logged where
+// the GPU clock was). Printed when it changed, at most every 10 s (its window).
+void gpuRow(char *last, size_t size) {
+    if (!&native_gpu_dcvs) return;
+    const volatile uint32_t *g = native_gpu_dcvs;
+    char row[160];
+    snprintf(row, sizeof row, "run%u level%u changes%u fail%u busy%u%% at %u/%u/%u/%u/%u/%u/%u/%u touch%u wake%u", g[0], g[1], g[2], g[3],
+             g[4], g[5], g[6], g[7], g[8], g[9], g[10], g[11], g[12], g[13], g[14]);
+    if (strncmp(last, row, size)) {
+        strlcpy(last, row, size);
+        IOLog("fuxi gpu dcvs: %s\n", row);
+    }
+    if (&native_gpu_idle_sleeps && &native_gpu_idle_spins && &native_gpu_idle_timeouts) {
+        static uint64_t s0, p0, t0;
+        const uint64_t s = native_gpu_idle_sleeps, p = native_gpu_idle_spins, t = native_gpu_idle_timeouts;
+        if (s != s0 || p != p0)
+            IOLog("fuxi gpu wait: sleeps %llu spins %llu (%llu us spun) timeouts %llu in the window\n", (unsigned long long)(s - s0),
+                  (unsigned long long)(p - p0), (unsigned long long)(p - p0) * 20, (unsigned long long)(t - t0));
+        s0 = s; p0 = p; t0 = t;
+    }
+}
+
+// Frame pacing since the last call, the measure of the sheng progress notes (frame intervals, not submit counts): frames validated,
+// intervals between consecutive validated swaps in buckets (<=9, <=17, <=34, <=50, <=100, >100 ms; gaps over 500 ms are idle and not
+// counted), their median, and how long a swap waited between validation and its GPU copy (queue behind the previous copy). Silent when
+// no frame came.
+void frameRow() {
+    if (!&native_legacy_ring || !native_legacy_ring || !native_legacy_ring_cap) return;
+    static uint32_t seen;
+    static uint64_t lastValidated;
+    const uint32_t cap = native_legacy_ring_cap, end = native_legacy_ring_count;
+    uint32_t from = seen;
+    if (end - from > cap) from = end - cap;
+    seen = end;
+    unsigned frames = 0, bucket[6] = {}, waits = 0;
+    uint64_t waitSum = 0, waitMax = 0;
+    static uint16_t gaps[4096];
+    unsigned ngaps = 0;
+    // validation time per request tag, for the queue wait (a small table, newest wins)
+    static uint64_t tagAt[64]; static uint32_t tagOf[64];
+    for (uint32_t i = from; i != end; ++i) {
+        const volatile uint64_t *e = native_legacy_ring[i & (cap - 1)];
+        const uint64_t us = e[0], word = e[1];
+        const unsigned ev = unsigned(word >> 56);
+        const uint32_t tag = uint32_t(word & 0xffffff);
+        if (ev == 1) {
+            ++frames;
+            if (lastValidated && us > lastValidated) {
+                const uint64_t gap = us - lastValidated;
+                if (gap <= 500000) {
+                    const uint64_t ms = gap / 1000;
+                    bucket[ms <= 9 ? 0 : ms <= 17 ? 1 : ms <= 34 ? 2 : ms <= 50 ? 3 : ms <= 100 ? 4 : 5]++;
+                    if (ngaps < 4096) gaps[ngaps++] = uint16_t(gap / 10 > 65535 ? 65535 : gap / 10);   // 10 us units
+                }
+            }
+            lastValidated = us;
+            tagAt[tag & 63] = us; tagOf[tag & 63] = tag;
+        } else if (ev == 7 && tagOf[tag & 63] == tag && tagAt[tag & 63] && us >= tagAt[tag & 63]) {
+            const uint64_t w = us - tagAt[tag & 63];
+            waitSum += w; if (w > waitMax) waitMax = w; ++waits;
+            tagAt[tag & 63] = 0;
+        }
+    }
+    if (!frames) return;
+    unsigned median = 0;
+    if (ngaps) {   // partial selection: count below each 1 ms step
+        for (unsigned ms = 1; ms <= 650; ++ms) {
+            unsigned below = 0;
+            for (unsigned k = 0; k < ngaps; ++k) if (gaps[k] < ms * 100) ++below;
+            if (below * 2 >= ngaps) {median = ms; break;}
+        }
+    }
+    IOLog("fuxi frames: %u frames, gaps <=9:%u <=17:%u <=34:%u <=50:%u <=100:%u >100:%u ms, median %u ms, copy wait avg %llu max %llu us\n",
+          frames, bucket[0], bucket[1], bucket[2], bucket[3], bucket[4], bucket[5], median,
+          waits ? (unsigned long long)(waitSum / waits) : 0ull, (unsigned long long)waitMax);
+}
+
+// TASK_POWER_INFO (flavor 21): total_user, total_system (mach time, terminated threads included), task_interrupt_wakeups, ...
+struct PowerInfo {uint64_t totalUser, totalSystem, interruptWakeups, platformIdleWakeups, timerWakeupsBin1, timerWakeupsBin2;};
+struct CpuSlot {int pid; uint64_t last; uint64_t delta;};
+CpuSlot gCpu[640];
+int cpuCallout(proc_t p, void *) {
+    const int pid = proc_pid(p);
+    task_t t = proc_task(p);
+    if (!t) return 0;   // PROC_RETURNED
+    PowerInfo info = {};
+    uint32_t count = sizeof info / sizeof(int);
+    if (task_info(t, 21, reinterpret_cast<int *>(&info), &count) != KERN_SUCCESS) return 0;
+    const uint64_t now = info.totalUser + info.totalSystem;
+    CpuSlot *free = nullptr;
+    for (CpuSlot &s : gCpu) {
+        if (s.pid == pid && s.last) {s.delta = now >= s.last ? now - s.last : 0; s.last = now; return 0;}
+        if (!free && !s.last) free = &s;
+    }
+    if (free) {free->pid = pid; free->last = now; free->delta = 0;}
+    return 0;
+}
+// The heaviest tasks of the last window, in percent of one CPU (the window is the time since the previous call).
+void cpuRow() {
+    static uint64_t lastT;
+    const uint64_t t = mach_absolute_time();
+    for (CpuSlot &s : gCpu) s.delta = 0;
+    proc_iterate(1 /* PROC_ALLPROCLIST */, cpuCallout, nullptr, nullptr, nullptr);
+    if (!lastT) {lastT = t; return;}
+    const uint64_t window = t - lastT;
+    lastT = t;
+    char row[200]; size_t n = 0;
+    n += snprintf(row + n, sizeof row - n, "fuxi cpu top:");
+    uint64_t total = 0;
+    for (CpuSlot &s : gCpu) total += s.delta;
+    for (unsigned k = 0; k < 7; ++k) {
+        CpuSlot *best = nullptr;
+        for (CpuSlot &s : gCpu) if (s.delta && (!best || s.delta > best->delta)) best = &s;
+        if (!best) break;
+        char name[20] = {};
+        proc_name(best->pid, name, sizeof name);
+        if (n < sizeof row) n += snprintf(row + n, sizeof row - n, " %s[%d] %llu%%", name, best->pid,
+                                          (unsigned long long)(best->delta * 100 / window));
+        best->delta = 0;
+    }
+    if (n < sizeof row) snprintf(row + n, sizeof row - n, " all %llu%%", (unsigned long long)(total * 100 / window));
+    IOLog("%s\n", row);
+}
+
+// fuxi probe (2026-11-13, black screen after the power button): what the panel is shown. The DPU's VIG 0 / VIG 1 source address
+// (+0x14) and stride (+0x24) in the MDP block (0xae01000, as NativeLegacyDisplay flips them), and 16 x 16 samples of the memory VIG 0
+// scans (identity-mapped, as the boot memory 0xb8000000 is): how many are not black and a checksum, so a frozen or black picture shows
+// as a constant row.
+extern "C" {extern volatile uint32_t native_legacy_gpu_fallbacks; extern volatile int32_t native_legacy_gpu_last_status;
+            extern volatile uint64_t native_legacy_early_retires, native_legacy_early_failures, native_gop_gpu_offers;}
+void fbRow() {
+    static IOMemoryMap *mdpMap, *fbMap;
+    static uint64_t fbPa, fbBytes;
+    if (!mdpMap) {
+        IODeviceMemory *m = IODeviceMemory::withRange(0xae01000, 0x8f000);
+        mdpMap = m ? m->map(kIOMapAnywhere | kIOMapInhibitCache) : nullptr;
+        if (m) m->release();
+        if (!mdpMap) return;
+    }
+    const volatile uint32_t *mdp = reinterpret_cast<const volatile uint32_t *>(mdpMap->getVirtualAddress());
+    const uint32_t a0 = mdp[(0x4000 + 0x14) / 4], s0 = mdp[(0x4000 + 0x24) / 4] & 0xffff;
+    const uint32_t a1 = mdp[(0x6000 + 0x14) / 4], s1 = mdp[(0x6000 + 0x24) / 4] & 0xffff;
+    const uint32_t width = 1080, height = 2400;
+    unsigned lit = 0; uint32_t sum = 0;
+    const uint64_t bytes = (uint64_t)s0 * height;
+    if (a0 && s0 >= width * 4 && (fbPa != a0 || fbBytes != bytes)) {
+        if (fbMap) {fbMap->release(); fbMap = nullptr;}
+        IODeviceMemory *m = IODeviceMemory::withRange(a0, bytes);
+        fbMap = m ? m->map(kIOMapAnywhere | kIOMapInhibitCache) : nullptr;
+        if (m) m->release();
+        fbPa = fbMap ? a0 : 0; fbBytes = fbMap ? bytes : 0;
+    }
+    if (fbMap) {
+        const volatile uint8_t *fb = reinterpret_cast<const volatile uint8_t *>(fbMap->getVirtualAddress());
+        for (unsigned y = 0; y < 16; ++y)
+            for (unsigned x = 0; x < 16; ++x) {
+                const uint64_t row = (uint64_t)(y * 2 + 1) * height / 32, col = (uint64_t)(x * 2 + 1) * width / 32;
+                const uint32_t px = *reinterpret_cast<const volatile uint32_t *>(fb + row * s0 + col * 4);
+                if (px & 0x00ffffffu) ++lit;
+                sum = (sum << 5 | sum >> 27) ^ px;
+            }
+    }
+    IOLog("fuxi fb: vig0 %#x/%u vig1 %#x/%u lit %u/256 sum %08x gpu offers %llu retires %llu early-fail %llu fallbacks %u last %#x\n", a0, s0, a1, s1,
+          lit, sum, (unsigned long long)native_gop_gpu_offers, (unsigned long long)native_legacy_early_retires,
+          (unsigned long long)native_legacy_early_failures, native_legacy_gpu_fallbacks, (unsigned)native_legacy_gpu_last_status);
+}
+
+void logThread(void *, wait_result_t) {
+    char last[120] = {}, lastGpu[160] = {};
+    for (unsigned round = 0;; ++round) {
+        sheng_cpufreq_poll();
+        if (strncmp(last, native_cpufreq_row, sizeof last)) {
+            strlcpy(last, native_cpufreq_row, sizeof last);
+            IOLog("fuxi cpufreq: %s\n", last);
+        }
+        if (round >= 45 || round % 5 == 4) {gpuRow(lastGpu, sizeof lastGpu); frameRow(); cpuRow(); fbRow();}
+        IOSleep(round < 45 ? 2000 : 10000);
+    }
+}
+}
+
+extern "C" void fuxi_cpufreq_start(void) {
+    static bool started;
+    unsigned mode = 0;
+    if (started || !PE_parse_boot_argn("sheng-cpufreq", &mode, sizeof mode) || !mode) return;
+    started = true;
+    sheng_cpufreq_probe();
+    if (!native_cpufreq_stage) {IOLog("fuxi cpufreq: probe did not start\n"); return;}
+    thread_t t = nullptr;
+    if (kernel_thread_start(logThread, nullptr, &t) == KERN_SUCCESS) thread_deallocate(t);
+}
diff --git a/package/FuxiCs35l41.c b/package/FuxiCs35l41.c
new file mode 100755
index 0000000..0a461a9
--- /dev/null
+++ b/package/FuxiCs35l41.c
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* fuxi's CS35L41 programs (FuxiCs35l41.h). The runner is ShengCs35l43.c's. */
+#include "FuxiCs35l41.h"
+
+typedef struct {Cs35Step *p; unsigned n;} P;
+static void w(P *p, uint32_t reg, uint32_t value) {if (p->n < CS35_MAX_STEPS) p->p[p->n++] = (Cs35Step){Cs35Write, reg, 0, value};}
+static void u(P *p, uint32_t reg, uint32_t mask, uint32_t value) {if (p->n < CS35_MAX_STEPS) p->p[p->n++] = (Cs35Step){Cs35Update, reg, mask, value & mask};}
+static void r(P *p, uint32_t reg) {if (p->n < CS35_MAX_STEPS) p->p[p->n++] = (Cs35Step){Cs35Read, reg, 0, 0};}
+static void d(P *p, uint32_t ms) {if (p->n < CS35_MAX_STEPS) p->p[p->n++] = (Cs35Step){Cs35DelayMs, 0, 0, ms};}
+static void unlock(P *p) {w(p, CS35_TEST_KEY, 0x55u); w(p, CS35_TEST_KEY, 0xaau);}
+static void lock(P *p) {w(p, CS35_TEST_KEY, 0xccu); w(p, CS35_TEST_KEY, 0x33u);}
+
+unsigned cs35_init_program(Cs35Step *out, unsigned slot)
+{
+    P p = {out, 0};
+    /* cs35l41_reset_and_boot: software reset, then OTP boot (up to 100 ms; IRQ1_STATUS4 OTP_BOOT_DONE, IRQ1_STATUS3 OTP_BOOT_ERR). The
+     * runner cannot poll: one 20 ms wait, and the two status words are read for the log. */
+    w(&p, CS35_SFT_RESET, 0x5A000000u);
+    d(&p, 20);
+    r(&p, CS35_DEVID);
+    r(&p, CS35_REVID);
+    r(&p, CS35_IRQ1_STATUS4);
+    r(&p, CS35_IRQ1_STATUS3);
+    /* cs35l41_revb0/revb2_errata_patch (the two are the same), then the DSP core held off */
+    unlock(&p);
+    w(&p, CS35_VIMON_SPKMON_RESYNC, 0);
+    w(&p, 0x00004310u, 0);
+    w(&p, CS35_VPVBST_FS_SEL, 0);
+    w(&p, CS35_BSTCVRT_DCM_CTRL, 0x00000051u);
+    w(&p, CS35_DSP1_YM_ACCEL_PL0_PRI, 0);
+    w(&p, CS35_DSP1_XM_ACCEL_PL0_PRI, 0);
+    w(&p, CS35_PWR_CTRL2, 0);
+    w(&p, CS35_AMP_GAIN_CTRL, 0);
+    w(&p, CS35_ASP_TX3_SRC, 0);
+    w(&p, CS35_ASP_TX4_SRC, 0);
+    w(&p, CS35_DSP1_CCM_CORE_CTRL, 0);
+    lock(&p);
+    /* Interrupts stay masked: the owner reads the status registers. */
+    w(&p, CS35_IRQ1_MASK1, 0xffffffffu);
+    w(&p, CS35_IRQ1_MASK2, 0xffffffffu);
+    w(&p, CS35_IRQ1_MASK3, 0xffffffffu);
+    w(&p, CS35_IRQ1_MASK4, 0xffffffffu);
+    /* cs35l41_boost_config(1000 nH, 15 uF, 4000 mA): K1 0x24, K2 0x24, slope 0x75, LBST 0, IPK 0x40; boost enabled (BST_EN 2) */
+    u(&p, CS35_BSTCVRT_COEFF, 0xffffu, 0x24u << 8 | 0x24u);
+    u(&p, CS35_BSTCVRT_SLOPE_LBST, 0xff03u, 0x75u << 8);
+    u(&p, CS35_BSTCVRT_PEAK_CUR, 0x7fu, (4000u - 1600u) / 50u + 0x10u);
+    u(&p, CS35_PWR_CTRL2, 0x30u, 2u << 4);
+    /* Board values: SDOUT high impedance (cirrus,asp-sdout-hiz 3), GPIO2 output with source 4 (cirrus,gpio-config2) */
+    u(&p, CS35_SP_HIZ_CTRL, 0x3u, 0x3u);
+    u(&p, CS35_GPIO_PAD_CONTROL, 0x07000000u, 4u << 24);
+    /* set_dai_fmt (I2S, clock and frame from the SoC), hw_params (16-bit, 48 kHz) */
+    u(&p, CS35_SP_FORMAT, 0xff000000u | 0x0755u, 16u << 24 | 2u << 8);
+    u(&p, CS35_SP_RX_WL, 0x3fu, 16u);
+    u(&p, CS35_GLOBAL_CLK_CTRL, 0x1fu, 0x03u);
+    /* set_sysclk: the PLL locks to the 1.536 MHz SCLK (reference 0, frequency code 0x1B); FS monitor 52 / 84 */
+    u(&p, CS35_PLL_CLK_CTRL, 0x800u, 0x800u);
+    u(&p, CS35_PLL_CLK_CTRL, 0x7e0u, 0x1bu << 5);
+    u(&p, CS35_PLL_CLK_CTRL, 0x10u, 0);
+    u(&p, CS35_PLL_CLK_CTRL, 0x7u, 0);
+    u(&p, CS35_PLL_CLK_CTRL, 0x800u, 0);
+    u(&p, CS35_PLL_CLK_CTRL, 0x10u, 0x10u);
+    w(&p, CS35_TST_FS_MON0, 52u | (84u << 12));
+    /* PCM source ASPRX1, this amplifier's slot, analog gain, digital volume 0 dB */
+    u(&p, CS35_DAC_PCM1_SRC, 0x7fu, 0x08u);
+    u(&p, CS35_SP_FRAME_RX_SLOT, 0x3fu, slot);
+    u(&p, CS35_AMP_GAIN_CTRL, 0x3e0u, CS35_GAIN_INDEX << 5);
+    u(&p, CS35_AMP_DIG_VOL_CTRL, 0x7ffu << 3, 0);
+    return p.n;
+}
+
+/* cs35l41_main_amp_event PRE_PMU (pup patch, global enable for internal boost: GLOBAL_EN, PUP_DONE within 100 ms, acknowledge), then the
+ * Main AMP bit (PWR_CTRL2 bit 0); ASP RX1 (SP_ENABLES bit 16) first, as DAPM powers the AIF before the output. */
+unsigned cs35_power_up_program(Cs35Step *out)
+{
+    P p = {out, 0};
+    u(&p, CS35_SP_ENABLES, 1u << 16, 1u << 16);
+    unlock(&p);
+    w(&p, 0x00002084u, 0x002F1AA0u);
+    lock(&p);
+    u(&p, CS35_PWR_CTRL1, 1u, 1u);
+    d(&p, 5);
+    r(&p, CS35_IRQ1_STATUS1);
+    w(&p, CS35_IRQ1_STATUS1, CS35_PUP_DONE);
+    u(&p, CS35_PWR_CTRL2, 1u, 1u);
+    return p.n;
+}
+
+unsigned cs35_power_down_program(Cs35Step *out)
+{
+    P p = {out, 0};
+    u(&p, CS35_PWR_CTRL2, 1u, 0);
+    u(&p, CS35_PWR_CTRL1, 1u, 0);
+    d(&p, 5);
+    r(&p, CS35_IRQ1_STATUS1);
+    w(&p, CS35_IRQ1_STATUS1, CS35_PDN_DONE);
+    unlock(&p);
+    w(&p, 0x00002084u, 0x002F1AA3u);
+    lock(&p);
+    u(&p, CS35_SP_ENABLES, 1u << 16, 0);
+    return p.n;
+}
+
+unsigned cs35_status_program(Cs35Step *out)
+{
+    P p = {out, 0};
+    r(&p, CS35_IRQ1_STATUS1);
+    r(&p, CS35_IRQ1_STATUS3);
+    w(&p, CS35_IRQ1_STATUS1, 0xffffffffu);
+    w(&p, CS35_IRQ1_STATUS3, 0xffffffffu);
+    return p.n;
+}
+
+void cs35_run_start(Cs35Run *r, const Cs35Step *steps, unsigned count)
+{
+    r->steps = steps; r->count = count; r->index = 0; r->phase = 0; r->read_count = 0; r->pending = 0;
+    for (unsigned i = 0; i < 4; ++i) r->reads[i] = 0;
+}
+
+static void be32(uint8_t *b, uint32_t v) {b[0] = (uint8_t)(v >> 24); b[1] = (uint8_t)(v >> 16); b[2] = (uint8_t)(v >> 8); b[3] = (uint8_t)v;}
+
+int cs35_run_next(Cs35Run *r, Cs35Action *a)
+{
+    a->length = a->read_length = a->delay_ms = 0;
+    if (r->index >= r->count) return Cs35Finished;
+    const Cs35Step *s = &r->steps[r->index];
+    if (r->phase == 4) {
+        be32(a->bytes, s->reg); be32(a->bytes + 4, r->pending); a->length = 8;
+        r->phase = 2;
+        return Cs35Transfer;
+    }
+    switch (s->op) {
+    case Cs35DelayMs:
+        a->delay_ms = s->value;
+        r->index++;
+        return Cs35Wait;
+    case Cs35Write:
+        be32(a->bytes, s->reg); be32(a->bytes + 4, s->value); a->length = 8;
+        r->phase = 2;
+        return Cs35Transfer;
+    case Cs35Update:
+    case Cs35Read:
+        be32(a->bytes, s->reg); a->length = 4; a->read_length = 4;
+        r->phase = s->op == Cs35Update ? 1 : 3;
+        return Cs35Transfer;
+    default:
+        r->index = r->count;
+        return Cs35Finished;
+    }
+}
+
+void cs35_run_result(Cs35Run *r, uint32_t value)
+{
+    if (r->index >= r->count) return;
+    const Cs35Step *s = &r->steps[r->index];
+    if (r->phase == 1) {
+        r->pending = (value & ~s->mask) | s->value;
+        if (r->pending == value) {r->phase = 0; r->index++;} else r->phase = 4;
+        return;
+    }
+    if (r->phase == 3 && r->read_count < 4) r->reads[r->read_count++] = value;
+    r->phase = 0;
+    r->index++;
+}
diff --git a/package/FuxiCs35l41.h b/package/FuxiCs35l41.h
new file mode 100755
index 0000000..de290a7
--- /dev/null
+++ b/package/FuxiCs35l41.h
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The two CS35L41 speaker amplifiers of the fuxi board (Xiaomi 13), 2026-11-13. Stock devicetree: both on QUP2 SE0 (i2c@880000), "B"
+ * (bottom) at 0x40 with cirrus,right-channel-amp, reset gpio183, interrupt tlmm 99; "T" (top/receiver) at 0x42, reset gpio182,
+ * interrupt tlmm 98; boost 1000 nH, 15 uF, 4000 mA peak; ASP SDOUT high impedance (3); GPIO2 output, source 4. Both take 16-bit stereo
+ * I2S from the secondary MI2S (gpio121-124) as clock slaves and play their slot straight from the serial port (DAC_PCM1_SRC = ASPRX1,
+ * the amplifier DSP bypassed, no firmware): T slot 0 (left), B slot 1 (right).
+ * Registers, fields and sequences: Linux include/sound/cs35l41.h, sound/soc/codecs/cs35l41-lib.c and cs35l41.c (the boot wait, the
+ * rev B0/B2 errata, boost_config, set_dai_fmt, pcm_hw_params, set_sysclk with SCLK as PLL reference, the pup/pdn patches and
+ * global_enable for internal boost). Not done: OTP trim unpack (cs35l41_otp_unpack) and the DSP set-up (cs35l41_dsp_init).
+ * The interface is ShengCs35l43.h's (same names), so AudioProbe.cpp runs these programs with its runner unchanged.
+ * Registers and values are 32-bit big-endian on the wire. */
+#ifndef FUXI_CS35L41_H
+#define FUXI_CS35L41_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define CS35_DEVID 0x00000000u
+#define CS35_REVID 0x00000004u
+#define CS35_OTPID 0x00000010u
+#define CS35_SFT_RESET 0x00000020u
+#define CS35_TEST_KEY 0x00000040u
+#define CS35_PWR_CTRL1 0x00002014u
+#define CS35_PWR_CTRL2 0x00002018u
+#define CS35_PWR_CTRL3 0x0000201Cu
+#define CS35_PROTECT_REL_ERR_IGN 0x00002034u
+#define CS35_GPIO_PAD_CONTROL 0x0000242Cu
+#define CS35_PWRMGT_STS 0x00002908u
+#define CS35_PLL_CLK_CTRL 0x00002C04u
+#define CS35_GLOBAL_CLK_CTRL 0x00002C0Cu
+#define CS35_TST_FS_MON0 0x00002D10u
+#define CS35_BSTCVRT_PEAK_CUR 0x00003808u
+#define CS35_BSTCVRT_COEFF 0x00003810u
+#define CS35_BSTCVRT_SLOPE_LBST 0x00003814u
+#define CS35_BSTCVRT_DCM_CTRL 0x0000381Cu
+#define CS35_VIMON_SPKMON_RESYNC 0x00004100u
+#define CS35_VPVBST_FS_SEL 0x00004400u
+#define CS35_SP_ENABLES 0x00004800u
+#define CS35_SP_FORMAT 0x00004808u
+#define CS35_SP_HIZ_CTRL 0x0000480Cu
+#define CS35_SP_FRAME_RX_SLOT 0x00004820u
+#define CS35_SP_RX_WL 0x00004840u
+#define CS35_DAC_PCM1_SRC 0x00004C00u
+#define CS35_ASP_TX3_SRC 0x00004C28u
+#define CS35_ASP_TX4_SRC 0x00004C2Cu
+#define CS35_AMP_DIG_VOL_CTRL 0x00006000u
+#define CS35_AMP_GAIN_CTRL 0x00006C04u
+#define CS35_IRQ1_STATUS1 0x00010010u
+#define CS35_IRQ1_STATUS3 0x00010018u
+#define CS35_IRQ1_STATUS4 0x0001001Cu
+#define CS35_IRQ1_MASK1 0x00010110u
+#define CS35_IRQ1_MASK2 0x00010114u
+#define CS35_IRQ1_MASK3 0x00010118u
+#define CS35_IRQ1_MASK4 0x0001011Cu
+#define CS35_DSP1_CCM_CORE_CTRL 0x02BC1000u
+#define CS35_DSP1_XM_ACCEL_PL0_PRI 0x02BC2020u
+#define CS35_DSP1_YM_ACCEL_PL0_PRI 0x02BC20E0u
+
+#define CS35_CHIP_ID 0x00035A40u
+#define CS35_OTP_BOOT_DONE 0x00000002u   /* IRQ1_STATUS4 */
+#define CS35_OTP_BOOT_ERR 0x80000000u    /* IRQ1_STATUS3 */
+#define CS35_PUP_DONE 0x01000000u        /* IRQ1_STATUS1 */
+#define CS35_PDN_DONE 0x00800000u        /* IRQ1_STATUS1 */
+/* The status program reads IRQ1_STATUS1 (reads[0]) then IRQ1_STATUS3 (reads[1]); AudioProbe tests these names. */
+#define CS35_EINT2_PLL_LOCK 0x00000002u  /* IRQ1_STATUS3 bit 1 */
+#define CS35_EINT1_ERRORS 0x800281C0u    /* AMP_SHORT, TEMP_ERR, TEMP_WARN, BST_SHORT, BST_DCM_UVP, BST_OVP */
+
+#define CS35_AMPS 2
+/* "Analog PCM Volume" index (0.5 dB + 1 dB per step, at most 20): 17 = 17.5 dB, near sheng's 18 dB */
+#define CS35_GAIN_INDEX 17u
+/* The I2C address of amplifier n (0 = T at 0x42, slot 0; 1 = B at 0x40, slot 1) */
+static inline uint8_t cs35_address(unsigned amp) {return amp == 0 ? 0x42u : 0x40u;}
+static inline unsigned cs35_slot(unsigned amp) {return amp == 0 ? 0u : 1u;}
+
+enum {Cs35Write = 1, Cs35Update = 2, Cs35Read = 3, Cs35DelayMs = 4};
+typedef struct {uint8_t op; uint32_t reg, mask, value;} Cs35Step;
+
+/* Programs (each returns its step count, at most CS35_MAX_STEPS):
+ * init: after the reset line was released - boot wait, identity (reads: DEVID, REVID, IRQ1_STATUS4, IRQ1_STATUS3), errata, interrupt
+ *       masks, boost, serial port, PLL, routing and gain for the slot; leaves the amplifier powered down.
+ * power up / power down: ASP RX1, the pup/pdn patch, global enable (reads: IRQ1_STATUS1), the amplifier enable.
+ * status: IRQ1_STATUS1 and IRQ1_STATUS3, then acknowledges both. */
+#define CS35_MAX_STEPS 48
+unsigned cs35_init_program(Cs35Step *out, unsigned slot);
+unsigned cs35_power_up_program(Cs35Step *out);
+unsigned cs35_power_down_program(Cs35Step *out);
+unsigned cs35_status_program(Cs35Step *out);
+
+typedef struct {
+    const Cs35Step *steps;
+    unsigned count, index;
+    uint8_t phase;
+    uint32_t pending;
+    uint32_t reads[4];
+    unsigned read_count;
+} Cs35Run;
+enum {Cs35Transfer = 1, Cs35Wait = 2, Cs35Finished = 3};
+typedef struct {
+    uint8_t bytes[8];
+    uint32_t length;
+    uint32_t read_length;
+    uint32_t delay_ms;
+} Cs35Action;
+void cs35_run_start(Cs35Run *r, const Cs35Step *steps, unsigned count);
+int cs35_run_next(Cs35Run *r, Cs35Action *a);
+void cs35_run_result(Cs35Run *r, uint32_t value);
+static inline uint32_t cs35_wire_value(uint32_t rx) {return (rx >> 24) | ((rx >> 8) & 0xff00u) | ((rx << 8) & 0xff0000u) | (rx << 24);}
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/package/FuxiHidProbe.cpp b/package/FuxiHidProbe.cpp
new file mode 100644
index 0000000..a50bc2c
--- /dev/null
+++ b/package/FuxiHidProbe.cpp
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// FTS producer -> existing qualified iPadOS17 combined digitizer; one metaclass owner.
+#include <libkern/libkern.h>
+#include <stdint.h>
+#include <stddef.h>
+extern "C" {
+extern void native_hid_input_probe(void);
+extern volatile uint32_t native_hid_stage,native_hid_resource_found,native_hid_input_events[8];
+extern volatile uint32_t native_hid_class_sizes[5],native_hid_usrsvc[8];
+extern char native_hid_chain[320];
+extern volatile int native_hid_load_status,native_hid_matching_load_status,native_hid_input_meta_status,native_hid_input_results[8];
+volatile int native_fuxi_touch_enabled;
+volatile int native_fuxi_touch_pad=0;
+void fuxi_hid_start(void) {
+    native_fuxi_touch_enabled=1;
+    native_hid_input_probe();
+}
+bool fuxi_hid_settled(void) {
+    return native_hid_stage==3 || native_hid_input_events[2]!=0;
+}
+const char *fuxi_hid_row(char *out,size_t size) {
+    // moduleInitStatus is OSMetaClass::postModLoad()'s return: 0 means registration SUCCEEDED.
+    // It is not a class lookup, so it cannot be read as "IOHIDEventService missing".
+    snprintf(out,size,"\nFTS HID st%u fam%x evd%x res%u moduleInitStatus%x up%u/%x rep%u/%x fail%u/%x",
+        native_hid_stage,(unsigned)native_hid_load_status,(unsigned)native_hid_matching_load_status,
+        native_hid_resource_found,(unsigned)native_hid_input_meta_status,
+        native_hid_input_events[2],(unsigned)native_hid_input_results[2],
+        native_hid_input_events[6],(unsigned)native_hid_input_results[6],
+        native_hid_input_events[7],(unsigned)native_hid_input_results[7]);
+    size_t used=strlen(out);
+    snprintf(out+used,size-used,"\nFTS HID classes UserDevice=%u EventDriver=%u EventService=%u ResourceClient=%u Device=%u",
+        native_hid_class_sizes[0],native_hid_class_sizes[1],native_hid_class_sizes[2],
+        native_hid_class_sizes[3],native_hid_class_sizes[4]);
+    used=strlen(out);
+    snprintf(out+used,size-used,"\nFTS HID procs driverkitd=%u AppleUserHID=%u HIDDrivers=%u total=%u chainLen=%u",
+        native_hid_usrsvc[0],native_hid_usrsvc[1],native_hid_usrsvc[2],native_hid_usrsvc[3],native_hid_usrsvc[4]);
+    used=strlen(out);
+    snprintf(out+used,size-used,"\nFTS HID chain %s",native_hid_chain);
+    return out;
+}
+}
diff --git a/package/FuxiTouchBoard.h b/package/FuxiTouchBoard.h
new file mode 100755
index 0000000..7199f44
--- /dev/null
+++ b/package/FuxiTouchBoard.h
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// fuxi（小米 13，SM8550）触控控制器的板级事实。每个常量都注明来源。
+// 写法参照 UniXNU-sheng 的 package/TouchBoard.h，但内容是 fuxi 的实测/DT 数据，代码为本工程新写。
+// 本文件不访问硬件，只给出常量和纯函数。
+//
+// 来源缩写：
+//   DT    = 官方 OS3.0.309 vendor_boot DTB[2]（Kalama v2）+ dtbo[4]（8550 fuxi）经 fdtoverlay 合并后的设备树
+//           （见 ../dtb/fuxi_merged.dts，路径 /soc/qcom,qupv3_1_geni_se@ac0000/spi@a90000/fts@0）
+//   KAL   = LineageOS android_kernel_xiaomi_sm8550 drivers/pinctrl/qcom/pinctrl-kalama.c（REG_BASE 0x100000）
+//   SHENG = UniXNU-sheng package/TouchBoard.h（同 SoC 的已验证值）
+//   DEV   = 本机运行时实测（../../device_dump：spi0.0 绑定 fts、input "fts" 坐标 0..10799 x 0..23999）
+#ifndef FUXI_TOUCH_BOARD_H
+#define FUXI_TOUCH_BOARD_H
+#include <stdint.h>
+
+// ---- QUP / 串行引擎 ----
+#define FTB_QUP_WRAPPER_BASE 0x00ac0000ULL   // DT: qcom,qupv3_1_geni_se@ac0000 reg <0xac0000 0x2000>；与 SHENG 相同
+#define FTB_SE_BASE 0x00a90000ULL            // DT: spi@a90000 reg <0xa90000 0x4000>；与 SHENG 相同
+#define FTB_SE_SIZE 0x4000ULL
+#define FTB_QUP_SMMU_SID 0xa3                // DT: wrapper iommus = <&apps_smmu 0xa3 0>；与 SHENG 相同
+#define FTB_SE_GIC_SPI 357                   // DT: spi@a90000 interrupts = <GIC_SPI 0x165 IRQ_TYPE_LEVEL_HIGH>
+// 时钟：DT clocks = <&gcc 0x65>（se-clk），即 gcc_qupv3_wrap1_s4_clk；投票位、halt 寄存器与 SHENG 的 TB_VOTE_* 相同（同一 SE）
+
+// ---- SPI 参数 ----
+#define FTB_SPI_MODE 0                        // DT: fts@0 无 spi-cpol/spi-cpha
+#define FTB_SPI_HZ 12000000u                  // DT: fts@0 spi-max-frequency = <12000000>（SHENG 的 Novatek 是 19.2 MHz）
+#define FTB_SPI_CS_DELAY_US 10                // 驱动 ftsHardware.h SPI_DELAY_CS：拉高 CS 前等待 10 µs
+#define FTB_SPI_4WIRE 1                       // 驱动 ftsHardware.h SPI4_WIRE
+
+// ---- TLMM（GPIO n 的控制寄存器 = 0x0F100000 + 0x1000*n）----
+#define FTB_TLMM_GPIO_BASE 0x0f100000ULL      // KAL: DT 节点基址 0xf000000 + REG_BASE 0x100000；与 SHENG 的 TB_TLMM_BASE 相同
+#define FTB_GPIO_STRIDE 0x1000
+#define FTB_GPIO_SPI_MISO 44                  // DT: qupv3_se4_spi_miso_active gpio44, function qup1_se4_l0, 6 mA, pull-down
+#define FTB_GPIO_SPI_MOSI 45                  // DT: gpio45, qup1_se4_l1, 6 mA, pull-down
+#define FTB_GPIO_SPI_CLK 46                   // DT: gpio46, qup1_se4_l2, 6 mA, pull-down
+#define FTB_GPIO_SPI_CS 47                    // DT: mi_ts_cs_active gpio47, qup1_se4_l3, 6 mA, **pull-up**
+#define FTB_GPIO_IRQ 25                       // DT: fts,irq-gpio = <&tlmm 25 0x2008>，低电平触发；mi_ts_active: gpio, 8 mA, pull-up
+#define FTB_GPIO_RESET 24                     // DT: fts,reset-gpio = <&tlmm 24 0>，输出；mi_ts_active: gpio, 8 mA, pull-up
+#define FTB_TLMM_SUMMARY_GIC_SPI 208          // DT: pinctrl@f000000 interrupts = <GIC_SPI 0xd0 LEVEL_HIGH>（TLMM 汇总中断，SHENG 用 32+208）
+#define FTB_GPIO_IRQ_PDC_PIN 57               // Linux pinctrl-sm8550.c sm8550_pdc_map {25, 57}
+#define FTB_GPIO_IRQ_PDC_GIC_SPI 537          // DT qcom,pdc-ranges 换算：PDC pin 57 -> GIC SPI 537（走 PDC 唤醒路径时用）
+#define FTB_TLMM_INTR_STATUS_OFF 0xc          // KAL: intr_status_reg = REG_BASE + 0xc + 0x1000*n，bit0 = 中断挂起
+
+static inline uint64_t ftb_tlmm_ctl(unsigned gpio) {return FTB_TLMM_GPIO_BASE + (uint64_t)gpio * FTB_GPIO_STRIDE;}
+static inline uint64_t ftb_tlmm_io(unsigned gpio) {return ftb_tlmm_ctl(gpio) + 4;}
+static inline uint64_t ftb_tlmm_intr_status(unsigned gpio) {return ftb_tlmm_ctl(gpio) + FTB_TLMM_INTR_STATUS_OFF;}
+
+// ---- 电源（RPMh 管理）----
+// 安卓实测（root，2026-10-31，../power/）：两路都**只有触控一个消费者**（spi0.0-vdd / spi0.0-avdd），
+// 驱动加载后常开，息屏（Dozing）也不关；DT 里没有 regulator-boot-on / always-on。
+// 结论：内核默认它们开机时是关的，只有触控驱动会打开 → XNU 接管时按“关着”处理，先投票再访问芯片
+// （重复投票无害）。SHENG 的 TouchProbe 不操作电源，fuxi 需要补这一步。
+#define FTB_VDD_RPMH_RESOURCE "ldob12"        // DT: vdd-supply -> rpmh-regulator-ldob12 / regulator-pm-humu-l12（PM8550 LDO12，pmic5_nldo515）
+#define FTB_VDD_RPMH_ADDR 0x40900u            // 实测 /sys/kernel/debug/cmd-db：0x40900: ldob12
+#define FTB_VDD_MV 1800u                      // DT: min = max = init = 1.8 V；实测 1800 mV，模式 fast(HPM)
+#define FTB_AVDD_RPMH_RESOURCE "ldom6"        // DT: avdd-supply -> rpmh-regulator-ldom6 / regulator-pm8010m-l6（PM8010 LDO6，pmic5_pldo502ln）
+#define FTB_AVDD_RPMH_ADDR 0x41b00u           // 实测 cmd-db：0x41b00: ldom6
+#define FTB_AVDD_MV 3200u                     // DT: init 3.2 V（允许 1.8–3.2 V）；实测 3200 mV
+// VRM 资源内的寄存器偏移与取值（Linux drivers/regulator/qcom-rpmh-regulator.c）
+#define FTB_VRM_REG_VOLTAGE 0x0               // 单位 mV
+#define FTB_VRM_REG_ENABLE 0x4                // 1 = 使能
+#define FTB_VRM_REG_MODE 0x8                  // PMIC5 LDO：3 retention / 4 LPM / 7 HPM
+#define FTB_VRM_MODE_HPM 7
+#define FTB_POWER_SETTLE_MS 3                 // 驱动 fts_probe：fts_enable_reg 之后 mdelay(3) 再配 GPIO、复位
+// 上电顺序：先 vdd 再 avdd（驱动 fts_enable_reg）；下电相反。按 ACTIVE_ONLY 投票、等待完成后再继续：
+struct ftb_rpmh_cmd {uint32_t addr, data;};
+static const struct ftb_rpmh_cmd ftb_power_on_cmds[] = {
+    {FTB_VDD_RPMH_ADDR + FTB_VRM_REG_VOLTAGE, FTB_VDD_MV},
+    {FTB_VDD_RPMH_ADDR + FTB_VRM_REG_MODE, FTB_VRM_MODE_HPM},
+    {FTB_VDD_RPMH_ADDR + FTB_VRM_REG_ENABLE, 1},
+    {FTB_AVDD_RPMH_ADDR + FTB_VRM_REG_VOLTAGE, FTB_AVDD_MV},
+    {FTB_AVDD_RPMH_ADDR + FTB_VRM_REG_ENABLE, 1},
+};
+
+// ---- 坐标与屏下指纹 ----
+#define FTB_X_MAX 10800                       // DT: fts,x-max；DEV: ABS_MT_POSITION_X max 10799
+#define FTB_Y_MAX 24000                       // DT: fts,y-max；DEV: ABS_MT_POSITION_Y max 23999
+#define FTB_SCALE 10                          // 屏幕 1080x2400，触控坐标是 10 倍（DT fts,support-super-resolution = <1>）
+#define FTB_FOD_X 4420                        // DT: fts,fod-lx；/10 = 442，与 persist.vendor.sys.fp.fod.location.X_Y=442,2052 一致
+#define FTB_FOD_Y 20520                       // DT: fts,fod-ly
+#define FTB_FOD_SIZE 1960                     // DT: fts,fod-x-size = fts,fod-y-size；/10 = 196，与 fod.size 196 一致
+
+static inline int ftb_to_pixel_x(int x) {return x / FTB_SCALE;}
+static inline int ftb_to_pixel_y(int y) {return y / FTB_SCALE;}
+
+// ---- 芯片 ----
+#define FTB_CHIP_ID0 0x36                     // 驱动 ftsHardware.h（SALIXP 分支）；固件 st_fts_m3.ftb 头部 target = 0x4036
+#define FTB_CHIP_ID1 0x40
+#define FTB_FW_FILE "st_fts_m3.ftb"           // DT: fts,default-fw-name；/odm/firmware/st_fts_m3.ftb（139728 字节，fw_id 0x6335，fw_ver 0x53）
+#define FTB_FW_RUNNING "53.42"                // 实测 /proc/tp_fw_version：芯片里跑的就是这份文件（fw 0x53 / cfg 0x42），无需刷写
+#define FTB_LOCKDOWN "H820M31"                // 实测 /proc/tp_lockdown_info 48 38 32 30 4D 33 31（第 2 字节 0x38 = tp-vendor）
+#define FTB_TP_VENDOR 0x38                    // DT: fts,cfg_0 fts,tp-vendor = <0x38>
+#endif
diff --git a/package/FuxiTouchProbe.cpp b/package/FuxiTouchProbe.cpp
new file mode 100755
index 0000000..3e0f80f
--- /dev/null
+++ b/package/FuxiTouchProbe.cpp
@@ -0,0 +1,711 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Default-off staged bring-up of the fuxi (Xiaomi 13) ST FingerTip FTM5 touch controller. `fuxi-touch=<n>`:
+//   1  read-only snapshot: GCC branches, S4 DFS levels, the touch pins, the two touch rails in the command database
+//   2  vote the touch rails through RPMh, the QUP clocks, configure the pins, read the GENI engine identity
+//   3  GENI SPI init and clock, reset the controller, wait for its ready event, read the chip id (36 40)
+//   4  start sensing, take the interrupt, drain the event FIFO and publish contacts to the HID source
+// Every stage reports on the diagnostic page (native_touch_rows); the first failure stops the sequence. Nothing here is
+// validated on the device until a boot has shown it.
+//
+// The QUP1 SE4 engine, its clocks, pins 44..47, the stream id and the interrupt pin 25 are the same as on sheng, so the
+// clock, pin, DMA and SMMU code follows UniXNU-sheng package/TouchProbe.cpp and uses its TouchBoard.h. fuxi facts
+// (rails, reset pin, pulls, SPI rate, coordinates) are in FuxiTouchBoard.h; the protocol is FtsProtocol.c.
+//
+// Other boot arguments: fuxi-touch-hz (SPI rate, default 12 MHz from the DT), fuxi-touch-power=0 (skip the rail votes),
+// fuxi-touch-tcs (active TCS of the apps RSC used for the votes, default 2), fuxi-touch-poll=1 (no interrupt),
+// fuxi-touch-map (FTS_MAP_* bits applied before publishing: 1 swap, 2 mirror x, 4 mirror y),
+// fuxi-touch-panic (1: when the requested stage ends or fails, panic with the four diagnostic rows as the message, so the
+// result can be read from the panic screen while no display driver runs; 2: in stage 4, also after the first lift).
+// With sheng-smp=1 the panic message has two more rows: the secondary-core state ArmCpu records (smpText).
+// fuxi-touch-hid=1: once sensing runs, start ShengHidInput's touch digitizer (FuxiHidProbe.cpp), which sends every published
+// contact set as a HID report (the hid counter); the panic message then has a HID row (fuxi_hid_row).
+// The probe starts from bsd_init (patches/xnu/fuxi-touch-probe.patch); every stage result is also printed to the kernel log.
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <string.h>
+#include <libkern/libkern.h>
+#include <libkern/c++/OSSharedPtr.h>
+#include <kern/debug.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+extern "C" {
+#include "GeniSpi.h"
+#include "FtsProtocol.h"
+#include "FtsTouchCore.h"
+#include "TouchBoard.h"
+#include "FuxiTouchBoard.h"
+#include "QcomRpmh.h"
+#include "SmmuBypass.h"
+}
+
+// The HID source (ShengHidInput NativeHidInput.cpp) reads 12 slots and scales x from 0..30480 and y from 0..20320 to its
+// logical range; contacts are mapped into those ranges before they are published.
+constexpr unsigned kPublishSlots = 12;
+constexpr int kHidXMax = 30480, kHidYMax = 20320;
+
+extern "C" {
+char native_touch_rows[4][120];
+char native_touch_trace[8][120];
+volatile uint32_t native_touch_loop_step;
+volatile uint32_t native_touch_stage_req, native_touch_stage_done, native_touch_step, native_touch_frames,
+    native_touch_valid, native_touch_contacts, native_touch_hid_reports;
+volatile int native_touch_error;
+volatile int native_touch_last_x = -1, native_touch_last_y = -1;
+// Latest finger set for the HID digitizer source; the sequence is odd while it is written.
+volatile uint32_t native_touch_seq;
+volatile uint32_t native_touch_count;
+volatile int native_touch_xs[kPublishSlots], native_touch_ys[kPublishSlots], native_touch_ids[kPublishSlots];
+// [0] 0 not armed, 1 armed, 2 attach failed, [1] interrupts, [2] spurious, [3] attach status
+volatile uint32_t native_touch_irq_stats[4];
+/* HID digitizer counters (drivers/NativeHidInput), weak so an image without that driver still links.
+ * install[0]: 1 another event-driver class, 2 a vtable slot did not check out, 3 installed; [1] slots copied;
+ * [2] first slot that did not check out (kSlots = none). stats[0] installed, [1] contacts the event driver
+ * dispatched, [2] of them from an edge, [3] skipped events. multi[0] multi-finger reports, [1] largest finger
+ * count, [2] explicit tip-ups. "hid" growing while stats[1] stays 0 means the reports reach
+ * IOHIDDevice::handleReport but are never dispatched to the event driver. */
+extern volatile uint32_t native_touch_edge_install[3] __attribute__((weak_import));
+extern volatile uint32_t native_touch_edge_stats[4] __attribute__((weak_import));
+extern volatile uint32_t native_touch_hid_multi[3] __attribute__((weak_import));
+/* HidInputProbe.cpp rebuilds these every second from the live registry (native_hid_live_checkpoint): the subtree below the
+ * HID device (so the attached event driver shows up by class name) and the Built-In / PrimaryUsagePage / PrimaryUsage it
+ * reads back from that driver. */
+extern char native_hid_input_registry[2048] __attribute__((weak_import));
+extern char native_hid_input_props[1024] __attribute__((weak_import));
+// The NativeHidInput object the probe created (HidInputProbe.cpp): the fields below come from the disassembly of
+// IOHIDDevice::handleReportWithTime, +0xb0 open flag and +0xc8 -> [+0x20] event-service array.
+extern uint64_t native_hid_input_object __attribute__((weak_import));
+/* BootLog.o (libNativeLegacyDisplay.late.a) reads these two, which the Novatek probe used to
+ * define; keep the same layout so the boot log composes without that probe. */
+volatile int32_t native_touch_strokes[16][7];
+volatile uint32_t native_touch_stroke_count;
+volatile int32_t native_touch_extent[4] = {0x7fffffff, -1, 0x7fffffff, -1};
+}
+
+// HidInputProbe submit counters for the autotap line (weak: the probe can be built without it).
+extern "C" volatile uint32_t native_hid_input_events[8] __attribute__((weak_import));
+extern "C" volatile int native_hid_input_results[8] __attribute__((weak_import));
+static unsigned native_hid_input_events_weak(unsigned i) {return &native_hid_input_events ? native_hid_input_events[i] : 0;}
+static int native_hid_input_result_weak(unsigned i) {return &native_hid_input_results ? native_hid_input_results[i] : -1;}
+
+namespace {
+struct Region {OSSharedPtr<IOMemoryMap> keep; uintptr_t va = 0;};
+
+bool mapRegion(uint64_t phys, uint64_t length, Region &region) {
+    IODeviceMemory *memory = IODeviceMemory::withRange(phys, length);
+    if (!memory) return false;
+    region.keep = OSSharedPtr<IOMemoryMap>(memory->map(kIOMapAnywhere | kIOMapInhibitCache), OSNoRetain);
+    memory->release();
+    region.va = region.keep ? static_cast<uintptr_t>(region.keep->getVirtualAddress()) : 0;
+    return region.va != 0;
+}
+uint32_t rd32(uintptr_t base, uint32_t reg) {return *reinterpret_cast<volatile uint32_t *>(base + reg);}
+void wr32(uintptr_t base, uint32_t reg, uint32_t value) {
+    *reinterpret_cast<volatile uint32_t *>(base + reg) = value;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+// The serial engine's DMA master reads and writes two 64 KiB buffers through a pass-through stream of the apps SMMU,
+// with explicit cache maintenance (as on sheng).
+constexpr size_t kDmaBytes = 64 * 1024;
+void cacheRange(void *p, size_t len, int op) {   // 0 clean, 1 clean+invalidate, 2 invalidate
+    uint64_t ctr;
+    __asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+    size_t line = 4u << ((ctr >> 16) & 15);
+    uintptr_t a = reinterpret_cast<uintptr_t>(p) & ~(line - 1), end = reinterpret_cast<uintptr_t>(p) + len;
+    for (; a < end; a += line) {
+        if (op == 0) __asm__ volatile("dc cvac, %0" :: "r"(a) : "memory");
+        else if (op == 1) __asm__ volatile("dc civac, %0" :: "r"(a) : "memory");
+        else __asm__ volatile("dc ivac, %0" :: "r"(a) : "memory");
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+void dmaClean(void *, void *p, size_t len) {cacheRange(p, len, 0);}
+void dmaCleanInval(void *, void *p, size_t len) {cacheRange(p, len, 1);}
+void dmaInval(void *, void *p, size_t len) {cacheRange(p, len, 2);}
+uint32_t smmuRd(void *ctx, unsigned o) {return rd32(reinterpret_cast<uintptr_t>(ctx), o);}
+void smmuWr(void *ctx, unsigned o, uint32_t v) {wr32(reinterpret_cast<uintptr_t>(ctx), o, v);}
+
+uint32_t ioRd(void *ctx, uint32_t reg) {return rd32(reinterpret_cast<uintptr_t>(ctx), reg);}
+void ioWr(void *ctx, uint32_t reg, uint32_t value) {wr32(reinterpret_cast<uintptr_t>(ctx), reg, value);}
+// Waits of the SPI status polls are about a microsecond: spin on the counter instead of blocking the thread.
+void ioDelayUs(void *, unsigned us) {
+    if (us > 50) {IODelay(us); return;}
+    uint64_t frequency = 0, start = 0, now = 0;
+    __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(frequency));
+    __asm__ volatile("isb\n\tmrs %0, cntpct_el0" : "=r"(start));
+    const uint64_t ticks = (frequency ? frequency : 19200000) * us / 1000000 + 1;
+    do {__asm__ volatile("isb\n\tmrs %0, cntpct_el0" : "=r"(now));} while (now - start < ticks);
+}
+
+// TLMM pin control: bits 1:0 pull (1 down, 3 up), bits 5:2 function, bits 8:6 drive ((mA / 2) - 1), bit 9 output enable;
+// IN_OUT (+0x4) bit 0 the input level, bit 1 the output level (pinctrl-msm.c, pinctrl-sm8550.c).
+constexpr uint32_t kPullDown = 1, kPullUp = 3, kOutputEnable = 1u << 9, kOutHigh = 1u << 1;
+constexpr uint32_t pinCfg(unsigned func, unsigned ma, uint32_t pull) {return pull | (func & 15u) << 2 | ((ma / 2 - 1) & 7u) << 6;}
+
+constexpr uint64_t kCmdDbBase = 0x81c60000ULL, kCmdDbSize = 0x20000;   // DT reserved-memory aop_cmd_db_region@81c60000
+constexpr uint64_t kAppsRscDrv2 = 0x17a20000ULL;                        // DT apps_rsc@17a00000 reg "drv-2"
+constexpr uint32_t kTcsOffset = 0xd00;                                  // DT drv@2 qcom,tcs-offset
+// DT drv@2 qcom,tcs-config: ACTIVE 3, SLEEP 2, WAKE 2, CONTROL 0, FAST_PATH 1, so TCS 0..2 are the active ones.
+constexpr unsigned kActiveTcs = 3;
+
+struct Session {
+    Region gccLow, gccS4, gccHalt, gccVote, tlmmIrq, tlmmReset, tlmmSpi, wrapper, se, smmu, rsc;
+    IOBufferMemoryDescriptor *dmaMem;
+    uint64_t dmaPhys;
+    int smmuSlot, smmuBank, smmuErr;
+    struct geni_spi spi;
+    uint8_t *tx, *rx, *events;
+    struct fts_bus bus;
+    struct fts_chip chip;
+    struct fts_touch_core core;
+    struct fts_map map;
+    uint32_t vals[32];
+    uint32_t vddAddr, avddAddr;       // from the command database (0: not found)
+    int rpmhRc, rpmhWait;
+    unsigned tcs;
+    int lastRc, idRc, resetRc, senseRc;   // the last three are 99 until they run
+    uint32_t lastLen, xIrq, xGeni;
+    uint64_t levelHz[TB_DFS_LEVELS];
+    unsigned level, div;
+    uint64_t actualHz;
+    uint32_t reads, drained, idleWakes, rearms;
+};
+
+int busXfer(void *ctx, const uint8_t *tx, uint8_t *rx, size_t len) {
+    Session *s = static_cast<Session *>(ctx);
+    int rc = geni_spi_transfer(&s->spi, tx, rx, len, 0);
+    if (rc && !s->lastRc) {s->lastRc = rc; s->lastLen = static_cast<uint32_t>(len); s->xIrq = s->spi.snap_irq; s->xGeni = s->spi.snap_status;}
+    return rc;
+}
+void busDelay(void *, unsigned ms) {IOSleep(ms);}
+void busReset(void *ctx, int level) {
+    Session *s = static_cast<Session *>(ctx);
