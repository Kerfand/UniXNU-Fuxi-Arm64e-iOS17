+namespace {
+// fuxi: the plug-in's own record in the control page (ShengAudioDiag, ShengAudioTrace), which sheng printed as [props] and [trace]: every
+// property the audio server asked for and the plug-in did not answer, every failing HAL call and C++ throw of VirtualAudio (kind 4 / 8),
+// then the IO counters. New entries only, whenever something moved.
+char fourcc(uint32_t v, unsigned shift) {const char c = (char)(v >> shift); return c >= 32 && c < 127 ? c : '.';}
+void halDiagRows() {
+    const ShengAudioDiag *dg = sheng_audio_diag();
+    if (!dg) return;
+    const ShengAudioTrace *tr = reinterpret_cast<const ShengAudioTrace *>(reinterpret_cast<const uint8_t *>(dg) - SHENG_AUDIO_DIAG_OFFSET +
+                                                                         SHENG_AUDIO_TRACE_OFFSET);
+    static uint32_t lastDiag, lastTrace, lastWrites, lastVol, lastLoads, lastReq;
+    const uint32_t dc = dg->count, tc = tr->count, req = (uint32_t)native_audio_requests[16];
+    if (dc == lastDiag && tc == lastTrace && dg->writes == lastWrites && dg->volume_sets == lastVol && dg->loads == lastLoads && req == lastReq) return;
+    IOLog("fuxi hal: loads %u unknown %u trace %u writes %u frames %u gaps %u vol %u/%u peak %u clock %u/%d io pri %d tc %d req %u last %#llx\n",
+          dg->loads, dc, tc, dg->writes, dg->frames_total, dg->gaps, dg->volume_milli, dg->volume_sets, dg->mix_peak, dg->host_clock,
+          dg->host_clock_result, dg->io_pri, dg->io_tc, req, (unsigned long long)native_audio_requests[(req + 15) % 16]);
+    for (uint32_t i = lastDiag; i < dc && i < SHENG_AUDIO_DIAG_SLOTS; ++i) {
+        const uint32_t v = dg->selector[i], w = dg->where[i];
+        IOLog("fuxi hal: unknown #%u '%c%c%c%c' object %u scope '%c'\n", i, fourcc(v, 24), fourcc(v, 16), fourcc(v, 8), fourcc(v, 0), w >> 24,
+              fourcc(w, 0));
+    }
+    for (uint32_t i = lastTrace; i < tc && i < SHENG_AUDIO_TRACE_SLOTS; ++i) {
+        const uint32_t v = tr->entry[i][0], w = tr->entry[i][1];
+        IOLog("fuxi hal: trace #%u '%c%c%c%c' %#x where %#x\n", i, fourcc(v, 24), fourcc(v, 16), fourcc(v, 8), fourcc(v, 0), v, w);
+    }
+    const char *paths = reinterpret_cast<const char *>(dg) - SHENG_AUDIO_DIAG_OFFSET + SHENG_AUDIO_PATHS_OFFSET;
+    for (uint32_t i = 0; i < SHENG_AUDIO_PATHS_SLOTS; ++i) {
+        char path[SHENG_AUDIO_PATH_BYTES];
+        memcpy(path, paths + i * SHENG_AUDIO_PATH_BYTES, sizeof path);
+        path[sizeof path - 1] = 0;
+        if (path[0]) IOLog("fuxi hal: path failed #%u %s\n", i, path);
+    }
+    lastDiag = dc; lastTrace = tc; lastWrites = dg->writes; lastVol = dg->volume_sets; lastLoads = dg->loads; lastReq = req;
+}
+// fuxi: "fuxi audio:" rows whenever the stats change (every 250 ms for 4 minutes, then every 5 s).
+void audioLogThread(void *, wait_result_t) {
+    thread_set_thread_name(current_thread(), "fuxi-audio-log");
+    int32_t last[16] = {}, lastMic[16] = {};
+    uint32_t lastAmps[CS35_AMPS][4] = {};
+    for (unsigned tick = 0;; ++tick) {
+        IOSleep(tick < 960 ? 250 : 5000);
+        int32_t s[16], m[16];
+        uint32_t a[CS35_AMPS][4];
+        for (unsigned i = 0; i < 16; ++i) {s[i] = native_audio_stats[i]; m[i] = native_mic_stats[i];}
+        for (unsigned i = 0; i < CS35_AMPS; ++i) for (unsigned k = 0; k < 4; ++k) a[i][k] = native_audio_amps[i][k];
