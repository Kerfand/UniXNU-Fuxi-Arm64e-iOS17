index 0000000..0bbc37d
--- /dev/null
+++ b/ios17/overlay/scripts/build-native-wifi-ios17.py
@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""iOS 17 arm64e (iPhone15,2 21H16) build of the WiFi module (Ath12kWifi f6bf561, the legacy runtime): kernel objects for the board build.
+Usage: build-native-wifi-ios17.py <module dir> <output dir> <compiler>. Prints one line "OBJ <path>" per object.
+
+Derived from scripts/build-native-wifi.py (iPadOS 17 arm64). The differences are what the arm64e kernel requires:
+- the kernel's own compiler and code generation: -target arm64e-apple-ios17.0 -mkernel with type-discriminated function pointers
+  (-fptrauth-function-pointer-type-discrimination) and -disable-atexit-based-global-dtor-lowering, as every XNU 10063 C unit is built
+  (build/xnu/ios-obj/.../startup.o.json). The module and the board code (FuxiWifiNw21.cpp, FuxiWifiNet.cpp) call each other through
+  tables of function pointers (lx_platform, nw_board, nw_wifi_events): both sides have to sign and authenticate them the same way.
+- an arm64 object does not link into the arm64e kernel at all.
+- llvm-nm / llvm-objcopy from PATH (the Linux toolchain), not Homebrew."""
+import subprocess, sys
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+module = Path(sys.argv[1]).resolve()
+out = Path(sys.argv[2]).resolve()
+clang = sys.argv[3]
+out.mkdir(parents=True, exist_ok=True)
+subprocess.run(['bash', str(module / 'tools/prepare.sh')], check=True, stdout=subprocess.DEVNULL)
+resource = subprocess.run([clang, '-print-resource-dir'], check=True, capture_output=True, text=True).stdout.strip() + '/include'
+flags = ['-target', 'arm64e-apple-ios17.0', '-mkernel', '-fptrauth-function-pointer-type-discrimination',
+         '-mllvm', '-disable-atexit-based-global-dtor-lowering',
+         '-O2', '-g0', '-ffreestanding', '-fno-builtin', '-fno-common', '-fno-strict-aliasing', '-fwrapv',
+         '-fno-stack-protector', '-Wno-incompatible-pointer-types', '-Wno-error', '-fno-delete-null-pointer-checks', '-mgeneral-regs-only', '-momit-leaf-frame-pointer', '-std=gnu11', '-w',
+         '-DCONFIG_ATH12K_DEBUG', '-nostdinc', '-isystem', str(module / 'shim/libc'), '-isystem', resource, '-include', 'lx_pci.h',
+         '-I', str(module / 'shim/include'), '-I', str(module / 'include'), '-I', str(module / 'out/pinned'), '-I', str(module / 'src')]
+trees = {'ath12k': ['-I', str(module / 'out/ath12k-src'), '-I', str(module / 'out/ath12k-src/wifi7')],
+         'mhi': ['-I', str(module / 'out/mhi-src')]}
+
+jobs = []
+for line in (module / 'tools/sources.txt').read_text().splitlines():
+    line = line.strip()
+    if not line or line.startswith('#'):
+        continue
+    tree, _, name = line.partition(':') if ':' in line else ('', '', line)
+    if tree == 'ath12k':
+        src = module / 'out/ath12k-src' / name
+    elif tree == 'mhi':
+        src = module / 'out/mhi-src' / name
+    else:
+        src = module / name
+    obj = out / 'raw' / (('w7_' if '/wifi7/' in str(src) else tree + '_' if tree else '') + src.stem + '.o')
+    extra = trees.get(tree, trees['ath12k'] if name.startswith('src/') else [])
+    jobs.append((src, obj, extra))
+(out / 'raw').mkdir(exist_ok=True)
+
+
+def build(job):
+    src, obj, extra = job
+    # Incremental on the raw (unrenamed) objects only: an object newer than its source and this script is reused. The renamed copies
+    # below are made from every raw object on every run, so a partly recompiled set can never mix renamed and unrenamed names.
+    if obj.exists() and obj.stat().st_mtime > max(src.stat().st_mtime, Path(__file__).stat().st_mtime):
+        return obj
+    r = subprocess.run([clang, '-c', *flags, *extra, str(src), '-o', str(obj) + '.tmp'], capture_output=True, text=True)
+    if r.returncode:
+        sys.stderr.write(r.stderr)
+        raise SystemExit(f'compile failed: {src}')
+    Path(str(obj) + '.tmp').replace(obj)
+    return obj
+
+
+
+def move_rodata(path):
+    """The module's constant tables (__TEXT,__const, ~0x9700) from __TEXT to __DATA_CONST (both read-only once the kernel is up): the native kernel
+    __TEXT has to fit the 21H16 collection's largest __PRELINK_TEXT gap (0x139499 with the current prelink roots) and the module's
+    __cstring/__const (~0x1b000) took it to 0x140000. Its strings (~0x11d00) stay: __TEXT then ends at ~0x1372000
+    (page 0x138000); the constants fit __DATA_CONST's room (0xf8b10 with __LASTDATA_CONST). Both margins are small. Only the section's segment name in the object's section header changes (an object
+    file has one unnamed segment; the linker places each section by this name)."""
+    import struct
+    data = bytearray(path.read_bytes())
+    if struct.unpack_from('<I', data, 0)[0] != 0xfeedfacf:
+        raise SystemExit(f'{path}: not a 64-bit Mach-O object')
+    ncmds = struct.unpack_from('<I', data, 16)[0]
+    at = 32
+    for _ in range(ncmds):
+        cmd, size = struct.unpack_from('<II', data, at)
+        if cmd == 0x19:   # LC_SEGMENT_64
+            nsects = struct.unpack_from('<I', data, at + 64)[0]
+            for i in range(nsects):
+                s = at + 72 + 80 * i
+                sect = bytes(data[s:s + 16]).rstrip(b'\0')
+                seg = bytes(data[s + 16:s + 32]).rstrip(b'\0')
+                if seg == b'__TEXT' and sect == b'__const':
+                    data[s + 16:s + 32] = b'__DATA_CONST'.ljust(16, b'\0')
+                elif seg == b'__TEXT' and sect == b'__cstring':
+                    # The strings (~0x11d00) go with the code: kept in __TEXT they took it to 0x13c000 (page padding included),
+                    # past the 0x139499 gap. __TEXT_EXEC is read-only too and has the room (native code goes where the original
+                    # kernel code was, ahead of the retained kexts).
+                    data[s + 16:s + 32] = b'__TEXT_EXEC'.ljust(16, b'\0')
+        at += size
+    path.write_bytes(data)
+
+with ThreadPoolExecutor(8) as pool:
+    list(pool.map(build, jobs))
+
+# The module's global names (sock_release, kernel_sendmsg, ...) are common in a kernel: give every one the prefix nwk_ except the entry
+# points the board uses. The mapping comes from all raw objects together.
+keep = {'_nw_wifi_start', '_nw_wifi_step', '_nw_wifi_stop', '_nw_wifi_stats', '_nw_wifi_set_events', '_nw_wifi_scan', '_nw_wifi_bss_count',
+        '_nw_wifi_bss_get', '_nw_wifi_connect', '_nw_wifi_disconnect', '_nw_wifi_tx', '_nw_wifi_status_get', '_nw_wifi_where',
+        '_nw_wifi_tx_reasons'}
+raws = [o for _, o, _ in jobs]
+names = set()
+for o in raws:
+    r = subprocess.run(['llvm-nm', '-g', '--defined-only', str(o)], check=True, capture_output=True, text=True)
+    for line in r.stdout.splitlines():
+        parts = line.split()
+        if len(parts) == 3 and parts[2] not in keep:
+            names.add(parts[2])
+mapping = out / 'rename.txt'
+mapping.write_text(''.join(f'{n} _nwk{n}\n' for n in sorted(names)))
+finals = []
+for o in raws:
+    final = out / o.name
+    subprocess.run(['llvm-objcopy', f'--redefine-syms={mapping}', str(o), str(final)], check=True)
+    move_rodata(final)
+    finals.append(final)
+for o in finals:
+    print(f'OBJ {o}')
diff --git a/ios17/overlay/scripts/build-turnip-darwin.py b/ios17/overlay/scripts/build-turnip-darwin.py
new file mode 100755
index 0000000..a2d471f
--- /dev/null
+++ b/ios17/overlay/scripts/build-turnip-darwin.py
@@ -0,0 +1,135 @@
+#!/usr/bin/env python3
+"""Build Turnip (Mesa freedreno Vulkan) with the native Darwin kernel backend (patches/mesa/turnip-darwin-kmd.patch).
+
+--target host builds for the Mac only to prove the backend compiles and links against the real Turnip; --target ios
+cross-builds the ARM64/iOS 17 library, --target ios27 the arm64e/iOS 27 one, --target macos27 the arm64e/macOS 27 one. None runs a GPU: the backend talks to the NativeAdreno IOKit service, which
+exists only on the tablet. Output stays under build/ and is never committed."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+from mesa_patch_identity import validate_recorded_patches
+
+ROOT = Path(__file__).resolve().parents[1]
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--target', choices=('host', 'ios', 'ios27', 'macos27', 'ios17e'), default='host')
+parser.add_argument('--configure-only', action='store_true')
+parser.add_argument('--builtin-pack', type=Path, help='Embed an exact-source/profile/GPU-bound own builtin pack; no runtime compiler fallback')
+args = parser.parse_args()
+SOURCE = ROOT / '.cache/mesa-work'
+OUT = ROOT / {'host': 'build/mesa-tu', 'ios': 'build/mesa-tu-ios', 'ios27': 'build/mesa-tu-ios27', 'macos27': 'build/mesa-tu-macos27',
+              'ios17e': 'build/mesa-tu-ios17e'}[args.target]
+LOGS = ROOT / '.cache'
+
+
+def read(cmd):
+    return subprocess.check_output([str(c) for c in cmd], text=True).strip()
+
+
+pins = json.loads((ROOT / 'scripts/data/adreno-compiler-inputs.json').read_text())
+if read(['git', '-C', SOURCE, 'rev-parse', 'HEAD']) != pins['mesa']['commit']:
+    sys.exit('Pinned Mesa source differs')
+validate_recorded_patches(ROOT, SOURCE, pins)
+if not shutil.which('glslangValidator'):
+    sys.exit('glslangValidator is required by the Vulkan runtime build (brew install glslang)')
+
+env = {k: v for k, v in os.environ.items() if not k.startswith(('IR3_', 'FD_MESA_', 'NIR_', 'MESA_SHADER_', 'TU_'))}
+env['PATH'] = str(ROOT / '.cache/mesa-tools/bin') + ':' + str(ROOT / '.cache/mesa-venv/bin') + ':' + env['PATH']
+options = ['-Dgallium-drivers=', '-Dvulkan-drivers=freedreno', '-Dfreedreno-kmds=darwin',
+           '-Dtu-darwin-abi-dir=' + str(ROOT / 'drivers/Adreno740'), '-Dplatforms=macos', '-Dglx=disabled',
+           '-Degl=disabled', '-Dgbm=disabled', '-Dopengl=false', '-Dgles1=disabled', '-Dgles2=disabled',
+           '-Dllvm=disabled', '-Dshared-glapi=disabled', '-Dxmlconfig=disabled', '-Dshader-cache=enabled',
+           '-Dtools=', '-Dbuild-tests=false', '-Dvideo-codecs=', '-Dvulkan-layers=']
+setup = [ROOT / '.cache/mesa-venv/bin/meson', 'setup', OUT, SOURCE, '--wrap-mode=nodownload']
+if args.target in ('ios', 'ios27', 'macos27', 'ios17e'):
+    sdk_name = 'macosx' if args.target == 'macos27' else 'iphoneos'
+    sdk = read(['xcrun', '--sdk', sdk_name, '--show-sdk-path'])
+    find = lambda tool: read(['xcrun', '--sdk', sdk_name, '--find', tool])
+    # ios17e: iOS 17 arm64e (iPhone15,2 21H16, whose render server is an arm64e process).
+    triple = {'ios': 'arm64-apple-ios17.0', 'ios27': 'arm64e-apple-ios27.0', 'macos27': 'arm64e-apple-macos27.0',
+              'ios17e': 'arm64e-apple-ios17.0'}[args.target]
+    flags = ['-target', triple, '-isysroot', sdk, '-fstack-protector-strong']
+    cross = ROOT / ('build/mesa-tu-%s.cross' % args.target)
+    cross.parent.mkdir(exist_ok=True)
+    cross.write_text(
+        '[binaries]\nc = %r\ncpp = %r\nobjc = %r\nar = %r\nstrip = %r\npkg-config = \'/usr/bin/false\'\n'
+        % (find('clang'), find('clang++'), find('clang'), find('ar'), find('strip')) +
+        "[host_machine]\nsystem = 'darwin'\ncpu_family = 'aarch64'\ncpu = 'arm64'\nendian = 'little'\n"
+        "[properties]\nneeds_exe_wrapper = true\n[built-in options]\n" +
+        ''.join('%s = %r\n' % (k, flags) for k in ('c_args', 'cpp_args', 'objc_args')) +
+        # ios17e: chained fixups. 21H16 dyld's withChainStarts sizes a stack buffer by image size for a non-chained arm64e
+        # image, overflowing a 512 KB thread stack in mediaserverd/iconservicesagent.
+        ''.join('%s = %r\n' % (k, flags + (['-Wl,-fixup_chains'] if args.target == 'ios17e' else []))
+                for k in ('c_link_args', 'cpp_link_args', 'objc_link_args')))
+    setup += ['--cross-file', cross]
+    if args.target == 'ios17e':
+        # An existing build directory keeps the cross file it was set up with: name the link arguments as options too.
+        options += ['-D%s=%r' % (k, flags + ['-Wl,-fixup_chains']) for k in ('c_link_args', 'cpp_link_args', 'objc_link_args')]
+    # Release with NDEBUG for the tablet: Mesa's default debugoptimized keeps assertions and NIR validation after
+    # every pass, which the tablet's pipeline makings paid for (int-143: 58 pipeline states took 68 s). The host
+    # build keeps them for the simulation checks.
+    options += ['-Dlibunwind=disabled', '-Dlmsensors=disabled', '-Dvalgrind=disabled', '-Dexpat=disabled',
+                '-Dzstd=disabled', '-Dbuildtype=release', '-Db_ndebug=true']
+    env.update(CC=find('clang'), CXX=find('clang++'), CFLAGS='', CXXFLAGS='', CPPFLAGS='', LDFLAGS='')
+else:
+    env.update(CC='/usr/bin/clang', CXX='/usr/bin/clang++')
+# Bind raw variant layout and code to every actual source edit, untracked
+# source addition, compiler, target and build option. The generated embedded
+# header stays outside SOURCE and is deliberately excluded from this key;
+# otherwise the pack would make its own producer identity circular.
+source_diff = subprocess.check_output(['git', '-C', SOURCE, 'diff', 'HEAD', '--binary'])
+untracked = subprocess.check_output(['git', '-C', SOURCE, 'ls-files', '--others', '--exclude-standard', '-z']).split(b'\0')
+source_extras = {name.decode(): hashlib.sha256((SOURCE / name.decode()).read_bytes()).hexdigest()
+                 for name in untracked if name and (SOURCE / name.decode()).is_file()}
+profile = dict(mesa_revision=pins['mesa']['commit'], target=args.target,
+               source_diff_sha256=hashlib.sha256(source_diff).hexdigest(), extra_sources=source_extras,
+               patch_guard_sha256=hashlib.sha256((ROOT / 'scripts/mesa_patch_identity.py').read_bytes()).hexdigest(),
+               compiler=read([env['CXX'], '--version']), options=options,
+               build_script_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest())
+source_id = hashlib.sha256(json.dumps(profile, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+OUT.mkdir(parents=True, exist_ok=True)
+pack_header = ''
+pack_sha = None
+if args.builtin_pack:
+    pack = args.builtin_pack.resolve().read_bytes()
+    if not 112 <= len(pack) <= 4 * 1024**2 or pack[:8] != b'TUBUILT1' or pack[16:80] != source_id.encode():
+        sys.exit('Builtin pack is not from this exact compiler source/profile; regenerate rather than relabel it')
+    header = OUT / 'tu_builtin_pack.generated.h'
+    header.write_text('/* Generated own compiler output: never commit. */\nstatic const unsigned char tu_builtin_pack_bytes[] = {\n' +
+                      ''.join(','.join('0x%02x' % b for b in pack[i:i+16]) + ',\n' for i in range(0,len(pack),16)) + '};\n')
+    pack_header = str(header)
+    pack_sha = hashlib.sha256(pack).hexdigest()
+(OUT / 'builtin-build-profile.json').write_text(json.dumps(dict(source_id=source_id, profile=profile,
+    embedded_pack_sha256=pack_sha, builtin_pack_required=bool(args.builtin_pack)), indent=2) + '\n')
+options += ['-Dtu-builtin-source-id=' + source_id, '-Dtu-builtin-pack-header=' + pack_header]
+# The pipeline cache's identity (VkPhysicalDeviceProperties::pipelineCacheUUID) from the compiler's source alone, the same for every
+# target: Mesa's own on Darwin is the library file's mtime (disk_cache_get_function_timestamp), which differs per install and per build,
+# so the pipelines a boot compiled into the persistent Data cache would miss after every image rebuild of the same compiler.
+build_id = hashlib.sha256(json.dumps(dict(mesa_revision=pins['mesa']['commit'], source_diff_sha256=profile['source_diff_sha256'],
+                                          extra_sources=source_extras), sort_keys=True).encode()).hexdigest()[:40]
+options += ['-Dtu-build-id=' + build_id]
+log = LOGS / ('mesa-tu-%s-configure.log' % args.target)
+with log.open('w') as stream:
+    # An existing build directory takes the current options (meson configure), so an option added here reaches it.
+    command = setup + options if not (OUT / 'build.ninja').exists() else [ROOT / '.cache/mesa-venv/bin/meson', 'configure', OUT] + options
+    if subprocess.run([str(c) for c in command], env=env, stdout=stream, stderr=subprocess.STDOUT).returncode:
+        sys.exit('Configure failed; see ' + str(log) + '\n' + '\n'.join(log.read_text().splitlines()[-12:]))
+if args.configure_only:
+    print('PASS: Turnip darwin-kmd configuration (%s)' % args.target)
+    sys.exit(0)
+build_log = LOGS / ('mesa-tu-%s-build.log' % args.target)
+with build_log.open('w') as stream:
+    result = subprocess.run(['ninja', '-C', str(OUT), '-j8'], env=env, stdout=stream, stderr=subprocess.STDOUT)
+if result.returncode:
+    sys.exit('Build failed; see ' + str(build_log) + '\n' + '\n'.join(
+        l for l in build_log.read_text().splitlines() if ': error:' in l or 'fatal error:' in l or l.startswith('FAILED:'))[:3000])
+library = OUT / 'src/freedreno/vulkan/libvulkan_freedreno.dylib'
+symbols = subprocess.run(['nm', '-gU', str(library)], capture_output=True, text=True).stdout
+if ' T _vk_icdGetInstanceProcAddr' not in symbols:
+    sys.exit('The library does not export vk_icdGetInstanceProcAddr')
+print('PASS: Turnip with the darwin kernel backend builds for %s (%d bytes); no GPU or IOKit service was exercised'
+      % (args.target, library.stat().st_size))
diff --git a/ios17/overlay/scripts/data/Ios17LegacyDisplayProbe.cpp b/ios17/overlay/scripts/data/Ios17LegacyDisplayProbe.cpp
new file mode 100644
index 0000000..39fb367
--- /dev/null
+++ b/ios17/overlay/scripts/data/Ios17LegacyDisplayProbe.cpp
@@ -0,0 +1,360 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// iOS 17.7 21H16 (fuxi, arm64e) companion of drivers/GopFramebuffer/NativeLegacyDisplay.cpp: the boot-time lifecycle
+// (register the class, attach the display to a GOP framebuffer nub under /arm-io, start it) and the hooks the display
+// calls. A trimmed form of the iPadOS package/LegacyDisplayProbe.cpp: no GPU hand-off, no GOP presenter, no
+// boot-progress scanout arbitration, no user-client interposition. Observation hooks only count and log.
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceMemory.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSMetaClass.h>
+#include <libkern/c++/OSData.h>
+#include <kern/task.h>
+#include <sys/proc.h>
+#include <pexpert/pexpert.h>
+#include <mach/kmod.h>
+extern "C" kmod_info_t g_kernel_kmod_info;
+extern "C" void native_legacy_display_static_init(void) __asm__("__GLOBAL__sub_I_NativeLegacyDisplay.cpp");
+// The GPU scanout hand-off (drivers/GopFramebuffer/NativeGOPPresenter.cpp, boot-arg sheng-fb-gpu=1), as the iPadOS LegacyDisplayProbe.cpp
+// sets it up: created after the display started, attached to the resource service (not under the display subsystem node, whose
+// children the original display code enumerates), its framebuffer memory taken from the GOP nub.
+extern "C" void native_gop_presenter_static_init(void) __asm__("__GLOBAL__sub_I_NativeGOPPresenter.cpp");
+extern "C" IOService *native_gop_presenter_create(void);
+extern "C" void native_gop_presenter_set_source(IOService *presenter, IOService *nub);
+extern "C" bool native_gop_gpu_offer(IOService *, void *display, IOMemoryDescriptor *, uint64_t stride, uint32_t width, uint32_t height,
+    uint32_t format);
+static IOService *gpuHandoffPresenter;
+extern "C" IOService *native_legacy_display_allocate(void);
+extern "C" kern_return_t OSKextLoadKextWithIdentifier(const char *);
+static IOService *pendingLegacyDisplay, *activeLegacyDisplay, *activeNub;
+static IORegistryEntry *unitScaleChosen;
+static bool unitScaleAdded, unitRotationAdded;
+
+extern "C" {
+volatile uint32_t native_legacy_stage;
+volatile int native_legacy_meta_status = -1;
+volatile uint32_t native_legacy_init_result, native_legacy_start_result, native_legacy_probe_match, native_legacy_dt_attached;
+volatile uint64_t native_legacy_object, native_legacy_nub;
+volatile int native_legacy_surface_status = -1;
+volatile uint32_t native_legacy_surface_found;
+volatile uint32_t native_legacy_swap_accepted_count, native_legacy_swap_rejected_count, native_legacy_rej_reason;
+volatile uint32_t native_legacy_transfer_calls, native_legacy_retirement_calls, native_legacy_client_calls, native_legacy_frames;
+volatile int native_legacy_transfer_status = -1, native_legacy_client_status = -1, native_legacy_pm_status = -1;
+volatile uint32_t native_legacy_pm_stage, native_legacy_vsync_events[6];
+volatile uint32_t native_legacy_gpu_fallbacks;
+volatile uint32_t native_ufs_dpu_state;
+}
+
+static void stage(unsigned value, const char *what)
+{
+	native_legacy_stage = value;
+	printf("ios17 legacy display: stage %u %s\n", value, what);
+}
+
+static void finishUnitScalePolicy(bool keep)
+{
+	if (unitScaleChosen && !keep) {
+		if (unitScaleAdded) unitScaleChosen->removeProperty("display-scale");
+		if (unitRotationAdded) unitScaleChosen->removeProperty("display-rotation");
+	}
+	OSSafeReleaseNULL(unitScaleChosen);
+	unitScaleAdded = unitRotationAdded = false;
+}
+
+static bool publishOrMatchWord(IORegistryEntry *entry, const char *key, uint32_t value, bool &added)
+{
+	OSObject *previous = entry->getProperty(key);
+	if (previous) {
+		OSData *data = OSDynamicCast(OSData, previous);
+		uint32_t word = 0;
+		if (!data || data->getLength() != sizeof(word)) return false;
+		memcpy(&word, data->getBytesNoCopy(), sizeof(word));
+		return word == value;
+	}
+	OSData *data = OSData::withBytes(&value, sizeof(value));
+	bool result = data && entry->setProperty(key, data);
+	OSSafeReleaseNULL(data);
+	added = result;
+	return result;
+}
+
+extern "C" {
+// No boot-progress console shares the scanout on this build: the display owns it.
+bool native_legacy_prepare_scanout(void) { return true; }
+// GPU hand-off and direct DPU scanout are not part of the iOS 17 bring-up: every frame takes the CPU copy.
+// Weak: Adreno740 / GpuPowerProbe provide the real ones when the GPU is linked.
+// Was a no-op returning false: every frame took the CPU copy. Hands the frame to the GPU when the presenter is up.
+bool native_legacy_gpu_offer(void *display, IOMemoryDescriptor *memory, uint64_t stride, uint32_t width, uint32_t height, uint32_t format)
+{ return gpuHandoffPresenter && native_gop_gpu_offer(gpuHandoffPresenter, display, memory, stride, width, height, format); }
+volatile int32_t native_legacy_gpu_last_status;
+void native_legacy_gpu_fallback_observed(int status) { native_legacy_gpu_last_status = status; native_legacy_gpu_fallbacks = native_legacy_gpu_fallbacks + 1; }
+__attribute__((weak)) bool native_adreno_fences(uint32_t *submitted, uint32_t *retired) { (void)submitted; (void)retired; return false; }
+uint32_t native_ufs_dpu_map(unsigned, const uint64_t *, unsigned) { return 0; }
+
+__attribute__((noreturn, noinline)) void native_legacy_backend_guard(unsigned slot, void *object, void *caller)
+{
+	panic("NativeLegacyDisplay: unimplemented leaf %u object %p caller %p stage %u", slot, object, caller, native_legacy_stage);
+}
+void native_legacy_pm_observed(unsigned stage_, IOReturn status, unsigned long ordinal)
+{
+	native_legacy_pm_stage = stage_; native_legacy_pm_status = status;
+	printf("ios17 legacy display: pm stage %u status %#x ordinal %lu\n", stage_, status, ordinal);
+}
+void native_legacy_surface_rejected(uint64_t w, uint64_t h, uint32_t format, uint32_t planes, uint64_t stride, uint64_t allocation, uint64_t bytes)
+{
+	printf("ios17 legacy display: surface rejected %llux%llu fmt %#x planes %u stride %llu alloc %llu bytes %llu\n",
+	    w, h, format, planes, stride, allocation, bytes);
+}
+void native_legacy_frame_observed(unsigned kind, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
+{
+	uint32_t n = native_legacy_frames + 1;
+	native_legacy_frames = n;
+	if (n <= 3 || (n & (n - 1)) == 0) printf("ios17 legacy display: frame %u kind %u\n", n, kind);
+}
+void native_legacy_frame_colors_observed(const uint32_t *, const uint64_t *, uint64_t) {}
+void native_legacy_swap_stage(unsigned) {}
+void native_legacy_vsync_observed(unsigned event, unsigned hz)
+{
+	if (event < 6) native_legacy_vsync_events[event] = native_legacy_vsync_events[event] + 1;
+	if (event == 4 || event == 5) printf("ios17 legacy display: vsync event %u hz %u\n", event, hz);
+}
+void native_legacy_swap_validation_observed(bool accepted, unsigned reason, const void *, const void *)
+{
+	if (accepted) {
+		uint32_t n = native_legacy_swap_accepted_count + 1;
+		native_legacy_swap_accepted_count = n;
+		if (n == 1) printf("ios17 legacy display: first swap accepted\n");
+	} else {
+		uint32_t n = native_legacy_swap_rejected_count + 1;
+		native_legacy_swap_rejected_count = n;
+		native_legacy_rej_reason = reason;
+		if (n <= 8) printf("ios17 legacy display: swap rejected reason %u (%u)\n", reason, n);
+	}
+}
+void native_legacy_copy_timing_observed(uint64_t, uint64_t) {}
+// Scanout sampler: what is actually in the GOP buffer after a transfer. Bounded strided reads only, no allocation.
+static volatile uint32_t *gScanout;
+static uint32_t gScanoutW, gScanoutH, gScanoutStride, gScanoutSamples;
+static void sample_scanout(const char *when)
+{
+	if (!gScanout || !gScanoutW || !gScanoutH) {printf("ios17 legacy display: scanout %s unavailable\n", when); return;}
+	const uint32_t stepX = gScanoutW / 32 ? gScanoutW / 32 : 1, stepY = gScanoutH / 32 ? gScanoutH / 32 : 1;
+	uint32_t nonblack = 0, maxChannel = 0, total = 0, dark = 0, blue = 0;
+	uint32_t firstPixel = 0, midPixel = 0;
+	for (uint32_t y = 0; y < gScanoutH; y += stepY) {
+		for (uint32_t x = 0; x < gScanoutW; x += stepX) {
+			const uint32_t px = gScanout[(uint64_t)y * (gScanoutStride / 4) + x];
+			if (!total) firstPixel = px;
+			if (total == 512) midPixel = px;
+			const uint32_t b = px & 0xff, g = (px >> 8) & 0xff, r = (px >> 16) & 0xff;
+			const uint32_t mx = b > g ? (b > r ? b : r) : (g > r ? g : r);
+			if (px & 0xffffff) nonblack++;
+			if (mx > maxChannel) maxChannel = mx;
+			if (mx < 8) dark++;
+			if (b > r + 8 && b > g + 8) blue++;
+			total++;
+		}
+	}
+	gScanoutSamples++;
+	printf("ios17 legacy display: scanout %s n%u nonblack %u/%u dark %u blue %u max %u first %08x mid %08x\n",
+	       when, gScanoutSamples, nonblack, total, dark, blue, maxChannel, firstPixel, midPixel);
+}
+__attribute__((noinline)) void native_legacy_transfer_observed(IOReturn status, const void *, uint64_t bytes)
+{
+	native_legacy_transfer_calls = native_legacy_transfer_calls + 1; native_legacy_transfer_status = status;
+	if (status || native_legacy_transfer_calls == 1)
+		printf("ios17 legacy display: transfer status %#x bytes %llu\n", status, bytes);
+	// Contended scanout writes can tear, so only the first few frames are sampled to keep the log small.
+	if (native_legacy_transfer_calls <= 4 || native_legacy_transfer_calls == 60) sample_scanout("after-transfer");
+}
+__attribute__((noinline)) void native_legacy_retirement_observed(IOService *) { native_legacy_retirement_calls = native_legacy_retirement_calls + 1; }
+void native_legacy_registration_observed(IOService *display)
+{
+	printf("ios17 legacy display: registered %p\n", display);
+}
+void native_legacy_client_enter(task_t task, uint32_t type)
+{
+	native_legacy_client_calls = native_legacy_client_calls + 1;
+	int pid = task ? proc_pid((proc_t)get_bsdtask_info(task)) : 0;
+	printf("ios17 legacy display: newUserClient type %u pid %d\n", type, pid);
+}
+void native_legacy_client_observed(IOReturn status, IOUserClient *client)
+{
+	native_legacy_client_status = status;
+	printf("ios17 legacy display: user client %s status %#x\n", client ? client->getMetaClass()->getClassName() : "(none)", status);
+}
+
+// The display has mapped the GOP framebuffer. With offline-legacy-unit-scale=<1..3> (phase 4) publish the UI scale
+// (scanout pixels per logical point) and rotation in /chosen, where the original display code reads them.
+__attribute__((noinline)) bool native_legacy_gop_mapping_observed(IOService *object, IOMemoryMap *mapping, uint32_t width, uint32_t height)
+{
+	if ((uintptr_t)object != native_legacy_object) panic("NativeLegacyDisplay: wrong mapping owner");
+	printf("ios17 legacy display: GOP mapping va %#llx pa %#llx bytes %#llx %ux%u\n", (uint64_t)mapping->getVirtualAddress(),
+	    (uint64_t)mapping->getPhysicalAddress(), (uint64_t)mapping->getLength(), width, height);
+	gScanout = (volatile uint32_t *)(uintptr_t)mapping->getVirtualAddress();
+	gScanoutW = width; gScanoutH = height; gScanoutStride = (uint32_t)(mapping->getLength() / (height ? height : 1));
+	sample_scanout("at-mapping");
+	unsigned enabled = 0; PE_parse_boot_argn("offline-legacy-unit-scale", &enabled, sizeof(enabled));
+	if (!enabled) return true;
+	unsigned phase = 0; PE_parse_boot_argn("offline-legacy-phase", &phase, sizeof(phase));
+	PE_Video video = {};
+	if (enabled < 1 || enabled > 3 || phase != 4 || unitScaleChosen || PE_current_console(&video) ||
+	    video.v_width != width || video.v_height != height || video.v_rotate ||
+	    mapping->getPhysicalAddress() != video.v_baseAddr) return false;
+	unitScaleChosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	if (!unitScaleChosen || !publishOrMatchWord(unitScaleChosen, "display-scale", enabled, unitScaleAdded) ||
+	    !publishOrMatchWord(unitScaleChosen, "display-rotation", video.v_rotate, unitRotationAdded)) {
+		finishUnitScalePolicy(false); return false;
+	}
+	printf("ios17 legacy display: /chosen display-scale %u rotation %u\n", enabled, video.v_rotate);
+	return true;
+}
+
+// Early (bsd_init, after IOMobileGraphicsFamily loaded, boot-arg offline-legacy-register=1): register the display's
+// metaclass and create the instance.
+void native_legacy_display_probe(void);
+void native_legacy_display_probe(void)
+{
+	if (native_legacy_stage) return;
+	stage(1, "register");
+	void *handle = OSMetaClass::preModLoad(g_kernel_kmod_info.name);
+	if (!handle) { stage(90, "preModLoad failed"); return; }
+	native_legacy_display_static_init();
+	native_gop_presenter_static_init();
+	native_legacy_meta_status = OSMetaClass::postModLoad(handle);
+	if (native_legacy_meta_status) { printf("ios17 legacy display: postModLoad %d\n", native_legacy_meta_status); stage(91, "metaclass failed"); return; }
+	PE_Video video = {};
+	if (PE_current_console(&video) || !video.v_baseAddr || !video.v_width || !video.v_height || video.v_depth != 32 ||
+	    video.v_rotate || video.v_width > 16384 || video.v_height > 16384 || video.v_rowBytes < video.v_width * 4) {
+		stage(92, "no usable GOP console"); return;
+	}
+	IOService *display = native_legacy_display_allocate();
+	native_legacy_object = (uintptr_t)display;
+	if (!display) { stage(93, "allocate failed"); return; }
+	printf("ios17 legacy display: object %p size %u parents %d\n", display, (unsigned)display->getMetaClass()->getClassSize(),
+	    display->metaCast("IOMobileFramebufferLegacy") && display->metaCast("IOMobileFramebuffer") && display->metaCast("IOService"));
+	stage(2, "init");
+	native_legacy_init_result = display->init();
+	if (!native_legacy_init_result) { stage(94, "init failed"); display->release(); return; }
+	pendingLegacyDisplay = display;
+	stage(3, "pending until IOSurface");
+}
+
+// Late (after IOKitBSDInit): wait for IOSurface, publish the GOP framebuffer as an IOPlatformDevice under /arm-io
+// (display-subsystem), then probe/attach/start the display on it.
+void native_legacy_display_late_probe(void);
+extern "C" void sheng_gpu_power_probe(void);
+// The AppleKeyStore stand-in (kits/sheng/KeyStoreProbe.cpp, drivers/AppleKeyStoreState): SpringBoard waits for the class.
+extern "C" void native_keystore_probe(void);
+// The fuxi FTM5 touch controller and its HID digitizer (kits/sheng/FuxiTouchProbe.cpp, fuxi-touch=4).
+extern "C" void native_touch_probe(void);
+// The fuxi buttons (kits/sheng/FuxiButtons.cpp, boot-arg fuxi-buttons=1): PMK8550 PON/RESIN and PM8550 GPIO6 over the SPMI
+// observer, reported through NativeHidInput report 2.
+extern "C" void fuxi_buttons_probe(void);
+extern "C" void fuxi_wifi_probe(void);        // fuxi-wifi=1: read-only look at the WCN7850 path
+extern "C" void sheng_audio_probe(void);      // sheng-audio=N: speakers, microphone, audio service (AudioProbe.cpp)
+extern "C" void sheng_adsp_probe(void);       // sheng-adsp=1/2: the audio DSP (AdspProbe.cpp), power.md section 3
+extern "C" void fuxi_cpufreq_start(void);     // sheng-cpufreq=N: CPU/L3 frequency votes (CpuFreqProbe.cpp, FuxiCpuFreqLog.cpp)
+extern "C" void fuxi_wifi_link_probe(void);   // fuxi-wifi=2/3/5: power, PCIe0 link; 5 runs Ath12kWifi (FuxiWifiNw21)
+// The panel brightness service: BacklightProbe.cpp starts AppleARMBacklight.cpp (boot-arg sheng-backlight=1),
+// which publishes backlight-control for CoreBrightness. The 21H16 late probe never called it, so the panel
+// stayed dark no matter which backlight boot arguments were set.
+extern "C" void sheng_backlight_probe(void);
+void native_legacy_display_late_probe(void)
+{
+	// Board GPU bring-up (kits/sheng/GpuPowerProbe.cpp); does nothing unless boot-arg sheng-gpu-power is set.
+	native_keystore_probe();
+	sheng_gpu_power_probe();
+	native_touch_probe();
+	fuxi_cpufreq_start();
+	sheng_adsp_probe();
+	sheng_audio_probe();
+	fuxi_buttons_probe();
+	fuxi_wifi_probe();
+	fuxi_wifi_link_probe();
+	// Panel brightness runs before the display-object check: it does not need the GOP nub, and returning early
+	// on a missing IOSurface must not also leave the screen unlit.
+	sheng_backlight_probe();
+	IOService *display = pendingLegacyDisplay;
+	if (!display) return;
+	pendingLegacyDisplay = nullptr;
+	native_legacy_surface_status = OSKextLoadKextWithIdentifier("com.apple.iokit.IOSurface");
+	OSDictionary *matching = IOService::nameMatching("IOCoreSurfaceRoot");
+	IOService *surface = matching ? IOService::waitForMatchingService(matching, 5000000000ULL) : nullptr;
+	native_legacy_surface_found = surface != nullptr;
+	OSSafeReleaseNULL(surface); OSSafeReleaseNULL(matching);
+	printf("ios17 legacy display: IOSurface load %d root %u\n", native_legacy_surface_status, native_legacy_surface_found);
+	PE_Video video = {};
+	if (native_legacy_surface_status || !native_legacy_surface_found || PE_current_console(&video) || !video.v_baseAddr ||
+	    video.v_depth != 32 || video.v_rotate || video.v_rowBytes < video.v_width * 4) {
+		stage(95, "no IOSurface or GOP"); display->release(); return;
+	}
+	stage(4, "GOP nub");
+	IOPlatformDevice *nub = new IOPlatformDevice;
+	native_legacy_nub = (uintptr_t)nub;
+	bool nubAttached = false, nubStarted = false, attached = false, started = false, dtAttached = false;
+	IORegistryEntry *displayTreeParent = nullptr;
+	// The nub's provider must be the platform expert: IOPlatformDevice::compareName (device-tree name lookups, e.g.
+	// io_device_tree_entry_exists_with_name) calls ((IOPlatformExpert *)getProvider())->compareNubName(). Under
+	// IOResources (the iPadOS probe's parent) that virtual call fails pointer authentication on arm64e
+	// (2026-11-07 20:10 screen: FPAC in IOPlatformDevice::compareName).
+	IOService *parent = IOService::getPlatform();
+	IODeviceMemory *memory = IODeviceMemory::withRange(video.v_baseAddr, video.v_rowBytes * video.v_height);
+	OSArray *ranges = OSArray::withCapacity(1);
+	if (nub && memory && ranges && parent && nub->init()) {
+		ranges->setObject(memory); nub->setDeviceMemory(ranges); nub->setName("NativeGOPFramebuffer");
+		nubAttached = nub->attach(parent);
+		if (nubAttached) nubStarted = nub->start(parent);
+		if (nubStarted) {
+			unsigned phase = 0; PE_parse_boot_argn("offline-legacy-phase", &phase, sizeof(phase));
+			if (phase == 4) {
+				displayTreeParent = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+				const char type[] = "display-subsystem";
+				OSData *data = OSData::withBytes(type, sizeof(type));
+				if (displayTreeParent && data && nub->setProperty("device_type", data)) {
+					nub->setName("gop-display", gIODTPlane);
+					dtAttached = nub->attachToParent(displayTreeParent, gIODTPlane);
+				}
+				OSSafeReleaseNULL(data);
+				native_legacy_dt_attached = dtAttached;
+			}
+			SInt32 score = 0;
+			native_legacy_probe_match = (phase != 4 || dtAttached) && display->probe(nub, &score) == display;
+			if (native_legacy_probe_match) attached = display->attach(nub);
+			if (attached) { stage(5, "start"); started = display->start(nub); native_legacy_start_result = started; }
+			if (started && phase == 4) {
+				activeLegacyDisplay = display; activeNub = nub;
+				{
+					unsigned gpu = 0; PE_parse_boot_argn("sheng-fb-gpu", &gpu, sizeof gpu);
+					if (gpu == 1) {
+						IOService *handoff = native_gop_presenter_create();
+						IOService *home = IOService::getResourceService();
+						bool handoffAttached = false;
+						if (handoff && home) native_gop_presenter_set_source(handoff, nub);
+						if (handoff && home && handoff->init() && (handoffAttached = handoff->attach(home)) && handoff->start(home)) gpuHandoffPresenter = handoff;
+						else { if (handoffAttached) handoff->detach(home); OSSafeReleaseNULL(handoff); }
+						printf("ios17 legacy display: GPU hand-off presenter %s\n", gpuHandoffPresenter ? "started" : "failed");
+					}
+				}
+				finishUnitScalePolicy(true);
+				OSSafeReleaseNULL(displayTreeParent);
+				stage(10, "display started");
+				return;
+			}
+		}
+	}
+	printf("ios17 legacy display: failed nub %d/%d dt %d probe %u attach %d start %d\n", nubAttached, nubStarted, dtAttached,
+	    native_legacy_probe_match, attached, started);
+	stage(6, "unwind");
+	finishUnitScalePolicy(false);
+	if (started) display->stop(nub);
+	if (attached) display->detach(nub);
+	if (dtAttached) nub->detachFromParent(displayTreeParent, gIODTPlane);
+	if (nubStarted) nub->stop(parent);
+	if (nubAttached) nub->detach(parent);
+	OSSafeReleaseNULL(ranges); OSSafeReleaseNULL(memory); OSSafeReleaseNULL(nub); OSSafeReleaseNULL(displayTreeParent);
+	display->release();
+	stage(8, "released");
+}
+}
