+    }
+    static IOReturn touchAction(OSObject *owner,void *,void *,void *,void *) {
+        NativeHidInput *self=OSDynamicCast(NativeHidInput,owner);if(!self)return kIOReturnSuccess;
+        self->touchSend();
+        return kIOReturnSuccess;
+    }
+    void touchSend() {
