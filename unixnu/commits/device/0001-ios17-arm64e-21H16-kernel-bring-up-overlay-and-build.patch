index 0000000..7ef65a6
--- /dev/null
+++ b/ios17/overlay/scripts/build-fileset-release-reference.py
@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+"""Build a symbol-bearing RELEASE comparison kernel in an isolated output tree."""
+import json
+import os
+import re
+import shutil
+import hashlib
+import argparse
+import platform
+import fnmatch
+from pathlib import Path
+import subprocess
+
+
+def file_hash(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def tree_hash(path):
+    """Hash inputs by content; follow SDK header-directory links as the compiler does."""
+    if not path.is_dir():
+        raise FileNotFoundError(path)
+    digest = hashlib.sha256()
+    for directory, dirs, files in os.walk(path, followlinks=True):
+        dirs[:] = sorted(d for d in dirs if d != '.git')
+        for name in sorted(files):
+            item = Path(directory) / name
+            digest.update(str(item.relative_to(path)).encode() + b'\0')
+            digest.update(file_hash(item).encode() + b'\0')
+    return digest.hexdigest()
+
+
+def reusable(final, record, inputs):
+    try:
+        saved = json.loads(record.read_text())
+        return saved['inputs'] == inputs and saved['sha256'] == file_hash(final)
+    except (OSError, ValueError, KeyError):
+        return False
+
+
+def linked_objects(directory, lto):
+    if lto:
+        # XNU splits the final link into non-LTO objects and the code generated
+        # by its intermediate LTO link. There is no link.filelist in this mode.
+        objects = (directory / 'nonltolink.filelist').read_text().splitlines()
+        generated = directory / 'justlto.o'
+        objects += [str(p) for p in sorted(generated.glob('*.o'))] if generated.is_dir() else [str(generated)]
+    else:
+        objects = (directory / 'link.filelist').read_text().splitlines()
+        objects += [str(directory / name) for name in
+                    ('version.o', 'lastkerneldataconst.o', 'lastkernelconstructor.o')
+                    if (directory / name).is_file()]
+    return [str(Path(name) if Path(name).is_absolute() else directory / name)
+            for name in objects if name.strip()]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--tree', required=True, type=Path, help='prepared XNU build tree of the OS profile')
+    parser.add_argument('--lto', action='store_true', help='enable the RELEASE default link-time optimization')
+    options = parser.parse_args()
+    mode = 'lto' if options.lto else 'snapshot'
+    root = options.tree.resolve()
+    build_root = root / 'build/xnu/fileset-reference'
+    final = build_root / 'mach.release.bcm2837.unstripped.noctf'
+    cache_record = final.with_suffix('.json')
+    sdk = root / '.cache/fakeroot'
+    archives = [root/'build/corecrypto-2023/libcorecrypto_kernel_noasm-namespaced.a']
+    forced = [root/f'build/{folder}/{name}' for folder,name in (
+        ('libpthread-kernel','libpthread_kernel.a'),('armdt-platform','libArmDTPlatform.a'),('armcpu','libArmCpu.a'))]
+    inputs = {
+        'mode': mode,
+        'script': file_hash(Path(__file__)),
+        'source': tree_hash(root / '.cache/xnu-work'),
+        'sdk': tree_hash(sdk),
+        'archives': {str(p.relative_to(root)): file_hash(p) for p in archives + forced},
+        'versions': {name: os.environ.get(name, default) for name, default in (
+            ('UNIXNU_IOS_VERSION', '26.0'), ('UNIXNU_XNU_DARWIN', '25.5.0'),
+            ('UNIXNU_XNU_VERSION', '12377.121.6'))},
+        'compiler': subprocess.check_output(['xcrun', 'clang', '--version'], text=True),
+        'environment': {name: value for name, value in os.environ.items()
+                        if name.startswith(('XNU_', 'RC_', 'CCC_')) or name in ('CC', 'CXX', 'LD')},
+    }
+    if reusable(final, cache_record, inputs):
+        print(f'reference inputs and digest match ({mode}): {final}')
+        return
+    # Separate workspaces prevent non-LTO objects and stale patched sources from
+    # being reused after a mode, source, SDK, archive or compiler change.
+    key = hashlib.sha256(json.dumps(inputs, sort_keys=True).encode()).hexdigest()
+    output = build_root / f'{mode}-{key[:16]}'
+    output.mkdir(parents=True, exist_ok=True)
+    (output / 'inputs.json').write_text(json.dumps(inputs, indent=2) + '\n')
+    source = output / 'source'
+    if not source.exists():
+        shutil.copytree(root/'.cache/xnu-work', source, symlinks=True,
+                        ignore=shutil.ignore_patterns('.git'))
+        # The shared tree currently has this observation hook at file scope. The
+        # reference build disables observation hooks; repair only its private copy.
+        sleh = source / 'osfmk/arm64/sleh.c'
+        text = sleh.read_text()
+        misplaced = '\n\tboot_progress_user_breakpoint(state, esr);\n#if __has_feature(ptrauth_calls)'
+        if misplaced in text:
+            sleh.write_text(text.replace(misplaced, '\n#if __has_feature(ptrauth_calls)', 1))
+        manifest = {str(p.relative_to(source)): hashlib.sha256(p.read_bytes()).hexdigest()
+                    for p in source.rglob('*') if p.is_file()}
+        (output/'source-sha256.json').write_text(json.dumps(manifest,indent=2)+'\n')
+    env = dict(os.environ, KERNEL_SDKROOT=str(sdk),
+               XNU_AVAILABILITY_PL=str(sdk/'usr/local/libexec/availability.pl'))
+    flags = '-Wno-reserved-identifier -Wno-pre-c11-compat -Wno-missing-designated-field-initializers -Wno-suggest-override -Wno-unnecessary-virtual-specifier -Wno-suggest-destructor-override -Wno-ms-bitfield-padding -DXNU_NATIVE_PAN=1 -DXNU_SOURCE_CORECRYPTO14=1 -DXNU_BOOT_PROGRESS=0'
+    args = ['make','-C',str(source),'build','SDKROOT=iphoneos',
+        'ARCH_CONFIGS=ARM64','MACHINE_CONFIGS=BCM2837','KERNEL_CONFIGS=RELEASE',
+        'ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG=arm64e','LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY',
+        'ARM64_LINK_ADDR=0xfffffff007004000','ARM64_PLKSEG_ADDR=0xfffffff004004000',
+        f'DEPLOYMENT_TARGET_FLAGS=-miphoneos-version-min={os.environ.get("UNIXNU_IOS_VERSION", "26.0")} -DXNU_TARGET_OS_IOS',
+        f'DEPLOYMENT_LINKER_FLAGS=-Wl,-ios_version_min,{os.environ.get("UNIXNU_IOS_VERSION", "26.0")}',
+        f'RC_DARWIN_KERNEL_VERSION={os.environ.get("UNIXNU_XNU_DARWIN", "25.5.0")}',
+        f'RC_ProjectSourceVersion={os.environ.get("UNIXNU_XNU_VERSION", "12377.121.6")}',
+        f'BUILD_LTO={int(options.lto)}','BOUND_CHECKS=0','BUILD_WERROR=0',f'MAKEJOBS=-j{os.environ.get("JOBS", "6")}',
+        f'LDFLAGS_KERNEL_LTO=-miphoneos-version-min={inputs["versions"]["UNIXNU_IOS_VERSION"]} -Wl,-mllvm,-inline-threshold=100',
+        f'CFLAGS_EXTRA={flags}',
+        'copyio.o_CFLAGS_ADD=-march=armv8.1-a','pcb.o_CFLAGS_ADD=-march=armv8.1-a',
+        'LD_KERNEL_ARCHIVES='+' '.join([f'-L{sdk}/usr/local/lib/kernel','-lfirehose_kernel',
+                                        *map(str,archives),*(f'-Wl,-force_load,{p}' for p in forced)]),
+        'XNU_EXTERNAL_KERNEL_ARCHIVES='+' '.join(map(str,archives+forced)),
+        f'OBJROOT={output}/{mode}-obj',f'SYMROOT={output}/{mode}-sym',f'DSTROOT={output}/{mode}-dst']
+    if platform.system() == 'Linux':
+        # What a Mac provides itself (scripts/linux): host compiler, mig, memory and CPU counts, no dSYM.
+        clt = os.environ['CLT_PREFIX']
+        env.update(PLATFORM='iPhoneOS', HOST_CC=f'{clt}/bin/xnu-host-cc', MIGCOM=f'{clt}/libexec/migcom')
+        args += ['TIGHTBEAMC=tightbeamc-not-supported', 'BUILD_DSYM=0',
+                 f'MEMORY_SIZE={os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE")}',
+                 f'SYSCTL_HW_PHYSICALCPU={os.cpu_count()}', f'SYSCTL_HW_LOGICALCPU={os.cpu_count()}',
+                 f'LD_KERNEL_LIBS={sdk}/usr/local/lib/kernel/libcc_kext.a']
+    (output/f'{mode}-command.json').write_text(json.dumps(args,indent=2)+'\n')
+    with (output/f'{mode}-build.log').open('w') as log:
+        result = subprocess.run(args,cwd=root,env=env,stdout=log,stderr=subprocess.STDOUT)
+    print('RELEASE reference exit',result.returncode,'log',output/f'{mode}-build.log',flush=True)
+    # The bring-up patch calls native hooks from the kernel core behind weak_import declarations; on arm64e
+    # the authenticated pointer of an undefined weak symbol fails the link. The private copy stubs them: this
+    # comparison kernel never runs, the prelink step reads its layout.
+    build_log = (output / f'{mode}-build.log').read_text()
+    # fuxi: every symbol the last link left undefined (device archives the comparison kernel does not link,
+    # C++ instantiations), named through asm labels so mangled names work too.
+    blocks = build_log.split('Undefined symbols for architecture')
+    stub_names = sorted(set(re.findall(r'^\s+"(_[^"]+)", referenced from', blocks[-1], re.M))) if len(blocks) > 1 else []
+    if stub_names:
+        (output / 'native-stubs.c').write_text(''.join(f'long unixnu_ref_stub_{i} __asm__("{name}");\n'
+                                                       for i, name in enumerate(stub_names)))
+        iphoneos = subprocess.check_output(['xcrun', '--sdk', 'iphoneos', '--show-sdk-path'], text=True).strip()
+        subprocess.run(['xcrun', 'clang', '-arch', 'arm64e', '-mkernel', '-isysroot', iphoneos, '-c',
+                        '-o', str(output / 'native-stubs.o'), str(output / 'native-stubs.c')], check=True)
+        at = next(i for i, a in enumerate(args) if a.startswith('LD_KERNEL_ARCHIVES='))
+        args[at] += f' -Wl,-force_load,{output}/native-stubs.o'
+    # Forced exports the built objects cannot provide: remove them from this private copy and link again
+    # (the symbols are absent from the comparison kernel either way; the first link can stop exactly there,
+    # and its file list is what names the objects that were built).
+    objects = linked_objects(output / f'{mode}-obj/RELEASE_ARM64_BCM2837', options.lto)
+    objects += list(map(str, archives + forced))
+    names = set()
+    for i in range(0, len(objects), 100):
+        listed = subprocess.run(['xcrun', 'nm', '-gUj', *objects[i:i + 100]], capture_output=True, text=True, check=True)
+        names.update(symbol for symbol in listed.stdout.splitlines() if symbol.startswith('_') and ' ' not in symbol)
+    removed = []
+    for filename in ('Private.exports', 'Private.arm64.exports'):
+        path = output / 'source/config' / filename
+        lines = path.read_text().splitlines(keepends=True)
+        rejected = {line.strip() for line in lines
+                    if line.strip().startswith('_') and ':' not in line and not any(fnmatch.fnmatchcase(n, line.strip()) for n in names)}
+        removed.extend(sorted(rejected))
+        path.write_text(''.join(line for line in lines if line.strip() not in rejected))
+    import json as _json
+    record = output / 'omitted-unavailable-forced-exports.json'
+    previous = _json.loads(record.read_text()) if record.exists() else []
+    record.write_text(_json.dumps(sorted(set(previous + removed)), indent=2) + chr(10))
+    print('removed', len(removed), 'unavailable forced exports; linking again')
+    with (output / f'{mode}-build.log').open('a') as log:
+        result = subprocess.run(args, cwd=root, env=env, stdout=log, stderr=subprocess.STDOUT)
+    print('RELEASE reference exit', result.returncode, 'log', output / f'{mode}-build.log', flush=True)
+    if result.returncode:
+        raise SystemExit(result.returncode)
+    built = output / f'{mode}-obj/RELEASE_ARM64_BCM2837/mach.release.bcm2837.unstripped'
+    temporary = final.with_suffix('.tmp')
+    shutil.copyfile(built, temporary)
+    os.replace(temporary, final)
+    cache_record.write_text(json.dumps({'inputs': inputs, 'sha256': file_hash(final),
+                                  'build': str(output)}, indent=2) + '\n')
+    print('reference', final)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/ios17/overlay/scripts/build-fuxi-usb-debug.py b/ios17/overlay/scripts/build-fuxi-usb-debug.py
new file mode 100644
index 0000000..25cdc6d
--- /dev/null
+++ b/ios17/overlay/scripts/build-fuxi-usb-debug.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""Build and qualify the selected fuxi USB archive using actual XNU records."""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import time
+
+root = Path(__file__).resolve().parents[1]
+module = root / '.cache/fuxi-qud-module'
+# A restored link-only reference already has compile records, so the framework
+# may skip its bootstrap recipe. Stage/apply USB before this archive as well.
+subprocess.run([sys.executable, root / 'scripts/prepare-fuxi-usb-debug.py',
+                '--module', root / 'drivers/QcomXnuUsbDebug', '--xnu', root / 'refer/xnu',
+                '--output', module], check=True)
+# iOS 17 fileset: the kernel __DATA has to fit ahead of the retained kext data of the original
+# collection (0x171070 bytes on 21H16), so the 4 MiB log ring and the 16 MiB screenshot buffer shrink.
+for relative, old, new in (('kernel/QcomUsbBuffer.h', '#define SOC_USB_LOG_BUFFER_BYTES (4u * 1024u * 1024u)',
+                            '#define SOC_USB_LOG_BUFFER_BYTES (192u * 1024u)'),
+                           ('include/QcomUsbScreenshot.h', '#define QUD_SCREENSHOT_MAX_BYTES (16u * 1024u * 1024u)',
+                            '#define QUD_SCREENSHOT_MAX_BYTES (16u * 1024u)'),
+                           ('tests/test_usb_buffer.c', 'ring.used == 4u * 1024u * 1024u',
+                            'ring.used == SOC_USB_LOG_BUFFER_BYTES')):
+    header = module / relative
+    text = header.read_text()
+    if old in text:
+        header.write_text(text.replace(old, new, 1))
+    elif new not in text:
+        raise SystemExit(f'{relative}: buffer size anchor changed')
+# Only the iOS 17 fuxi archive opts into the post-drain hook.
+shutil.copy2(root / 'kits/sheng/BootResetCore.h', module / 'kernel/BootResetCore.h')
+board_header = module / 'soc/FuxiSm8550.h'
+if 'FUXI_PANIC_FASTBOOT' not in board_header.read_text():
+    with board_header.open('a') as stream:
+        stream.write('\n#define FUXI_PANIC_FASTBOOT 1\n')
+if 'fuxi_panic_fastboot(void)' not in (module / 'kernel/QcomXnuUsbDebug.c').read_text():
+    subprocess.run(['patch','-p1','--batch'],cwd=module,input='--- a/kernel/QcomXnuUsbDebug.c\n+++ b/kernel/QcomXnuUsbDebug.c\n@@ -102,6 +102,44 @@\n #endif\n     for (;;) __asm__ volatile("wfe" ::: "memory");\n }\n+\n+#ifdef FUXI_PANIC_FASTBOOT\n+/* Prepare mappings in normal context. No allocation or thread services after panic. */\n+#include "BootResetCore.h"\n+static struct br_arbiter reset_arb;\n+static volatile uint32_t *reset_obs, *reset_chn;\n+static void fuxi_prepare_fastboot(void)\n+{\n+    int seconds = 0;\n+    struct br_found f;\n+    if (!PE_parse_boot_argn("fuxi-panic-fastboot", &seconds, sizeof(seconds)) || seconds != 30)\n+        return;\n+    reset_arb.core = (void *)ml_io_map(0xc400000, 0x3000);\n+    reset_arb.cnfg = (void *)ml_io_map(0xc42d000, 0x4000);\n+    if (!reset_arb.core || !reset_arb.cnfg || br_find(&reset_arb, &f) || f.owner != 0)\n+        return;\n+    unsigned off = BR_OBS_APID_STRIDE * (unsigned)f.apid;\n+    vm_offset_t obs = ml_io_map(0xc440000 + (off & ~4095u), 4096);\n+    if (!obs) return;\n+    reset_obs = (void *)(obs + (off & 4095u));\n+    reset_chn = (void *)ml_io_map(0xc500000 + BR_CHNL_APID_STRIDE * (unsigned)f.apid, 4096);\n+}\n+static void fuxi_panic_fastboot(void)\n+{\n+    uint8_t before, after;\n+    uint64_t hz = native.status.counter_frequency;\n+    if (!reset_obs || !reset_chn || !hz || hz > COUNTER_MAX_FREQUENCY) return;\n+    uint64_t start = counter();\n+    while (counter() - start < 30 * hz) __asm__ volatile("yield" ::: "memory");\n+    /* Both pointers already select this APID, EE0, so channel offset is zero. */\n+    if (br_set_bootloader(reset_obs, reset_chn, &reset_arb, 0, &before, &after)) return;\n+    __asm__ volatile("movz w0, #9\\nmovk w0, #0x8400, lsl #16\\n"\n+                     "mov x1, xzr\\nmov x2, xzr\\nmov x3, xzr\\ndsb sy\\nsmc #0"\n+                     ::: "x0","x1","x2","x3","x4","x5","x6","x7","x8","x9",\n+                         "x10","x11","x12","x13","x14","x15","x16","x17","memory","cc");\n+}\n+#endif\n+\n static int qcom_usb_control_halt_restart(unsigned int type)\n {\n     if (type == CONTROL_PE_RESTART_CPU &&\n@@ -808,6 +846,9 @@\n     usb_diag_polling = 0;\n     if (usb_diag_mode >= 201u && usb_diag_mode <= 203u) diag_reset(12);\n     diag_checkpoint(QCOM_USB_DEBUG_DIAG_ENUM_DONE);\n+#ifdef FUXI_PANIC_FASTBOOT\n+    fuxi_prepare_fastboot();\n+#endif\n     native.status.phase = QCOM_USB_DEBUG_ACTIVE;\n     ret = 1;\n out:\n@@ -1270,6 +1311,9 @@\n     static const char end[] = "\\nQCOM PANIC END\\n";\n     uint64_t flags, now;\n     unsigned int iterations = 200000u, marker_queued = 0, announced = 0;\n+#ifdef FUXI_PANIC_FASTBOOT\n+    int finished = 0;\n+#endif\n     char announcement[192];\n     size_t announcement_bytes;\n     if (usb_diag_enabled && (native.status.phase == QCOM_USB_DEBUG_PREPARING ||\n@@ -1307,7 +1351,12 @@\n         }\n         if (!poll_owned()) break;\n         if (marker_queued && dwc3_queued(native.core) == 0 &&\n-            soc_usb_buffer_pending(&usb_log_buffer) == 0) break;\n+            soc_usb_buffer_pending(&usb_log_buffer) == 0) {\n+#ifdef FUXI_PANIC_FASTBOOT\n+            finished = 1;\n+#endif\n+            break;\n+        }\n         delay_us(0, 10);\n     }\n     native.deadline_active = 0;\n@@ -1318,6 +1367,9 @@\n out:\n     buffer_status_owned();\n     release(flags);\n+#ifdef FUXI_PANIC_FASTBOOT\n+    if (finished) fuxi_panic_fastboot();\n+#endif\n     if (usb_diag_enabled) diag_reset(10);\n }\n int qcom_usb_debug_stop(void)\n',text=True,check=True)
+
+patcher = module / 'scripts/xnu_patches.py'
+state = json.loads(subprocess.check_output([sys.executable, patcher, 'status',
+                   '--xnu', root / '.cache/xnu-work', '--profile', 'darwin23-fuxi'], text=True))
+if state['state_before'] == 'ready':
+    subprocess.run([sys.executable, patcher, 'apply', '--xnu', root / '.cache/xnu-work',
+                    '--profile', 'darwin23-fuxi'], check=True)
+elif state['state_before'] != 'applied':
+    raise SystemExit('USB source integration is not ready: '+str(state))
+out = root / '.cache/fuxi-qud-build'
+records = root / 'build/xnu/ios-obj/DEVELOPMENT_ARM64_BCM2837'
+llvm = Path('/opt/homebrew/opt/llvm/bin')
+if not llvm.is_dir():
+    # Linux host: the framework's toolchain provides llvm-config. Its clang is the host
+    # compiler the kit's tests must use, and /usr/bin has to come before the cross tools
+    # so the host link gets the ELF linker rather than cctools' Mach-O ld.
+    llvm = Path(subprocess.check_output(['llvm-config', '--bindir'], text=True).strip())
+    os.environ['PATH'] = (str(llvm) + os.pathsep + '/usr/bin' + os.pathsep
+                          + os.environ.get('PATH', ''))
+    # check.py builds its host tests with -std=c11, which hides posix_memalign behind
+    # glibc's feature-test macros; Apple's headers always declare it.
+    staged_check = module / 'tests/check.py'
+    if staged_check.is_file():
+        source = staged_check.read_text()
+        if '-D_POSIX_C_SOURCE' not in source and "'-std=c11'," in source:
+            staged_check.write_text(source.replace("'-std=c11',",
+                                                 "'-std=c11', '-D_POSIX_C_SOURCE=200809L',", 1))
+def run(arguments, host=False):
+    command = [str(v) for v in arguments]
+    env = os.environ.copy()
+    if host:
+        env.pop('CCC_OVERRIDE_OPTIONS', None)
+    result = subprocess.run(command, cwd=root, env=env, capture_output=True, text=True)
+    print(result.stdout, end='')
+    if result.returncode:
+        print(result.stderr, end='')
+        for base in (out, root / '.cache/fuxi-qud-xnu-check'):
+            if base.is_dir():
+                for log in base.glob('*.log'):
+                    content = log.read_text(errors='replace')
+                    if 'error:' in content:
+                        print(log.name, content[-6500:])
+        raise SystemExit(result.returncode)
+
+# The upstream checks require a new output directory on every run.
+for previous in (root / '.cache/fuxi-qud-model-check', out, root / '.cache/fuxi-qud-xnu-check'):
+    if previous.exists():
+        previous.rename(previous.with_name(previous.name + '.previous-' + str(time.time_ns())))
+
+run([sys.executable, module / 'tests/check.py', '--target-clang', llvm / 'clang',
+     '--output', root / '.cache/fuxi-qud-model-check'], host=True)
+matches = list(records.glob('**/pe_kprintf.o.json'))
+if len(matches) != 1:
+    raise SystemExit('missing or ambiguous actual PE compile record')
+run([sys.executable, module / 'scripts/build.py', '--compile-record', matches[0],
+     '--soc', 'soc/FuxiSm8550.h', '--ar', llvm / 'llvm-ar', '--nm', llvm / 'llvm-nm', '--output', out])
+run([sys.executable, module / 'tests/check_xnu.py', '--xnu', root / '.cache/xnu-work',
+     '--records', records, '--archive', out / 'libQcomXnuUsbDebug.a', '--nm', llvm / 'llvm-nm',
+     '--output', root / '.cache/fuxi-qud-xnu-check'])
+for name in ('check-report.json', 'xnu-check-report.json'):
+    directory = root / ('.cache/fuxi-qud-model-check' if name == 'check-report.json' else '.cache/fuxi-qud-xnu-check')
+    print((directory / name).read_text())
+print((out / 'build-report.json').read_text())
+print('PASS: fuxi QcomXnuUsbDebug archive, models and six-unit enabled/disabled XNU integration')
diff --git a/ios17/overlay/scripts/build-ios17-stubs.py b/ios17/overlay/scripts/build-ios17-stubs.py
new file mode 100644
index 0000000..89f26a7
--- /dev/null
+++ b/ios17/overlay/scripts/build-ios17-stubs.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Absent-subsystem stubs for the iOS 17 checkpoint-1 kernel (arm64e).
+
+BootLog.c weakly imports the sheng/fuxi dashboard subsystems (display, Adreno, touch, UFS log window,
+boot progress). On arm64 an unresolved weak import links as NULL; on arm64e the linker cannot sign a
+pointer to an undefined symbol, so every one of them needs a definition. package/BootLogStubs.c and
+package/LegacyDisplayStub.c are the existing empty definitions; this adds the UFS log window and the
+touch probe, whose drivers this checkpoint leaves out. The UFS functions report failure, so BootLog
+keeps its RAM ring only.
+"""
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'scripts'))
+from kernel_target import TRIPLE, check_object
+
+out = ROOT / 'build/ios17-stubs'
+out.mkdir(parents=True, exist_ok=True)
+extra = out / 'Ios17AbsentStubs.c'
+extra.write_text('''#include <stdint.h>
+int native_ufs_log_open(uint64_t *first, uint64_t *count, const char **why) { if (why) *why = "no UFS (ios17 checkpoint)"; (void)first; (void)count; return -1; }
+int native_ufs_log_write(uint64_t lba, uint32_t blocks, const void *data) { (void)lba; (void)blocks; (void)data; return -1; }
+uint64_t native_ufs_export_blocks(void) { return 0; }
+int native_ufs_export_write(uint64_t lba, uint32_t blocks, const void *data) { (void)lba; (void)blocks; (void)data; return -1; }
+int native_ufs_log_sync(void) { return -1; }
+unsigned native_ufs_store_gpt_check(void) { return 0; }
+volatile uint32_t native_data_persist_state, native_data_persist_header, native_data_persist_gpt, native_data_persist_gpt_after;
+volatile uint64_t native_data_persist_pages, native_data_persist_loaded, native_data_persist_writes, native_data_persist_syncs,
+    native_data_persist_errors, native_data_persist_first_lba, native_data_persist_present;
+volatile uint32_t native_process_wait_port[10];
+volatile int32_t fuxi_buttons_stats[10];
+void native_touch_probe(void) {}
+''')
+# The device package (the tree's package/ is the framework's); the build driver exports UNIXNU_DEVICE.
+package = Path(os.environ['UNIXNU_DEVICE']) / 'package' if os.environ.get('UNIXNU_DEVICE') else ROOT / 'kits/sheng'
+sources = [package / 'BootLogStubs.c', package / 'LegacyDisplayStub.c', extra]
+objects = []
+for source in sources:
+    obj = out / (source.stem + '.o')
+    subprocess.run(['xcrun', 'clang', '-target', TRIPLE, '-mkernel', '-ffreestanding', '-O2', '-Wno-everything',
+                    '-c', str(source), '-o', str(obj)], check=True)
+    check_object(obj.read_bytes(), source.name)
+    objects.append(obj)
+archive = out / 'libIos17Stubs.a'
+archive.unlink(missing_ok=True)
+subprocess.run(['xcrun', 'libtool', '-static', '-o', str(archive), *map(str, objects)], check=True)
+print(archive)
