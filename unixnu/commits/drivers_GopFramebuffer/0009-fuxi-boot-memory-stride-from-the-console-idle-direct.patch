From 8f0fe0f4bd5e44c317569c22209704fddd197237 Mon Sep 17 00:00:00 2001
From: fuxi <fuxi@localhost>
Date: Fri, 20 Nov 2026 20:03:07 -0600
Subject: [PATCH 09/10] fuxi: boot memory stride from the console; idle direct
 scanout returns to it (experiment)

---
 NativeLegacyDisplay.cpp | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/NativeLegacyDisplay.cpp b/NativeLegacyDisplay.cpp
index 21c070b..b3a5075 100644
--- a/NativeLegacyDisplay.cpp
+++ b/NativeLegacyDisplay.cpp
@@ -410,8 +410,16 @@ class NativeLegacyDisplay : public IOMobileFramebufferLegacy {
     unsigned directTries=0,heartBeats=0;
     IOTimerEventSource *heartTimer=nullptr;
     static void heartFired(OSObject *owner,IOTimerEventSource *) {static_cast<NativeLegacyDisplay *>(owner)->heartTick();}
+    uint64_t lastFlipAt=0;
     void heartTick() {
         ++heartBeats;
+        // fuxi 2026-11-20 experiment (U36): with no direct flip for 1 s, the pipes go back to the boot loader's memory (the copy path's
+        // state, which lives): does the reset need the display to keep fetching the compositor's surface while nothing is presented?
+        if(directOn && !directBoot && !latchRequest && lastFlipAt) {
+            uint64_t ns=0;absolutetime_to_nanoseconds(mach_absolute_time()-lastFlipAt,&ns);
+            unsigned idleBack=1;PE_parse_boot_argn("fuxi-direct-idle-boot",&idleBack,sizeof(idleBack));
+            if(idleBack==1 && ns>=1000000000ull){directToBoot();IOLog("fuxi direct: idle 1 s, back to the boot memory\n");}
+        }
         // MDP top (0xae01000): +0x10 interrupt status, CTL0 flush (+0x15018), VIG0/1 status (+0x4000/+0x6000 + 0x2c, SSPP_SRC_ADDR at +0x14).
         IOLog("fuxi direct: beat %u fsr %#x far %#x ctlflush %#x intr %#x vig0 %#x/%#x vig1 %#x/%#x shown %d pending %d latch %d\n",heartBeats,
               &native_ufs_dpu_live?native_ufs_dpu_live(1):0u,&native_ufs_dpu_live?native_ufs_dpu_live(2):0u,mdp[kCtlFlush/4],mdp[0x10/4],
@@ -571,7 +579,9 @@ class NativeLegacyDisplay : public IOMobileFramebufferLegacy {
     // Back to the boot loader's memory (the blank frame and the copy are drawn there).
     void directToBoot() {
         if(!directOn || directBoot)return;
-        flip(kBootIova,kBootStride);directBoot=true;shownSlot=-1;
+        // fuxi 2026-11-20: kBootStride is sheng's (3048 px); the boot loader's framebuffer here is 1080 px, 4320 bytes a row.
+        PE_Video video={};const uint32_t stride=!PE_current_console(&video) && video.v_rowBytes?uint32_t(video.v_rowBytes):kBootStride;
+        flip(kBootIova,stride);directBoot=true;shownSlot=-1;
         native_legacy_direct[8]=native_legacy_direct[8]+1;
     }
     bool vsyncWanted() const {
@@ -831,7 +841,7 @@ public:
                 {static unsigned flips;if(flips++<20)IOLog("fuxi direct: flip %u slot %d iova %#x stride %llu bytes %llu w %u h %u fsr %#x\n",flips,slot,
                     directSlots[slot].iova,(unsigned long long)sourceStride,(unsigned long long)memory->getLength(),width,height,
                     &native_ufs_dpu_live?native_ufs_dpu_live(1):0u);}
-                flip(directSlots[slot].iova,uint32_t(sourceStride));directBoot=false;
+                flip(directSlots[slot].iova,uint32_t(sourceStride));directBoot=false;lastFlipAt=mach_absolute_time();
                 native_legacy_direct[0]=native_legacy_direct[0]+1;
                 stat(9);note(4,slot,request);noteFlipDelay(request);
                 shadowValid=false;pendingSlot=slot;latchRequest=request;transferred=true;
-- 
