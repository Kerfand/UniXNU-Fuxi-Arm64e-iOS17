From f7c113696c7c05d013419d1365212763c1644e24 Mon Sep 17 00:00:00 2001
From: fuxi <fuxi@localhost>
Date: Fri, 20 Nov 2026 19:54:05 -0600
Subject: [PATCH 08/10] fuxi: port upstream df4a905 direct display fence wait
 and cancellation reset

---
 NativeLegacyDisplay.cpp | 22 ++++++++++++++++------
 1 file changed, 16 insertions(+), 6 deletions(-)

diff --git a/NativeLegacyDisplay.cpp b/NativeLegacyDisplay.cpp
index dac143d..21c070b 100644
--- a/NativeLegacyDisplay.cpp
+++ b/NativeLegacyDisplay.cpp
@@ -404,6 +404,7 @@ class NativeLegacyDisplay : public IOMobileFramebufferLegacy {
     const OriginalLegacySwapRequest *fenceFor=nullptr;
     uint32_t fenceTarget=0;
     uint64_t fenceSince=0;
+    bool fenceCaptured=false,fenceSlow=false;   // upstream df4a905: keep the first fence snapshot across polls; 250 ms no longer flips
     IOTimerEventSource *fenceTimer=nullptr;
     bool directOn=false,directBoot=true;
     unsigned directTries=0,heartBeats=0;
@@ -499,13 +500,18 @@ class NativeLegacyDisplay : public IOMobileFramebufferLegacy {
         return pick;
     }
     // True once the GPU wrote everything handed to it before this request arrived (or gave up after 250 ms); otherwise arms the poll.
+    // fuxi 2026-11-20, ported from upstream GopFramebuffer df4a905: a failed fence query is not completion, the first successful
+    // snapshot is kept for the request, and a slow GPU leaves the previous frame on screen (no flip of a surface still being written)
+    // until completion or the family's cancellation.
     bool gpuWrote(const OriginalLegacySwapRequest *request) {
-        uint32_t submitted=0,retired=0;
-        if(!&native_adreno_fences || !native_adreno_fences(&submitted,&retired))return true;
         if(fenceFor!=request) {
-            fenceFor=request;fenceTarget=submitted;fenceSince=0;
+            fenceFor=request;fenceTarget=0;fenceSince=0;fenceCaptured=false;fenceSlow=false;
         }
-        if(int32_t(retired-fenceTarget)>=0) {
+        uint32_t submitted=0,retired=0;
+        if(!&native_adreno_fences)return true;   // the CPU-only backend: no GPU fence interface linked
+        const bool known=native_adreno_fences(&submitted,&retired);
+        if(known && !fenceCaptured) {fenceTarget=submitted;fenceCaptured=true;}
+        if(known && fenceCaptured && int32_t(retired-fenceTarget)>=0) {
             if(fenceSince)note(3,-1,request);
             if(fenceSince) {
                 uint64_t ns=0;absolutetime_to_nanoseconds(mach_absolute_time()-fenceSince,&ns);
@@ -518,9 +524,9 @@ class NativeLegacyDisplay : public IOMobileFramebufferLegacy {
         }
         if(!fenceSince) {fenceSince=mach_absolute_time();native_legacy_direct[9]=native_legacy_direct[9]+1;stat(6);note(2,-1,request);}
         uint64_t ns=0;absolutetime_to_nanoseconds(mach_absolute_time()-fenceSince,&ns);
-        if(ns>=250000000ull) {
+        if(ns>=250000000ull && !fenceSlow) {
             native_legacy_direct[12]=native_legacy_direct[12]+1;
-            fenceFor=nullptr;return true;
+            fenceSlow=true;
         }
         fenceTimer->setTimeoutUS(200);
         return false;
@@ -976,6 +982,10 @@ public:
     // frame is not held behind the cancelled one. The family only logs the result; the slot used to be a guard that panicked.
     bool cancelSwapsAfterTimeout() override {
         native_legacy_swap_timeouts=native_legacy_swap_timeouts+1;
+        IOLog("fuxi direct: family cancelled swaps after 5 s (latch %d fence %d)\n",latchRequest?1:0,fenceFor?1:0);
+        // upstream df4a905: a cancelled swap may be the one the fence poll waits for
+        if(fenceTimer)fenceTimer->cancelTimeout();
+        fenceFor=nullptr;fenceTarget=0;fenceSince=0;fenceCaptured=false;fenceSlow=false;
         for(auto &entry: validated)entry=nullptr;
         gpuRequest=nullptr;gpuRetired=false;transferred=false;
         return true;
-- 
