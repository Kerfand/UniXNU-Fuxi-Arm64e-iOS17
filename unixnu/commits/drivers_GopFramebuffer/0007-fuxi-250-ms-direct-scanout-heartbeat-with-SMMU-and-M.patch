From 11e7d104bb068f71e719c58e6ca632878fca93bd Mon Sep 17 00:00:00 2001
From: fuxi <fuxi@localhost>
Date: Fri, 20 Nov 2026 19:43:57 -0600
Subject: [PATCH 07/10] fuxi: 250 ms direct scanout heartbeat with SMMU and MDP
 state

---
 NativeLegacyDisplay.cpp | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/NativeLegacyDisplay.cpp b/NativeLegacyDisplay.cpp
index c04afde..dac143d 100644
--- a/NativeLegacyDisplay.cpp
+++ b/NativeLegacyDisplay.cpp
@@ -406,7 +406,17 @@ class NativeLegacyDisplay : public IOMobileFramebufferLegacy {
     uint64_t fenceSince=0;
     IOTimerEventSource *fenceTimer=nullptr;
     bool directOn=false,directBoot=true;
-    unsigned directTries=0;
+    unsigned directTries=0,heartBeats=0;
+    IOTimerEventSource *heartTimer=nullptr;
+    static void heartFired(OSObject *owner,IOTimerEventSource *) {static_cast<NativeLegacyDisplay *>(owner)->heartTick();}
+    void heartTick() {
+        ++heartBeats;
+        // MDP top (0xae01000): +0x10 interrupt status, CTL0 flush (+0x15018), VIG0/1 status (+0x4000/+0x6000 + 0x2c, SSPP_SRC_ADDR at +0x14).
+        IOLog("fuxi direct: beat %u fsr %#x far %#x ctlflush %#x intr %#x vig0 %#x/%#x vig1 %#x/%#x shown %d pending %d latch %d\n",heartBeats,
+              &native_ufs_dpu_live?native_ufs_dpu_live(1):0u,&native_ufs_dpu_live?native_ufs_dpu_live(2):0u,mdp[kCtlFlush/4],mdp[0x10/4],
+              mdp[(kVig[0]+0x14)/4],mdp[(kVig[0]+0x2c)/4],mdp[(kVig[1]+0x14)/4],mdp[(kVig[1]+0x2c)/4],shownSlot,pendingSlot,latchRequest?1:0);
+        if(heartBeats<2400)heartTimer->setTimeoutMS(250);
+    }
     static constexpr uint32_t kVig[2]={0x4000,0x6000},kCtlFlush=0x15018,kBootIova=0xb8000000U,kBootStride=0x2fa0;
     void startDirect() {
         unsigned mode=0;PE_parse_boot_argn("sheng-dpu-scanout",&mode,sizeof(mode));
@@ -431,6 +441,12 @@ class NativeLegacyDisplay : public IOMobileFramebufferLegacy {
         mdp=reinterpret_cast<volatile uint32_t *>(mdpMap->getVirtualAddress());
         directOn=true;gDirectDisplay=this;
         IOLog("fuxi direct: on (state %#x, scaled %d)\n",(unsigned)native_ufs_dpu_state,gScaled?1:0);
+        // fuxi 2026-11-20: every boot with direct flips reset ~7 s after the first one, no panic (U30-U33, also without DSI brightness). A
+        // heartbeat every 250 ms with the display bank's fault state and the MDP's CTL flush, interrupt status and both pipes' fetch state
+        // shows the last moment and what changed before it.
+        if(!heartTimer && (heartTimer=IOTimerEventSource::timerEventSource(this,&NativeLegacyDisplay::heartFired))) {
+            if(loop->addEventSource(heartTimer)==kIOReturnSuccess)heartTimer->setTimeoutMS(250);else OSSafeReleaseNULL(heartTimer);
+        }
     }
     // The diagnostic screenshot reads the boot memory, which the display no longer scans: draw the surface on screen into it (rows of the
     // visible width) so the picture shows what the panel shows.
-- 
