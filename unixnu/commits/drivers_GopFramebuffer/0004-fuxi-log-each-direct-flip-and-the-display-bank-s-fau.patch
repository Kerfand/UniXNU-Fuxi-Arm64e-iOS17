From e38ceb8efc6e26d7e5a08df138b3aafaa3b8c734 Mon Sep 17 00:00:00 2001
From: fuxi <fuxi@localhost>
Date: Fri, 20 Nov 2026 10:06:25 -0600
Subject: [PATCH 04/10] fuxi: log each direct flip and the display bank's fault
 state after each latch

---
 NativeLegacyDisplay.cpp | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/NativeLegacyDisplay.cpp b/NativeLegacyDisplay.cpp
index 6b98cf1..c07fcd7 100644
--- a/NativeLegacyDisplay.cpp
+++ b/NativeLegacyDisplay.cpp
@@ -52,6 +52,7 @@ extern "C" {volatile uint32_t native_legacy_surfaces[14];}
 // [9] swaps held back until the GPU had written the frame (the compositor submits the swap when the command buffer is scheduled), [10] total
 // and [11] longest wait (us), [12] waits that gave up after 250 ms, [13] waits of 8 ms or more (longer than a refresh at 120 Hz: the frame missed a flip).
 extern "C" {volatile uint32_t native_legacy_direct[14];}
+extern "C" uint32_t native_ufs_dpu_live(unsigned reg) __attribute__((weak_import));
 extern "C" bool native_adreno_fences(uint32_t *submitted,uint32_t *retired) __attribute__((weak_import));
 // The swap lifecycle: native_legacy_ring holds the newest native_legacy_ring_cap events (allocated at start: a static array of this size no longer fits the kernel's data segment), {[0] microseconds since boot (64 bit), [1] event << 56 | slot + 1 << 48 |
 // swaps validated and not retired << 40 | GPU fences outstanding << 24 | the request's tag (24 bits)}. Events: 1 swap validated, 2 fence wait
@@ -520,6 +521,19 @@ class NativeLegacyDisplay : public IOMobileFramebufferLegacy {
         if(us>native_legacy_direct[4])native_legacy_direct[4]=us;
         native_legacy_direct[5]=native_legacy_direct[5]+us;
         shownSlot=pendingSlot;pendingSlot=-1;
+        // fuxi 2026-11-20: the display bank's fault state after each latch (first 40, then every fault, at most 200 rows): U30 reset a few
+        // frames after the first direct flip.
+        if(&native_ufs_dpu_live) {
+            static unsigned rows,faults;
+            const uint32_t fsr=native_ufs_dpu_live(1);
+            if(rows<40 || ((fsr&0xc00001feu) && faults<200)) {
+                ++rows;if(fsr&0xc00001feu)++faults;
+                IOLog("fuxi direct: latch slot %d iova %#x stride %u us %u fsr %#x far %#x%08x fsynr %#x sctlr %#x\n",shownSlot,
+                      shownSlot>=0?directSlots[shownSlot].iova:0u,shownStride,uint32_t(ns/1000),fsr,native_ufs_dpu_live(3),native_ufs_dpu_live(2),
+                      native_ufs_dpu_live(4),native_ufs_dpu_live(0));
+                if(fsr&0xc00001feu)native_ufs_dpu_live(5);
+            }
+        }
         stat(10);note(5,shownSlot,latchRequest);
         const OriginalLegacySwapRequest *request=latchRequest;latchRequest=nullptr;
         finishTransfer(request,true);
@@ -784,6 +798,9 @@ public:
             const int slot=directSlot(surface,memory);
             if(slot>=0) {
                 native_legacy_swap_stage(1);
+                {static unsigned flips;if(flips++<20)IOLog("fuxi direct: flip %u slot %d iova %#x stride %llu bytes %llu w %u h %u fsr %#x\n",flips,slot,
+                    directSlots[slot].iova,(unsigned long long)sourceStride,(unsigned long long)memory->getLength(),width,height,
+                    &native_ufs_dpu_live?native_ufs_dpu_live(1):0u);}
                 flip(directSlots[slot].iova,uint32_t(sourceStride));directBoot=false;
                 native_legacy_direct[0]=native_legacy_direct[0]+1;
                 stat(9);note(4,slot,request);noteFlipDelay(request);
-- 
