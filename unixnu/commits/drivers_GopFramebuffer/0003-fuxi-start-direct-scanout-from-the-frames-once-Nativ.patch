From e0da5000b619f795e91d2fdfc562b4daa442c7e6 Mon Sep 17 00:00:00 2001
From: fuxi <fuxi@localhost>
Date: Fri, 20 Nov 2026 09:53:02 -0600
Subject: [PATCH 03/10] fuxi: start direct scanout from the frames once
 NativeUfs has the display window

---
 NativeLegacyDisplay.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/NativeLegacyDisplay.cpp b/NativeLegacyDisplay.cpp
index 478acc7..6b98cf1 100644
--- a/NativeLegacyDisplay.cpp
+++ b/NativeLegacyDisplay.cpp
@@ -405,6 +405,7 @@ class NativeLegacyDisplay : public IOMobileFramebufferLegacy {
     uint64_t fenceSince=0;
     IOTimerEventSource *fenceTimer=nullptr;
     bool directOn=false,directBoot=true;
+    unsigned directTries=0;
     static constexpr uint32_t kVig[2]={0x4000,0x6000},kCtlFlush=0x15018,kBootIova=0xb8000000U,kBootStride=0x2fa0;
     void startDirect() {
         unsigned mode=0;PE_parse_boot_argn("sheng-dpu-scanout",&mode,sizeof(mode));
@@ -766,6 +767,12 @@ public:
         noteSurface(surface,memory);
         const bool half=nativeHalf(native_legacy_surface_format(surface),native_legacy_surface_planes(surface));
         const bool xr=nativeXr(native_legacy_surface_format(surface),native_legacy_surface_planes(surface));
+        // fuxi 2026-11-20: NativeUfs gives the display bank its window after this display started (U29: "off at start: state 0", then
+        // NativeUfs "state 0x80000003"), so start() was too early: try again from the frames until the window is there.
+        if(!directOn && directTries<1000 && &native_ufs_dpu_state && (native_ufs_dpu_state>>31)) {
+            ++directTries;startDirect();
+            if(directOn)IOLog("fuxi direct: on (try %u)\n",directTries);
+        }
         // fuxi 2026-11-20: why a frame does not flip directly, once per distinct reason set (bits: 1 off, 2 half, 4 xr, 8 GPU bypass, 16 latch
         // in flight, 32 scaled), with the surface's format and planes.
         {static uint64_t seen;const uint32_t why=(directOn?0u:1u)|(half?2u:0u)|(xr?4u:0u)|(gpuBypass?8u:0u)|(latchRequest?16u:0u)|(gScaled?32u:0u);
