@@ -41,6 +41,7 @@ class NativeGOPPresenter : public IOService {
     IOService *memorySource=nullptr;
     // GPU hand-off (sheng-fb-gpu=1): one offered frame at a time, from the display driver to the privileged client.
     bool gpuMode=false,gpuClient=false;
+    task_t clientTask=TASK_NULL;   // fuxi 2026-11-15: the task that waits for frames (not referenced: compared only)
     struct {bool offered,delivered;uint64_t sequence;void *display;IOMemoryDescriptor *memory;IOMemoryMap *map;
             uint64_t stride;uint32_t width,height,format;} swap={};
     uint64_t swapSequence=0;
@@ -55,6 +56,13 @@ class NativeGOPPresenter : public IOService {
     IOReturn waitSwap(task_t,uint64_t timeoutMs,NGPSwap *);
     IOReturn completeSwap(uint64_t sequence,int status);
     void abandonSwap();
+public:
+    void abandonIfClient(task_t task) {
+        if(!gate)return;
+        IOLockLock(gate);const bool mine=clientTask==task;if(mine)clientTask=TASK_NULL;IOLockUnlock(gate);
+        if(mine) {IOLog("NativeGOPPresenter: GPU client closed with the hand-off; outstanding swap abandoned\n");abandonSwap();}
+    }
+protected:
 public:
     void setMemorySource(IOService *source) {memorySource=source;}
     static IOReturn handoffCall(uint32_t op,task_t task,const void *in,size_t inSize,void *out,size_t outSize);
@@ -160,7 +168,7 @@ IOReturn NativeGOPPresenter::waitSwap(task_t task,uint64_t timeoutMs,NGPSwap *ou
     const uint64_t began=mach_absolute_time();
     native_gop_wait_stats[0]=native_gop_wait_stats[0]+1;native_gop_wait_stats[2]=timeoutMs;
     IOLockLock(gate);
-    gpuClient=true;
+    gpuClient=true;clientTask=task;
     while(online && (!swap.offered || swap.delivered)) {
         const wait_result_t woke=IOLockSleepDeadline(gate,&swap,deadline,THREAD_ABORTSAFE);
         if(woke!=THREAD_AWAKENED) {
@@ -249,6 +257,13 @@ void NativeGOPPresenter::abandonSwap() {
     __atomic_fetch_add(&native_gop_gpu_abandoned,1,__ATOMIC_RELAXED);
     native_legacy_gpu_complete(done.display,kIOReturnAborted);
 }
+// fuxi 2026-11-15: the GPU client that waited for frames through the Adreno tunnel closed (its process ended): its swap is abandoned,
+// so the display driver takes its own path for that frame instead of waiting for it forever.
+extern "C" void native_gop_handoff_abandon(task_t task) {
+    NativeGOPPresenter *p=gHandoff;
+    if(!p || !task)return;
+    p->abandonIfClient(task);
+}
 extern "C" void native_gop_presenter_set_source(IOService *presenter,IOService *nub) {
     if(NativeGOPPresenter *p=OSDynamicCast(NativeGOPPresenter,presenter))p->setMemorySource(nub);
 }
@@ -259,6 +274,7 @@ extern "C" bool native_gop_gpu_offer(IOService *presenter,void *display,IOMemory
 // Entry points for the GPU client that reaches the hand-off through an already admitted connection (the Adreno accelerator's user client, which
 // the original sandbox profiles allow where they do not allow this service): op 0 mode, 2 wait for a frame, 3 complete it (the NGP_METHOD_*
 // numbers). Same checks as the service's own methods; sizes are the wire records'.
+extern "C" void proc_selfname(char *, int);
 IOReturn NativeGOPPresenter::handoffCall(uint32_t op,task_t task,const void *in,size_t inSize,void *out,size_t outSize) {
     NativeGOPPresenter *p=gHandoff;
     if(!p || !p->gpuMode || !p->online)return kIOReturnNotReady;
@@ -277,6 +293,18 @@ IOReturn NativeGOPPresenter::handoffCall(uint32_t op,task_t task,const void *in,
         NGPComplete q={};memcpy(&q,in,sizeof(q));
         return p->completeSwap(q.sequence,(int)q.status);
     }
+    case NGP_METHOD_NOTE: {
+        if(!in || !inSize || inSize>160 || outSize)return kIOReturnBadArgument;
+        static volatile int left=64;
+        if(left>0) {
+            left=left-1;
+            char text[161]={};memcpy(text,in,inSize);
+            for(size_t i=0;i<inSize;++i)if(text[i]=='\n' || text[i]=='\r')text[i]=' ';
+            char name[20]={};proc_selfname(name,sizeof name);
+            IOLog("fuxi gpu present note: %s %s\n",name,text);
+        }
+        return kIOReturnSuccess;
+    }
     default:return kIOReturnUnsupported;
     }
 }
diff --git a/NativeGOPWire.h b/NativeGOPWire.h
index 0ce3c04..58a89b6 100644
--- a/NativeGOPWire.h
+++ b/NativeGOPWire.h
@@ -11,7 +11,8 @@ struct NGPTransfer {uint64_t sequence,bytes;};
 // GPU hand-off (boot-arg sheng-fb-gpu=1): the display driver offers a finished frame instead of copying it. A privileged client waits for it
 // (selector 2: the frame's pages are mapped read/write into the caller, at address), lets the GPU copy it into the scanout mapping (client
 // memory type 1, writable) and then completes it (selector 3), which retires the swap. Nothing here copies pixels.
-enum { NGP_METHOD_MODE=0,NGP_METHOD_PRESENT=1,NGP_METHOD_WAIT_SWAP=2,NGP_METHOD_COMPLETE_SWAP=3,NGP_MEMORY_SCANOUT_RW=1 };
+// NGP_METHOD_NOTE (fuxi 2026-11-15): a short text (at most 160 bytes) from the GPU client for the kernel log: why a copy failed.
+enum { NGP_METHOD_MODE=0,NGP_METHOD_PRESENT=1,NGP_METHOD_WAIT_SWAP=2,NGP_METHOD_COMPLETE_SWAP=3,NGP_METHOD_NOTE=4,NGP_MEMORY_SCANOUT_RW=1 };
 struct NGPWait {uint64_t timeout_ms;};
 struct NGPSwap {uint64_t sequence,address,bytes,stride;uint32_t width,height,format,reserved;};
 struct NGPComplete {uint64_t sequence;uint32_t status,reserved;};
