diff --git a/NativeAdrenoSubmit.cpp b/NativeAdrenoSubmit.cpp
index df7035e..f366236 100644
--- a/NativeAdrenoSubmit.cpp
+++ b/NativeAdrenoSubmit.cpp
@@ -29,6 +29,52 @@ extern "C" {volatile uint32_t native_adreno_fence_wait[8];}
  * The last 4: the map handle that was next when the stalled job was submitted, then the handles of the mappings under the BR IB1, the BV IB1
  * and the BV IB2 (0: unmapped). A handle at or above the first was mapped after the submission: its memory was freed and reused under the GPU. */
 extern "C" {volatile uint32_t native_adreno_stall[2+NativeAdrenoRingStallWords];volatile uint32_t native_adreno_stall_mem[4+3*17+4];}
+/* fuxi 2026-11-15 probe: IB2 calls and draw-state groups whose address is below the user window (high word 0): a truncated
+ * 64-bit GPU address (an SMMU translation fault at 0x1bec0000 froze the GPU under Safari). Read-only; the first 32 are logged. */
+extern "C" void proc_selfname(char *,int);
+static volatile int fuxi_low_left=32;
+static void fuxi_scan_ib(const NativeAdrenoVm *vm,uint64_t iova,size_t bytes,unsigned ib)
+{
+    if(fuxi_low_left<=0 || !vm)return;
+    /* Only the processes that met the fault (Safari, its WebKit processes): peekWords reads a BO without a kernel mapping word by
+     * word from DRAM, which at every submission of every process stalled the boot (ibscan-boot-03873c6d). */
+    {char who[20]={};proc_selfname(who,sizeof who);if(strncmp(who,"MobileSafari",12) && strncmp(who,"com.apple.WebKit",16))return;}
+    uint32_t w[512];
+    const size_t total=bytes/4<2048?bytes/4:2048;
+    size_t base=0,at=0;
+    while(at<total && fuxi_low_left>0) {
+        if(at>=base+512 || at<base) {
+            base=at;const size_t n=total-base<512?total-base:512;
+            if(vm->peekWords(iova+4*base,w,n))return;
+        }
+        const uint32_t h=w[at-base];
+        const uint32_t type=h>>28;
+        size_t count=0;
+        if(type==7) {
+            count=h&0x3fff;const uint32_t op=(h>>16)&0x7f;
+            if((op==0x3f || op==0x43) && count>=3) {
+                uint32_t p[24]={};const size_t take=count<24?count:24;
+                for(size_t k=0;k<take;++k) {
+                    const size_t idx=at+1+k;if(idx>=total)break;
+                    if(idx>=base+512 || idx<base) {base=idx;const size_t n=total-base<512?total-base:512;if(vm->peekWords(iova+4*base,w,n))return;}
+                    p[k]=w[idx-base];
+                }
+                bool low=false;
+                if(op==0x3f) low=p[0] && !p[1];
+                else for(size_t g=0;g+2<take;g+=3) if(p[g+1] && !p[g+2] && (p[g]&0xffff)) low=true;
+                if(low && fuxi_low_left>0) {
+                    fuxi_low_left=fuxi_low_left-1;
+                    char name[20]={};proc_selfname(name,sizeof name);
+                    IOLog("fuxi gpu low address: %s ib%u %llx +%u op %#x n %u: %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",name,ib,
+                        (unsigned long long)iova,(unsigned)at,op,(unsigned)count,p[0],p[1],p[2],p[3],p[4],p[5],p[6],p[7],p[8]);
+                }
+                if(at>=base+512 || at<base) {base=at;const size_t n=total-base<512?total-base:512;if(vm->peekWords(iova+4*base,w,n))return;}
+            }
+        } else if(type==4) count=h&0x7f;
+        else return;   /* not a packet: stop */
+        at+=1+count;
+    }
+}
 /* 16 words of the IB at start, from 12 dwords before the dword the thread has reached (size minus what remains). */
