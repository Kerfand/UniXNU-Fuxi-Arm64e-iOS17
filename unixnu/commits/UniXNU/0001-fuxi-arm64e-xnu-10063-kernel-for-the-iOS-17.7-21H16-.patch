new file mode 100644
index 0000000..0585842
--- /dev/null
+++ b/patches/xnu-10063-arm64e/arm64e-threaded-starts.patch
@@ -0,0 +1,22 @@
+diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
+--- a/makedefs/MakeInc.def
++++ b/makedefs/MakeInc.def
+@@ -860,9 +860,18 @@
+ # arm64e specific linker flags that should be used only when linking the kernel
+ # (and not the static kernel cache / kcgen)
+ #
++ifeq ($(XNU_KERNEL_CHAINED_FIXUPS),1)
+ LDFLAGS_KERNEL_ONLY_SUBARCH_arm64e = \
+ 	-Wl,-add_split_seg_info \
+ 	-Wl,-kernel
++else
++# A standalone arm64e MH_EXECUTE boots without a kernel collection builder:
++# arm_init rebases and signs __TEXT,__thread_starts, which the classic ld64 emits; the fileset
++# prelink moves the segments by their split-segment relocations.
++LDFLAGS_KERNEL_ONLY_SUBARCH_arm64e = \
++	-Wl,-add_split_seg_info \
++	-Wl,-threaded_starts_section
++endif
+
+ LDFLAGS_KERNEL_ONLY_SUBARCH_x86_64 = \
+ 	-Wl,-add_split_seg_info \
diff --git a/patches/xnu-10063-arm64e/early-security-init-sign.patch b/patches/xnu-10063-arm64e/early-security-init-sign.patch
new file mode 100644
index 0000000..91e6c88
--- /dev/null
+++ b/patches/xnu-10063-arm64e/early-security-init-sign.patch
@@ -0,0 +1,29 @@
+diff --git a/libkern/c++/OSKext.cpp b/libkern/c++/OSKext.cpp
+index 411850b..7a57054 100644
+--- a/libkern/c++/OSKext.cpp
++++ b/libkern/c++/OSKext.cpp
+@@ -39,6 +39,7 @@ extern "C" {
+ #include <vm/vm_map.h>
+ #include <kextd/kextd_mach.h>
+ #include <libkern/kernel_mach_header.h>
++#include <ptrauth.h>
+ #include <libkern/kext_panic_report.h>
+ #include <libkern/kext_request_keys.h>
+ #include <libkern/mkext.h>
+@@ -8483,7 +8484,15 @@ OSKext::start(bool startDependenciesFlag)
+ 			if (!executable) {
+ 				panic("NativePrelink: early security initializer outside module code");
+ 			}
+-			((void (*)(void))target)();
++			/*
++			 * target is an address computed from the prelink property, not a signed function pointer. On arm64e
++			 * this call compiles to blraaz (IA key, zero discriminator), so sign it the same way first; the type
++			 * discriminator macro differs here (0x4a27), which would fail authentication. No-op without ptrauth.
++			 */
++			typedef void (*early_security_init_t)(void);
++			early_security_init_t early_security_init = (early_security_init_t)ptrauth_sign_unauthenticated(
++				(void *)target, ptrauth_key_function_pointer, 0);
++			early_security_init();
+ 	#else
+ 			panic("NativePrelink: early security initializer requires MAC framework");
+ 	#endif
diff --git a/patches/xnu-10063-arm64e/fileset-unmapped-call.patch b/patches/xnu-10063-arm64e/fileset-unmapped-call.patch
new file mode 100644
index 0000000..f039419
--- /dev/null
+++ b/patches/xnu-10063-arm64e/fileset-unmapped-call.patch
@@ -0,0 +1,51 @@
+diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
+index dac0091..0750ea1 100644
+--- a/osfmk/kern/debug.c
++++ b/osfmk/kern/debug.c
+@@ -2273,3 +2273,46 @@ set_awl_scratch_exists_flag_and_subscribe_for_pm(void)
+ 	}
+ }
+ STARTUP(EARLY_BOOT, STARTUP_RANK_MIDDLE, set_awl_scratch_exists_flag_and_subscribe_for_pm);
++
++/*
++ * Target of original kext calls into kernel functions this kernel does not have (fileset emission
++ * redirects them here). The return address is the call site in the original component.
++ *
++ * The entry is assembly so the probe also sees x16: an original component that reaches this stub through a
++ * tail call from an indirect call (blraa/braa x16) leaves the intermediate function's address there.
++ *
++ * Probe: boot-arg unixnu-unmapped=1 logs each call (site, x0..x3, x16) and returns 0 to the caller, so one
++ * boot lists the unmapped calls startup actually reaches. The 64th call, or any call without the
++ * boot-arg, panics with the same message. Returning 0 is not a substitute implementation.
++ */
++__asm__(
++	"	.text\n"
++	"	.globl	_unixnu_fileset_unmapped\n"
++	"	.p2align	2\n"
++	"_unixnu_fileset_unmapped:\n"
++	"	bti	c\n"
++	"	mov	x4, x16\n"
++	"	b	_unixnu_fileset_unmapped_report\n");
++
++static uint32_t unixnu_fileset_unmapped_hits;
++static int unixnu_fileset_unmapped_mode = -1;
++
++__attribute__((noinline, used))
++uint64_t
++unixnu_fileset_unmapped_report(uint64_t arg0, uint64_t arg1, uint64_t arg2, uint64_t arg3, uint64_t x16)
++{
++	void *site = __builtin_ptrauth_strip(__builtin_return_address(0), 0);
++	uint32_t hit = os_atomic_inc(&unixnu_fileset_unmapped_hits, relaxed);
++
++	if (unixnu_fileset_unmapped_mode < 0) {
++		uint32_t mode = 0;
++		unixnu_fileset_unmapped_mode = PE_parse_boot_argn("unixnu-unmapped", &mode, sizeof(mode)) ? (int)mode : 0;
++	}
++	if (unixnu_fileset_unmapped_mode > 0 && hit < 64) {
++		printf("fileset: unmapped call #%u from %p (x0 0x%llx x1 0x%llx x2 0x%llx x3 0x%llx x16 0x%llx); returning 0\n",
++		    hit, site, arg0, arg1, arg2, arg3, (uint64_t)__builtin_ptrauth_strip((void *)x16, 0));
++		return 0;
++	}
++	panic("fileset: original component called an unmapped kernel function from %p (x0 0x%llx x1 0x%llx x16 0x%llx) hit %u",
++	    site, arg0, arg1, (uint64_t)__builtin_ptrauth_strip((void *)x16, 0), hit);
++}
