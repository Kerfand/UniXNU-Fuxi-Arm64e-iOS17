diff --git a/patches/xnu-10063-arm64e/native-pac-keys.patch b/patches/xnu-10063-arm64e/native-pac-keys.patch
new file mode 100644
index 0000000..3cad32d
--- /dev/null
+++ b/patches/xnu-10063-arm64e/native-pac-keys.patch
@@ -0,0 +1,134 @@
+diff --git a/osfmk/arm64/machine_routines_asm.s b/osfmk/arm64/machine_routines_asm.s
+index 575d018..8b8cb11 100644
+--- a/osfmk/arm64/machine_routines_asm.s
++++ b/osfmk/arm64/machine_routines_asm.s
+@@ -93,6 +93,11 @@ Lcre_start_\@:
+ 	.align 2
+ 	.globl EXT(ml_enable_user_jop_key)
+ LEXT(ml_enable_user_jop_key)
++#if HAS_NATIVE_PAC
++	/* The kernel and every process share one key set; nothing to switch. */
++	mov		x0, #0
++	ret
++#endif /* HAS_NATIVE_PAC */
+ #if HAS_PARAVIRTUALIZED_PAC
+ 	mov 	x2, x0
+ 	MOV64	x0, VMAPPLE_PAC_SET_EL0_DIVERSIFIER_AT_EL1
+@@ -109,6 +114,9 @@ LEXT(ml_enable_user_jop_key)
+ 	.align 2
+ 	.globl EXT(ml_disable_user_jop_key)
+ LEXT(ml_disable_user_jop_key)
++#if HAS_NATIVE_PAC
++	ret
++#endif /* HAS_NATIVE_PAC */
+ #if HAS_PARAVIRTUALIZED_PAC
+ 	mov 	x2, x1
+ 	MOV64	x0, VMAPPLE_PAC_SET_EL0_DIVERSIFIER_AT_EL1
+diff --git a/osfmk/arm64/pac_asm.h b/osfmk/arm64/pac_asm.h
+index a52a447..24ec6cc 100644
+--- a/osfmk/arm64/pac_asm.h
++++ b/osfmk/arm64/pac_asm.h
+@@ -43,6 +43,11 @@
+ 
+ #if defined(HAS_APPLE_PAC)
+ 
++#if HAS_NATIVE_PAC
++/* IA, IB, DA, DB and GA keys, two words each */
++#define NATIVE_PAC_KEY_WORDS	10
++#endif /* HAS_NATIVE_PAC */
++
+ 
+ /* BEGIN IGNORE CODESTYLE */
+ 
+@@ -146,6 +151,55 @@
+  *   tmp2 - scratch register
+  */
+ .macro PAC_INIT_KEY_STATE	tmp, tmp2
++#if HAS_NATIVE_PAC
++	/*
++	 * ARMv8.3 keys are shared by EL0 and EL1. The kernel and every process
++	 * use one key set per boot. The first CPU through here derives it from
++	 * the counter with splitmix64; every later entry, including warm resets,
++	 * loads the stored set. The MMU is off on this path, so the stores reach
++	 * memory and later CPUs read them there. Clobbers x2-x6.
++	 */
++	adrp	\tmp, EXT(native_pac_keys)@page
++	add		\tmp, \tmp, EXT(native_pac_keys)@pageoff
++	ldr		\tmp2, [\tmp, #(NATIVE_PAC_KEY_WORDS * 8)]
++	cbnz	\tmp2, 2f
++	mrs		\tmp2, CNTPCT_EL0
++	MOV64	x3, 0x9e3779b97f4a7c15
++	MOV64	x4, 0xbf58476d1ce4e5b9
++	MOV64	x5, 0x94d049bb133111eb
++	mov		x2, #0
++1:
++	add		\tmp2, \tmp2, x3
++	eor		x6, \tmp2, \tmp2, lsr #30
++	mul		x6, x6, x4
++	eor		x6, x6, x6, lsr #27
++	mul		x6, x6, x5
++	eor		x6, x6, x6, lsr #31
++	str		x6, [\tmp, x2, lsl #3]
++	add		x2, x2, #1
++	cmp		x2, #(NATIVE_PAC_KEY_WORDS)
++	b.lo	1b
++	mov		x2, #1
++	str		x2, [\tmp, #(NATIVE_PAC_KEY_WORDS * 8)]
++	dsb		sy
++2:
++	ldp		x2, x3, [\tmp, #0]
++	msr		APIAKeyLo_EL1, x2
++	msr		APIAKeyHi_EL1, x3
++	ldp		x2, x3, [\tmp, #16]
++	msr		APIBKeyLo_EL1, x2
++	msr		APIBKeyHi_EL1, x3
++	ldp		x2, x3, [\tmp, #32]
++	msr		APDAKeyLo_EL1, x2
++	msr		APDAKeyHi_EL1, x3
++	ldp		x2, x3, [\tmp, #48]
++	msr		APDBKeyLo_EL1, x2
++	msr		APDBKeyHi_EL1, x3
++	ldp		x2, x3, [\tmp, #64]
++	msr		APGAKeyLo_EL1, x2
++	msr		APGAKeyHi_EL1, x3
++	isb		sy
++#endif /* HAS_NATIVE_PAC */
+ #if HAS_PARAVIRTUALIZED_PAC
+ #if HIBERNATION
+ 	#error PAC_INIT_KEY_STATE is not implemented for HAS_PARAVIRTUALIZED_PAC && HIBERNATION
+diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
+index 11de723..5763466 100644
+--- a/osfmk/arm64/start.s
++++ b/osfmk/arm64/start.s
+@@ -893,3 +893,12 @@ arm_init_tramp:
+ //#include	"globals_asm.h"
+ 
+ /* vim: set ts=4: */
++
++#if HAS_NATIVE_PAC
++	/* Key set of PAC_INIT_KEY_STATE and its ready word; written with the MMU off. */
++	.section __DATA, __data
++	.align 4
++	.globl EXT(native_pac_keys)
++LEXT(native_pac_keys)
++	.space	(NATIVE_PAC_KEY_WORDS + 1) * 8, 0
++#endif /* HAS_NATIVE_PAC */
+diff --git a/pexpert/pexpert/arm64/BCM2837.h b/pexpert/pexpert/arm64/BCM2837.h
+--- a/pexpert/pexpert/arm64/BCM2837.h
++++ b/pexpert/pexpert/arm64/BCM2837.h
+@@ -8,6 +8,15 @@
+ #define NO_MONITOR 1
+ #define NO_ECORE 1
+ 
++/*
++ * arm64e on a non-Apple ARMv8.3 CPU: pointer authentication uses the
++ * architectural key registers (see HAS_NATIVE_PAC in arm64/pac_asm.h).
++ */
++#if defined(__arm64e__)
++#define HAS_APPLE_PAC             1
++#define HAS_NATIVE_PAC            1
++#endif
++
+ #define BCM2837
+ #define BCM2837_BRINGUP
+ #define ARM_ARCH_TIMER
diff --git a/patches/xnu-10063-arm64e/split-block-keeps-mapping.patch b/patches/xnu-10063-arm64e/split-block-keeps-mapping.patch
new file mode 100644
index 0000000..2955aec
--- /dev/null
+++ b/patches/xnu-10063-arm64e/split-block-keeps-mapping.patch
@@ -0,0 +1,23 @@
+diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
+index a688021..f9e5dfe 100644
+--- a/osfmk/arm64/arm_vm_init.c
++++ b/osfmk/arm64/arm_vm_init.c
+@@ -1021,6 +1021,18 @@ arm_vm_page_granular_helper(vm_offset_t start, vm_offset_t _end, vm_offset_t va,
+ 
+ 			ppte = (pt_entry_t*)alloc_ptpage(pa_offset == 0);
+ 			bzero(ppte, ARM_PGBYTES);
++			if ((tmplate & ARM_TTE_VALID) && ((tmplate & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_BLOCK)) {
++				/*
++				 * Splitting a live block: keep its mapping for the pages this request does not cover.
++				 * Without this, a 4K-page kernel loses the rest of the 2MB block, e.g. kext headers in
++				 * a fileset __PRELINK_TEXT beyond the end of a kernel __TEXT placed inside it.
++				 */
++				pt_entry_t attrs = (pt_entry_t)(tmplate & ~(ARM_TTE_BLOCK_L2_MASK | ARM_PTE_HINT_MASK | 0x3ULL));
++				pmap_paddr_t block_pa = (pmap_paddr_t)(tmplate & ARM_TTE_BLOCK_L2_MASK);
++				for (i = 0; i <= (ARM_TT_L3_INDEX_MASK >> ARM_TT_L3_SHIFT); i++) {
++					ppte[i] = attrs | (block_pa + ((pmap_paddr_t)i << ARM_PGSHIFT)) | ARM_PTE_TYPE_VALID;
++				}
++			}
+ 			ppte_phys = kvtophys((vm_offset_t)ppte);
+ 
+ 			*tte2 = pa_to_tte(ppte_phys) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID;
diff --git a/patches/xnu-10063-arm64e/upstream-clang-auth-null.patch b/patches/xnu-10063-arm64e/upstream-clang-auth-null.patch
new file mode 100644
index 0000000..570e88d
--- /dev/null
+++ b/patches/xnu-10063-arm64e/upstream-clang-auth-null.patch
@@ -0,0 +1,19 @@
+diff --git a/libkern/os/base.h b/libkern/os/base.h
+--- a/libkern/os/base.h
++++ b/libkern/os/base.h
+@@ -347,7 +347,15 @@
+ #if __has_feature(ptrauth_calls)
+ #include <ptrauth.h>
+ #define OS_PTRAUTH_SIGNED_PTR(type) __ptrauth(ptrauth_key_process_independent_data, 1, ptrauth_string_discriminator(type))
++#if __has_feature(ptrauth_qualifier_authenticate_null_values) || defined(__apple_build_version__)
+ #define OS_PTRAUTH_SIGNED_PTR_AUTH_NULL(type) __ptrauth(ptrauth_key_process_independent_data, 1, ptrauth_string_discriminator(type), "authenticates-null-values")
++#else
++/*
++ * Upstream clang has no fourth __ptrauth argument. The only user is ucred.cr_label, which is never
++ * null, and a non-null value is signed the same way with or without authenticates-null-values.
++ */
++#define OS_PTRAUTH_SIGNED_PTR_AUTH_NULL(type) __ptrauth(ptrauth_key_process_independent_data, 1, ptrauth_string_discriminator(type))
++#endif
+ #define OS_PTRAUTH_DISCRIMINATOR(str) ptrauth_string_discriminator(str)
+ #define __ptrauth_only
+ #else //  __has_feature(ptrauth_calls)
