diff --git a/drivers/QcaBluetooth/NOTICE.md b/drivers/QcaBluetooth/NOTICE.md
new file mode 100644
index 0000000..158635d
--- /dev/null
+++ b/drivers/QcaBluetooth/NOTICE.md
@@ -0,0 +1,21 @@
+# Source attribution
+
+The locked `btqca.c` and `btqca.h` originate from
+[ianchb/sm8550-mainline](https://github.com/ianchb/sm8550-mainline), commit
+`1fb56e66091e71160d7c7f8e13b065d5b6ab8b8c`. The generated copies retain their
+original notices and GPL-2.0-only license.
+
+GENI register and DMA sequences follow `qcom_geni_serial.c`, `qcom-geni-se.c`
+and `geni-se.h` at that same revision. Their identities are recorded in
+`tools/source-lock.json`.
+
+`src/qbt_transport.c` derives from
+[Renoir XNU Bluetooth](https://github.com/daimile2/renoir_xnu_bluethooth/tree/2b9d59c921c9ec803462b2be8deb6980f7297c22),
+`kernel/files/bsd/dev/renoir_bluetooth_transport.inc`, by daimile2 and
+contributors. Its APSL-2.0 notice accompanies the file. The WCN7850 adapter
+adds channel lifetime coordination, power completion requests, range checks,
+queue copies and nonfatal packet allocation handling.
+
+The sheng board references are
+[sm8550-mainline](https://github.com/ianchb/sm8550-mainline) and
+[debian-sheng](https://github.com/ianchb/debian-sheng).
diff --git a/drivers/QcaBluetooth/README.md b/drivers/QcaBluetooth/README.md
new file mode 100644
index 0000000..381f767
--- /dev/null
+++ b/drivers/QcaBluetooth/README.md
@@ -0,0 +1,64 @@
+# QcaBluetooth
+
+Qualcomm WCN7850 Bluetooth driver for XNU. It runs the Linux `btqca.c` startup
+sequence over a GENI UART and connects the controller to Apple's `bluetoothd`.
+
+## Status
+
+Device: Xiaomi Pad 6S Pro (sheng), iPadOS 27.0.1 (24A446).
+
+| State | Features |
+| --- | --- |
+| Working | Pairing, reconnection after reboot, power toggle, A2DP playback, AirPods noise control and battery, use alongside Wi-Fi |
+| Not tested | Calls and microphone (HFP/SCO), sleep and wake |
+| Unavailable | Features that need Apple vendor commands |
+
+## Layout
+
+| Path | Contents |
+| --- | --- |
+| `include/qbt.h`, `src/qbt_core.c` | Linux initialization, H4 framing and IBS on one executor |
+| `include/qbt_geni.h`, `src/qbt_geni.c` | GENI SE DMA: four 2048-byte RX buffers, one 4096-byte TX buffer |
+| `include/qbt_transport.h`, `src/qbt_transport.c` | UART.SK kernel pipe, backpressure, channel lifetime and worker power requests |
+| `src/qbt_linux.c`, `shim/` | Boundary to the locked Linux sources |
+| `userland/BlueTool.c` | `com.apple.BlueTool` XPC bootstrap service |
+| `userland/Type0.c` | Capabilities from HCI reports for the native stack |
+| `tools/` | Native daemon patch, signing, source lock and checks |
+
+The board supplies WCN power, clocks, pins, IRQs, mapped DMA addresses and
+firmware. Pairing, key storage, BLE and audio profiles run in `bluetoothd`.
+[Native routing](native-ios27.md) describes the iPadOS 27 adapter.
+
+## Kernel interface
+
+| Sysctl | Access | Meaning |
+| --- | --- | --- |
+| `kern.qbt_boot` | Read | Controller state |
+| `kern.qbt_power_on` | Read | Reading starts the controller and returns the result |
+| `kern.qbt_firmware` | Read | Loaded firmware name |
+
+`kern.qbt_power_on` is a read because BlueTool's sandbox denies sysctl writes.
+
+## Checks
+
+```sh
+python3 tools/test-runtime.py
+python3 tools/test-geni.py
+python3 tools/build-bluetool.py
+python3 tools/build-type0.py
+python3 tools/check-kernel.py /path/to/tree --record <kernel source compile record> \
+    --extra-source <board source> --board-export <symbol>
+```
+
+`tools/prepare-linux.py` verifies the source hash and stages byte-identical Linux
+code in `out/linux`. `QBT_LINUX_TREE` selects an existing Linux checkout.
+
+## Sources and licenses
+
+Linux initialization and GENI/H4/IBS code use GPL-2.0-only. `src/qbt_transport.c`
+uses APSL-2.0, and `userland/Type0.c` uses BSD-3-Clause. Public interfaces and
+BlueTool use BSD-2-Clause-Patent. Each file identifies its license;
+[NOTICE](NOTICE.md) and `tools/source-lock.json` record attribution.
+
+Vendor firmware and Apple binaries are external inputs and stay out of this
+repository.
diff --git a/drivers/QcaBluetooth/include/qbt.h b/drivers/QcaBluetooth/include/qbt.h
new file mode 100644
index 0000000..15568e3
--- /dev/null
+++ b/drivers/QcaBluetooth/include/qbt.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef QBT_H
+#define QBT_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+struct qbt;
+/* All protocol entry points run on one executor. IRQ and socket producers use
+ * their own queues and wake it; callbacks never reenter a command operation. */
+struct qbt_platform {
+    void *context;
+    void *(*allocate)(void *, size_t);
+    void (*release)(void *, void *, size_t);
+    uint64_t (*now_ns)(void *);
+    size_t (*uart_write)(void *, const uint8_t *, size_t);
+    bool (*uart_drained)(void *);
+    int (*uart_speed)(void *, uint32_t);
+    int (*uart_flow)(void *, bool);
+    /* clock(false) succeeds only with a real RX wake source armed. */
+    int (*clock)(void *, bool);
+    void (*pump)(void *);
+    void (*wait_until)(void *, uint64_t);
+    size_t (*receive)(void *, const uint8_t *, size_t);
+    /* Returned firmware remains valid until firmware_put; NVM is copied. */
+    int (*firmware_get)(void *, const char *, const uint8_t **, size_t *);
+    void (*firmware_put)(void *, const uint8_t *, size_t);
+    void (*log)(void *, int, const char *);
+};
+struct qbt_stats {
+    uint64_t tx_bytes, rx_bytes, host_bytes, delivered_bytes;
+    uint64_t commands, timeouts, malformed, unmatched_events;
+    uint64_t wake_ind, wake_ack, sleep_ind, wake_retries, clock_sleeps;
+    uint64_t backpressure, tx_rejected, resets;
+    uint64_t tlv_sent, tlv_acks, tlv_final_status, hardware_errors, last_hardware_error;
+};
+struct qbt_info {
+    unsigned state; /* 0 off, 1 initializing, 2 ready, 3 failed */
+    int error;
+    uint32_t baud, product, soc;
+    uint16_t rom, patch;
+    char firmware[64];
+};
+struct qbt *qbt_create(const struct qbt_platform *);
+void qbt_destroy(struct qbt *);
+/* Returns consumed input; the UART retains unconsumed bytes under backpressure. */
+size_t qbt_receive(struct qbt *, const uint8_t *, size_t);
+/* Atomic enqueue: 0 accepted, negative errno leaves ownership with the caller. */
+int qbt_transmit(struct qbt *, const uint8_t *, size_t);
+size_t qbt_transmit_capacity(const struct qbt *);
+void qbt_step(struct qbt *);
+uint64_t qbt_deadline(const struct qbt *);
+void qbt_set_service(struct qbt *, bool);
+void qbt_rx_wake(struct qbt *);
+/* Abort command waiters promptly after a UART/DMA fault on the executor. */
+void qbt_fail(struct qbt *, int error);
+/* address uses display/network order; the Linux adapter converts to bdaddr_t. */
+int qbt_boot(struct qbt *, uint32_t baud, const uint8_t address[6]);
+int qbt_shutdown(struct qbt *);
+void qbt_get_info(const struct qbt *, struct qbt_info *);
+void qbt_get_stats(const struct qbt *, struct qbt_stats *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/drivers/QcaBluetooth/include/qbt_geni.h b/drivers/QcaBluetooth/include/qbt_geni.h
new file mode 100644
index 0000000..d1fd7e4
--- /dev/null
+++ b/drivers/QcaBluetooth/include/qbt_geni.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef QBT_GENI_H
+#define QBT_GENI_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define QBT_GENI_RX_COUNT 4u
+#define QBT_GENI_RX_SIZE 2048u
+#define QBT_GENI_TX_SIZE 4096u
+/* Buffers are mapped for the device's actual DMA domain by the board adapter.
+ * sync(for_device=true) publishes TX / relinquishes RX CPU ownership. */
+struct qbt_dma_buffer { uint8_t *bytes; uint64_t address; size_t capacity; };
+struct qbt_geni_ops {
+    void *context;
+    uint32_t (*read)(void *, uint32_t);
+    void (*write)(void *, uint32_t, uint32_t);
+    void (*barrier)(void *);
+    void (*sync)(void *, const struct qbt_dma_buffer *, size_t, bool for_device, bool tx);
+    uint64_t (*now_ns)(void *);
+    /* GIC mask, usable in hard IRQ even when the serial clock is gated. */
+    void (*irq_mask)(void *, bool);
+    void (*wake_worker)(void *);
+    size_t (*receive)(void *, const uint8_t *, size_t);
+};
+enum qbt_geni_state { QBT_GENI_OFF, QBT_GENI_RUN, QBT_GENI_CANCEL,
+    QBT_GENI_ABORT, QBT_GENI_RESET, QBT_GENI_STOPPED, QBT_GENI_FAILED };
+struct qbt_geni_stats {
+    uint64_t interrupts, tx_bytes, rx_bytes, tx_dma, rx_dma;
+    uint64_t rx_pauses, rx_backpressure, dma_errors, line_errors, cancel_timeouts;
+};
+struct qbt_geni {
+    struct qbt_geni_ops ops;
+    struct qbt_dma_buffer tx, rx[QBT_GENI_RX_COUNT];
+    struct qbt_geni_stats stats;
+    enum qbt_geni_state state;
+    unsigned rx_head, rx_ready, rx_active;
+    unsigned rx_length[QBT_GENI_RX_COUNT], rx_offset;
+    unsigned tx_length;
+    uint32_t baud, source_hz, oversampling;
+    uint32_t fault_irq[4]; /* M, S, TX DMA and RX DMA status from a failed service turn. */
+    uint64_t stop_deadline;
+    int error;
+    bool tx_busy, rx_busy, flow, irq_pending;
+};
+/* Engine must be idle, supplied with its UART microcode and functional clocks. */
+int qbt_geni_prepare(struct qbt_geni *, const struct qbt_geni_ops *,
+    const struct qbt_dma_buffer *, const struct qbt_dma_buffer [QBT_GENI_RX_COUNT]);
+/* Source clock is already selected by the board; reject baud error above 1%. */
+int qbt_geni_set_rate(struct qbt_geni *, uint32_t baud, uint32_t source_hz, unsigned oversampling);
+int qbt_geni_start(struct qbt_geni *);
+void qbt_geni_irq(struct qbt_geni *);
+/* One bounded worker turn; true requests another turn without sleeping. */
+bool qbt_geni_service(struct qbt_geni *);
+size_t qbt_geni_write(struct qbt_geni *, const uint8_t *, size_t);
+bool qbt_geni_drained(struct qbt_geni *);
+void qbt_geni_set_flow(struct qbt_geni *, bool);
+/* Cancel RX only after TX drains, then finish from IRQ or timed service turns.
+ * Clock gating is allowed only at STOPPED with an external RX wake armed. */
+int qbt_geni_quiesce(struct qbt_geni *);
+int qbt_geni_resume(struct qbt_geni *);
+uint64_t qbt_geni_deadline(const struct qbt_geni *);
+#ifdef __cplusplus
+}
+#endif
+#endif
