+/* ---- fuxi (2026-11-15): /dev/uart.bluetooth and /dev/cu.bluetooth for the iOS 17 native stack ---- */
+static int bt_tty_major=-1;
+static void *bt_tty_nodes[2];
+static int bt_tty_open(dev_t dev __unused,int flags __unused,int devtype __unused,struct proc *p __unused)
+{
+    lck_mtx_lock(&bt_sk_lock);
+    if(bt_sk.tty_open || bt_sk.connected){lck_mtx_unlock(&bt_sk_lock);return EBUSY;}
+    bt_sk.tty_open=true;bt_sk.rx_head=bt_sk.rx_len=bt_sk.tx_head=bt_sk.tx_len=0;
+    const bool down=bt_sk.boot!=0;
+    lck_mtx_unlock(&bt_sk_lock);
+    printf("[bluetooth tty] open by pid %d (controller %s)\n",proc_selfpid(),down?"down":"ready");
+    if(down && bt_ops.power)(void)bt_ops.power(bt_ops.context,true);
+    bt_kick();
+    return 0;
+}
+static int bt_tty_close(dev_t dev __unused,int flags __unused,int devtype __unused,struct proc *p __unused)
+{
+    lck_mtx_lock(&bt_sk_lock);
+    bt_sk.tty_open=false;bt_sk.rx_head=bt_sk.rx_len=bt_sk.tx_head=bt_sk.tx_len=0;
+    uint64_t r=bt_sk.tty_reads,w=bt_sk.tty_writes,c=bt_sk.tty_ioctls;
+    lck_mtx_unlock(&bt_sk_lock);
+    wakeup(&bt_sk.rx_len);wakeup(&bt_sk.tx_len);
+    printf("[bluetooth tty] close: read %llu written %llu ioctls %llu\n",r,w,c);
+    bt_kick();
+    return 0;
+}
+static int bt_tty_read(dev_t dev __unused,struct uio *uio,int ioflag)
+{
+    uint8_t chunk[512];
+    lck_mtx_lock(&bt_sk_lock);
+    while(!bt_sk.rx_len) {
+        if(!bt_sk.tty_open){lck_mtx_unlock(&bt_sk_lock);return ENXIO;}
+        if(ioflag&IO_NDELAY){lck_mtx_unlock(&bt_sk_lock);return EWOULDBLOCK;}
+        int e=msleep(&bt_sk.rx_len,(lck_mtx_t *)&bt_sk_lock,PCATCH,"btttyrd",NULL);
+        if(e){lck_mtx_unlock(&bt_sk_lock);return e;}
+    }
+    int error=0;
+    while(bt_sk.rx_len && uio_resid(uio)>0) {
+        uint32_t n=bt_sk.rx_len;if(n>sizeof(chunk))n=sizeof(chunk);
+        if((user_ssize_t)n>uio_resid(uio))n=(uint32_t)uio_resid(uio);
+        bt_sk_fifo_get(bt_sk.rx,&bt_sk.rx_head,&bt_sk.rx_len,chunk,n);
+        bt_sk.tty_reads+=n;
+        lck_mtx_unlock(&bt_sk_lock);
+        error=uiomove((caddr_t)chunk,(int)n,uio);
+        lck_mtx_lock(&bt_sk_lock);
+        if(error)break;
+    }
+    lck_mtx_unlock(&bt_sk_lock);
+    bt_kick();   /* room again for the UART owner's receive */
+    return error;
+}
+static int bt_tty_write(dev_t dev __unused,struct uio *uio,int ioflag)
+{
+    uint8_t chunk[512];
+    int error=0;
+    while(uio_resid(uio)>0) {
+        lck_mtx_lock(&bt_sk_lock);
+        while(bt_sk.tx_len>=BT_SK_FIFO) {
+            if(!bt_sk.tty_open){lck_mtx_unlock(&bt_sk_lock);return ENXIO;}
+            if(ioflag&IO_NDELAY){lck_mtx_unlock(&bt_sk_lock);return EWOULDBLOCK;}
+            int e=msleep(&bt_sk.tx_len,(lck_mtx_t *)&bt_sk_lock,PCATCH,"btttywr",NULL);
+            if(e){lck_mtx_unlock(&bt_sk_lock);return e;}
+        }
+        uint32_t room=BT_SK_FIFO-bt_sk.tx_len;
+        lck_mtx_unlock(&bt_sk_lock);
+        uint32_t n=(uint32_t)MIN((user_ssize_t)MIN(room,(uint32_t)sizeof(chunk)),uio_resid(uio));
+        error=uiomove((caddr_t)chunk,(int)n,uio);
+        if(error)break;
+        lck_mtx_lock(&bt_sk_lock);
+        if(n>BT_SK_FIFO-bt_sk.tx_len)n=BT_SK_FIFO-bt_sk.tx_len;
+        bt_sk_fifo_put(bt_sk.tx,bt_sk.tx_head,&bt_sk.tx_len,chunk,n);
+        bt_sk.tty_writes+=n;
+        lck_mtx_unlock(&bt_sk_lock);
+        bt_kick();
+    }
+    return error;
+}
+static int bt_tty_ioctl(dev_t dev __unused,u_long cmd,caddr_t data,int fflag __unused,struct proc *p __unused)
+{
+    lck_mtx_lock(&bt_sk_lock);
+    ++bt_sk.tty_ioctls;
+    static unsigned shown;
+    if(shown<24){++shown;printf("[bluetooth tty] ioctl %#lx\n",cmd);}
+    int error=0;
+    switch(cmd) {
+    case FIONREAD: *(int *)data=(int)bt_sk.rx_len;break;
+    case FIONBIO: case FIOASYNC: case TIOCEXCL: case TIOCNXCL: case TIOCSDTR: case TIOCCDTR:
+    case TIOCMSET: case TIOCMBIS: case TIOCMBIC: case TIOCDRAIN: case TIOCSBRK: case TIOCCBRK: break;
+    case TIOCFLUSH: {
+        int what=data?*(int *)data:0;if(!what)what=FREAD|FWRITE;
+        if(what&FREAD)bt_sk.rx_head=bt_sk.rx_len=0;
+        if(what&FWRITE)bt_sk.tx_head=bt_sk.tx_len=0;
+        break;
+    }
+    case TIOCMGET: *(int *)data=TIOCM_LE|TIOCM_DTR|TIOCM_RTS|TIOCM_CTS|TIOCM_DSR|TIOCM_CAR;break;
+    case TIOCOUTQ: *(int *)data=(int)bt_sk.tx_len;break;
+    default:
+        /* termios (TIOCGETA/TIOCSETA*, 64-bit layout) and IOSSIOSPEED: kept, answered from what was set; the line itself runs at
+         * the speed the kernel brought the controller up with. */
+        if(IOCGROUP(cmd)=='t' && IOCPARM_LEN(cmd)==sizeof(struct bt_termios64)) {
+            if(cmd&IOC_OUT)memcpy(data,&bt_sk.termios,sizeof(bt_sk.termios));
+            else memcpy(&bt_sk.termios,data,sizeof(bt_sk.termios));
+        } else if(IOCGROUP(cmd)=='T' && IOCBASECMD(cmd)==IOCBASECMD(_IOW('T',2,uint64_t))) {
+            /* IOSSIOSPEED: accepted */
+        } else {
+            error=ENOTTY;
+        }
+    }
+    lck_mtx_unlock(&bt_sk_lock);
+    return error;
+}
+static int bt_tty_select(dev_t dev __unused,int which,void *wql,struct proc *p)
+{
+    int ready=0;
+    lck_mtx_lock(&bt_sk_lock);
+    if(which==FREAD){if(bt_sk.rx_len)ready=1;else selrecord(p,&bt_sk.tty_rsel,wql);}
+    else if(which==FWRITE){if(bt_sk.tx_len<BT_SK_FIFO)ready=1;else selrecord(p,&bt_sk.tty_wsel,wql);}
+    lck_mtx_unlock(&bt_sk_lock);
+    return ready;
+}
+static const struct cdevsw bt_tty_cdevsw={
+    .d_open=bt_tty_open,.d_close=bt_tty_close,.d_read=bt_tty_read,.d_write=bt_tty_write,.d_ioctl=bt_tty_ioctl,
+    .d_stop=eno_stop,.d_reset=eno_reset,.d_ttys=NULL,.d_select=bt_tty_select,.d_mmap=eno_mmap,.d_strategy=eno_strat,
+    .d_reserved_1=eno_getc,.d_reserved_2=eno_putc,.d_type=0
+};
+static void bt_tty_publish(void)
+{
+    if(bt_tty_major>=0)return;
+    bt_tty_major=cdevsw_add(-1,&bt_tty_cdevsw);
+    if(bt_tty_major<0){printf("[bluetooth tty] cdevsw_add failed %d\n",bt_tty_major);return;}
+    bt_tty_nodes[0]=devfs_make_node(makedev(bt_tty_major,0),DEVFS_CHAR,UID_ROOT,GID_WHEEL,0666,"uart.bluetooth");
+    bt_tty_nodes[1]=devfs_make_node(makedev(bt_tty_major,1),DEVFS_CHAR,UID_ROOT,GID_WHEEL,0666,"cu.bluetooth");
+    printf("[bluetooth tty] /dev/uart.bluetooth %s, /dev/cu.bluetooth %s (major %d)\n",bt_tty_nodes[0]?"made":"failed",
+        bt_tty_nodes[1]?"made":"failed",bt_tty_major);
+}
+/* Called once by the UART owner: 0 after a complete bring-up (with the
+ * UART speed it configured), else errno. */
+void qbt_transport_power_result(bool enabled,int error,const char *firmware,uint32_t speed)
+{
+    if(enabled && !error && !bt_sk.ctl) {
+        bt_sk_speed=speed;
+        struct kern_ctl_reg reg={.ctl_flags=CTL_FLAG_REG_SOCK_STREAM,
+            .ctl_connect=bt_sk_connect,.ctl_disconnect=bt_sk_disconnect,.ctl_send=bt_sk_send,
+            .ctl_setopt=bt_sk_setopt,.ctl_getopt=bt_sk_getopt};
+        strlcpy(reg.ctl_name,"com.apple.uart.sk.bluetooth",sizeof(reg.ctl_name));
+        error=ctl_register(&reg,&bt_sk.ctl);
+        printf("[bluetooth sk] ctl_register com.apple.uart.sk.bluetooth error=%d firmware=%s speed=%u\n",error,firmware,speed);
+        bt_tty_publish();
+    }
+    lck_mtx_lock(&bt_sk_lock);
+    if(firmware) strlcpy(bt_sk.firmware,firmware,sizeof(bt_sk.firmware));
+    if(enabled && !error){bt_sk_speed=speed;bt_sk_termios_default();}
+    bt_sk.boot=error?error:enabled?0:ENETDOWN;
+    if(!enabled || error)bt_sk.rx_head=bt_sk.rx_len=bt_sk.tx_head=bt_sk.tx_len=0;
+    bt_sk.power_pending=false;bt_sk.power_result=error;
+    kern_channel_ring_t rx=NULL,tx=NULL;
+    if(bt_sk.boot && bt_sk.connected && !bt_sk.closing) {
+        rx=bt_sk.rxring;tx=bt_sk.txring;
+        if(rx || tx) ++bt_sk.busy;
+    }
+    lck_mtx_unlock(&bt_sk_lock);
+    wakeup(&bt_sk.boot);
+    wakeup(&bt_sk.power_pending);
+    /* Wake blocked channel users so their next sync observes the error. The
+     * busy reference keeps both rings alive until notifications finish. */
+    if(rx) (void)kern_channel_notify(rx,0);
+    if(tx && tx!=rx) (void)kern_channel_notify(tx,0);
+    if(rx || tx) {
+        lck_mtx_lock(&bt_sk_lock);
+        if(!--bt_sk.busy) wakeup(&bt_sk.busy);
+        lck_mtx_unlock(&bt_sk_lock);
+    }
+    bt_kick();
+}
+void qbt_transport_boot_result(int error,const char *firmware,uint32_t speed)
+{
+    qbt_transport_power_result(true,error,firmware,speed);
+}
