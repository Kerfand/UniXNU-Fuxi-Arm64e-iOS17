diff --git a/drivers/QcaBluetooth/src/qbt_core.c b/drivers/QcaBluetooth/src/qbt_core.c
new file mode 100644
index 0000000..d759f25
--- /dev/null
+++ b/drivers/QcaBluetooth/src/qbt_core.c
@@ -0,0 +1,280 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* H4 framing and Qualcomm IBS, following Linux hci_qca and h4_recv_buf.
+ * Byte storage is bounded. The executor sleeps on actual work/deadline events. */
+#include "qbt_internal.h"
+#include <stdarg.h>
+#define SLEEP_IND 0xfe
+#define WAKE_IND 0xfd
+#define WAKE_ACK 0xfc
+static uint64_t now(struct qbt *q) { return q->ops.now_ns(q->ops.context); }
+static bool drained(struct qbt *q) { return q->ops.uart_drained(q->ops.context); }
+static int clock_on(struct qbt *q) {
+    if (q->clock_on) return 0;
+    int e = q->ops.clock(q->ops.context, true);
+    if (!e) q->clock_on = true;
+    return e;
+}
+static bool flush(struct qbt *q) {
+    while (q->forward_offset < q->forward_length) {
+        size_t n = q->ops.receive(q->ops.context, q->forward + q->forward_offset,
+                                q->forward_length - q->forward_offset);
+        if (!n) { q->stats.backpressure++; return false; }
+        if (n > q->forward_length - q->forward_offset) n = q->forward_length - q->forward_offset;
+        q->forward_offset += (unsigned)n; q->stats.delivered_bytes += n;
+    }
+    q->forward_offset = q->forward_length = 0;
+    return true;
+}
+static void control(struct qbt *q, uint8_t b) {
+    if (q->control_length < sizeof(q->control)) q->control[q->control_length++] = b;
+    else q->stats.malformed++;
+}
+/* Stop each DMA chunk at a packet boundary. IBS bytes may never be inserted
+ * into the middle of a command, ACL, SCO or ISO frame spanning several slots. */
+static size_t tx_advance(struct qbt_tx_frame *f,const uint8_t *p,size_t n) {
+    size_t i=0;
+    while(i<n) {
+        if(!f->type) {
+            uint8_t t=p[i++];if(t!=1 && t!=2 && t!=3 && t!=5)return 0;
+            f->type=t;f->have=0;f->need=t==1||t==3?3:4;
+        } else if(f->need) {
+            f->header[f->have++]=p[i++];if(--f->need)continue;
+            f->body=f->type==1||f->type==3?f->header[2]:
+                (f->header[2]|(unsigned)f->header[3]<<8)&(f->type==5?0x3fff:0xffff);
+            if(!f->body){f->type=0;return i;}
+        } else {
+            size_t take=n-i;if(take>f->body)take=f->body;
+            i+=take;f->body-=(unsigned)take;if(!f->body){f->type=0;return i;}
+        }
+    }
+    return i;
+}
+static void event(struct qbt *q) {
+    const uint8_t *e = q->event; unsigned n = q->event_length;
+    if (n >= 3 && e[0] == 0x10) { q->stats.hardware_errors++; q->stats.last_hardware_error = e[2]; }
+    /* The speed change completes after the switch, at the new rate. */
+    if (n >= 5 && e[0] == 0x0e && e[3] == 0x48 && e[4] == 0xfc) q->speed_reply = true;
+    /* A nonzero TLV report describes an earlier segment; only status 0 answers a wait. */
+    if (n >= 7 && e[0] == 0x0e && e[3] == 0x00 && e[4] == 0xfc && e[6] == 0x1e) {
+        q->stats.tlv_acks++; q->stats.tlv_final_status = e[5];
+        if (e[5]) return;
+    }
+    if (q->waiting && !q->complete) {
+        bool match = false;
+        if (!q->wait_event && n >= 5 && e[0] == 0x0e)
+            match = (e[3] | (unsigned)e[4] << 8) == q->wait_opcode;
+        else if (q->wait_event == e[0]) match = true;
+        if (match) {
+            /* Matching replies have independent storage from parser scratch. */
+            memcpy(q->reply, e, n); q->reply_length = n; q->complete = true;
+            return;
+        }
+        if (n >= 6 && e[0] == 0x0f && (e[4] | (unsigned)e[5] << 8) == q->wait_opcode && e[2]) {
+            memcpy(q->reply, e, n); q->reply_length = n; q->complete = true;
+            return;
+        }
+    }
+    if (q->service && !q->drop) {
+        q->forward[0] = 4; memcpy(q->forward + 1, e, n);
+        q->forward_length = n + 1;
+    } else q->stats.unmatched_events++;
+}
+struct qbt *qbt_create(const struct qbt_platform *p) {
+    if (!p || !p->allocate || !p->release || !p->now_ns || !p->uart_write ||
+        !p->uart_drained || !p->uart_speed || !p->uart_flow || !p->clock ||
+        !p->pump || !p->wait_until || !p->receive || !p->firmware_get || !p->firmware_put) return NULL;
+    struct qbt *q = p->allocate(p->context, sizeof(*q));
+    if (q) { memset(q, 0, sizeof(*q)); q->ops = *p; q->clock_on = true; q->info.baud = 115200; }
+    return q;
+}
+void qbt_destroy(struct qbt *q) {
+    if (!q) return;
+    struct qbt_platform p = q->ops; memset(q, 0, sizeof(*q)); p.release(p.context, q, sizeof(*q));
+}
+size_t qbt_receive(struct qbt *q, const uint8_t *data, size_t length) {
+    if (q->info.state == 3) return 0;
+    size_t i = 0;
+    while (i < length) {
+        if (!flush(q)) break;
+        if (!q->header_need && !q->body) {
+            uint8_t b = data[i++];
+            if (b == WAKE_IND) {
+                int e = clock_on(q);
+                if (e) { qbt_fail(q, e); break; }
+                q->rx_awake = true; control(q, WAKE_ACK); q->stats.wake_ack++;
+            } else if (b == WAKE_ACK) {
+                if (q->tx_state == QBT_WAKING) { q->tx_state = QBT_AWAKE; q->retry_at = 0; q->idle_at = now(q) + QBT_TX_IDLE; }
+            } else if (b == SLEEP_IND) q->rx_awake = false;
+            else if (b >= 2 && b <= 5) {
+                q->type = b; q->header_length = 0; q->header_need = b == 4 ? 2 : b == 3 ? 3 : 4;
+                q->drop = !q->service;
+            } else { q->stats.malformed++; i = length; }
+            continue;
+        }
+        if (q->header_need) {
+            q->header[q->header_length++] = data[i++];
+            if (--q->header_need) continue;
+            uint8_t t = q->type;
+            q->body = t == 4 ? q->header[1] : t == 3 ? q->header[2] :
+                (q->header[2] | (unsigned)q->header[3] << 8) & (t == 5 ? 0x3fff : 0xffff);
+            q->drop = q->drop || !q->service || (t == 2 &&
+                (q->header[0] | (unsigned)q->header[1] << 8) == 0x2edc);
+            if (t == 4) { memcpy(q->event, q->header, 2); q->event_length = 2; }
+            else if (!q->drop) { q->forward[0] = t; memcpy(q->forward + 1, q->header, q->header_length); q->forward_length = q->header_length + 1; }
+            if (!q->body && t == 4) event(q);
+            continue;
+        }
+        size_t n = length - i;
+        if (n > q->body) n = q->body;
+        if (q->type == 4) {
+            if (n > sizeof(q->event) - q->event_length) { q->stats.malformed++; break; }
+            memcpy(q->event + q->event_length, data + i, n); q->event_length += (unsigned)n;
+        } else if (!q->drop) {
+            if (n > sizeof(q->forward)) n = sizeof(q->forward);
+            memcpy(q->forward, data + i, n); q->forward_length = (unsigned)n;
+        }
+        i += n; q->body -= (unsigned)n;
+        if (!q->body && q->type == 4) event(q);
+    }
+    q->stats.rx_bytes += i; (void)flush(q); return i;
+}
+int qbt_transmit(struct qbt *q, const uint8_t *p, size_t n) {
+    if (!q->service || q->info.state != 2) return -ENETDOWN;
+    if (!n || !p || n > QBT_TX_CAPACITY - q->tx_length) { q->stats.tx_rejected++; return -ENOBUFS; }
+    unsigned tail = (q->tx_head + q->tx_length) % QBT_TX_CAPACITY;
+    size_t first = QBT_TX_CAPACITY - tail; if (first > n) first = n;
+    memcpy(q->tx + tail, p, first); memcpy(q->tx, p + first, n - first);
+    q->tx_length += (unsigned)n; q->stats.host_bytes += n; return 0;
+}
+size_t qbt_transmit_capacity(const struct qbt *q) {
+    return q->service && q->info.state==2?QBT_TX_CAPACITY-q->tx_length:0;
+}
+void qbt_step(struct qbt *q) {
+    if (q->info.state == 3) return;
+    (void)flush(q);
+    uint64_t t = now(q); bool pending = q->command_length || (q->service && q->tx_length);
+    if (pending) {
+        int e = clock_on(q);
+        if (e) { qbt_fail(q, e); return; }
+    }
+    if (q->ibs && pending && q->tx_state == QBT_ASLEEP) {
+        q->tx_state = QBT_WAKING; q->wake_attempts = 1; control(q, WAKE_IND);
+        q->retry_at = t + QBT_WAKE_RETRY; q->stats.wake_ind++;
+    } else if (q->ibs && q->tx_state == QBT_WAKING && t >= q->retry_at) {
+        if (++q->wake_attempts > 10) {
+            q->info.error = -ETIMEDOUT; q->info.state = 3; q->service = false;
+            q->retry_at = 0; q->stats.timeouts++; return;
+        }
+        control(q, WAKE_IND); q->retry_at = t + QBT_WAKE_RETRY; q->stats.wake_retries++;
+    }
+    if (q->control_length && q->clock_on && !q->tx_frame.type) {
+        size_t n = q->ops.uart_write(q->ops.context, q->control, q->control_length);
+        if (n > q->control_length) n = q->control_length;
+        memmove(q->control, q->control + n, q->control_length - n); q->control_length -= (unsigned)n;
+        if (q->control_length) return;
+    }
+    if (!q->ibs || q->tx_state == QBT_AWAKE) {
+        const uint8_t *p = NULL; size_t n = 0; bool cmd = q->command_length != 0;
+        if (cmd) { p = q->command + q->command_offset; n = q->command_length - q->command_offset; }
+        else if (q->service && q->tx_length) { p = q->tx + q->tx_head; n = QBT_TX_CAPACITY - q->tx_head; if (n > q->tx_length) n = q->tx_length; }
+        if (n) {
+            if (n > QBT_CHUNK) n = QBT_CHUNK;
+            struct qbt_tx_frame preview=q->tx_frame;
+            n=tx_advance(&preview,p,n);
+            if(!n){q->info.error=-EPROTO;q->info.state=3;q->service=false;return;}
+            size_t used = q->ops.uart_write(q->ops.context, p, n); if (used > n) used = n;
+            if(used)(void)tx_advance(&q->tx_frame,p,used);
+            q->stats.tx_bytes += used;
+            if (cmd) { q->command_offset += (unsigned)used; if (q->command_offset == q->command_length) q->command_offset = q->command_length = 0; }
+            else { q->tx_head = (q->tx_head + (unsigned)used) % QBT_TX_CAPACITY; q->tx_length -= (unsigned)used; }
+            if (used) q->idle_at = t + QBT_TX_IDLE;
+        }
+        if (q->ibs && !q->command_length && !q->tx_length && !q->control_length &&
+            !q->tx_frame.type && q->tx_state == QBT_AWAKE && q->idle_at && t >= q->idle_at && drained(q)) {
+            control(q, SLEEP_IND); q->tx_state = QBT_ASLEEP; q->idle_at = 0; q->stats.sleep_ind++;
+        }
+    }
+    if (q->ibs && q->tx_state == QBT_ASLEEP && !q->rx_awake && !q->tx_length &&
+        !q->command_length && !q->control_length && !q->tx_frame.type && q->clock_on && drained(q)) {
+        if (!q->ops.clock(q->ops.context, false)) { q->clock_on = false; q->stats.clock_sleeps++; }
+    }
+}
+uint64_t qbt_deadline(const struct qbt *q) {
+    if (q->info.state == 3) return UINT64_MAX;
+    bool idle = q->ops.uart_drained(q->ops.context);
+    if (q->control_length && !q->tx_frame.type && idle) return 0;
+    if ((q->command_length || (q->service && q->tx_length)) && idle && q->tx_state != QBT_WAKING) return 0;
+    if (q->tx_state == QBT_WAKING && q->retry_at) return q->retry_at;
+    if (q->ibs && !q->tx_frame.type && q->tx_state == QBT_AWAKE && q->idle_at && idle) return q->idle_at;
+    return UINT64_MAX;
+}
+void qbt_set_service(struct qbt *q, bool enabled) {
+    q->service = enabled && q->info.state == 2;
+    if (!q->service) {
+        if(q->tx_frame.type){q->info.state=3;q->info.error=-ECANCELED;}
+        q->drop = true;
+        q->tx_head = q->tx_length = 0; q->forward_length = q->forward_offset = 0;
+    }
+}
+void qbt_rx_wake(struct qbt *q) {
+    if (q->info.state == 3) return;
+    int e = clock_on(q);
+    if (e) qbt_fail(q, e);
+}
+void qbt_fail(struct qbt *q,int error) {
+    q->info.state=3;q->info.error=error<0?error:-EIO;q->service=false;
+    q->retry_at=q->idle_at=0;
+}
+static int run(struct qbt *q, uint64_t deadline, unsigned predicate) {
+    for (;;) {
+        q->ops.pump(q->ops.context); qbt_step(q);
+        if (q->info.error) return q->info.error;
+        if ((predicate == 0 && !q->command_length) || (predicate == 1 && q->complete) ||
+            (predicate == 2 && !q->command_length && drained(q))) return 0;
+        uint64_t t = now(q); if (t >= deadline) { q->stats.timeouts++; return -ETIMEDOUT; }
+        uint64_t next = qbt_deadline(q);
+        /* Wire drain has no IRQ of its own: bytes waiting on it re-check here. */
+        if (predicate == 2 || q->command_length || q->control_length) {
+            if (!next || next > t + QBT_TX_POLL) next = t + QBT_TX_POLL;
+        }
+        if (!next || next > deadline) next = deadline;
+        /* UART completion and ring-space producers signal this wait. */
+        q->ops.wait_until(q->ops.context, next);
+    }
+}
+int qbt_send_command(struct qbt *q, uint16_t op, const void *data, unsigned n) {
+    if (n > 255 || (n && !data)) return -EINVAL;
+    uint64_t deadline = now(q) + QBT_COMMAND_TIMEOUT;
+    int e = run(q, deadline, 0); if (e) return e;
+    q->command[0] = 1; q->command[1] = (uint8_t)op; q->command[2] = op >> 8; q->command[3] = (uint8_t)n;
+    if (n) memcpy(q->command + 4, data, n);
+    q->command_length = n + 4; q->command_offset = 0; q->stats.commands++;
+    if (op == 0xfc00 && n && ((const uint8_t *)data)[0] == 0x1e) q->stats.tlv_sent++;
+    return run(q, deadline, 0);
+}
+int qbt_command(struct qbt *q, uint16_t op, const void *data, unsigned n, uint8_t ev,
+                uint8_t *reply, size_t *length) {
+    if (q->waiting) return -EBUSY;
+    q->wait_opcode = op; q->wait_event = ev; q->waiting = true; q->complete = false; q->reply_length = 0;
+    uint64_t deadline = now(q) + QBT_COMMAND_TIMEOUT;
+    int e = qbt_send_command(q, op, data, n);
+    if (!e) e = run(q, deadline, 1);
+    q->waiting = false;
+    if (e) return e;
+    unsigned skip = q->reply[0] == 0x0e ? 5 : 2;
+    if (q->reply[0] == 0x0f) return -EIO;
+    if (q->reply_length < skip || *length < q->reply_length - skip) return -EMSGSIZE;
+    *length = q->reply_length - skip; memcpy(reply, q->reply + skip, *length); return 0;
+}
+int qbt_drain(struct qbt *q, uint64_t deadline) { return run(q, deadline, 2); }
+void qbt_delay(struct qbt *q, unsigned ms) {
+    uint64_t end = now(q) + (uint64_t)ms * 1000000;
+    while (now(q) < end) { q->ops.pump(q->ops.context); qbt_step(q); q->ops.wait_until(q->ops.context, end); }
+}
+void qbt_get_info(const struct qbt *q, struct qbt_info *out) { *out = q->info; }
+void qbt_get_stats(const struct qbt *q, struct qbt_stats *out) { *out = q->stats; }
+void qbt_linux_log(struct qbt *q, int level, const char *format, ...) {
+    if (!q->ops.log) return;
+    char text[160]; va_list ap; va_start(ap, format); vsnprintf(text, sizeof(text), format, ap); va_end(ap);
+    q->ops.log(q->ops.context, level, text);
+}
diff --git a/drivers/QcaBluetooth/src/qbt_geni.c b/drivers/QcaBluetooth/src/qbt_geni.c
new file mode 100644
index 0000000..4d01073
--- /dev/null
+++ b/drivers/QcaBluetooth/src/qbt_geni.c
@@ -0,0 +1,191 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Qualcomm GENI SE UART DMA. Sequencing follows the locked Linux driver.
+ * Hard IRQ only masks the GIC line and wakes the owning executor. */
+#include "qbt_geni.h"
+#include "qbt_geni_regs.h"
+#ifdef KERNEL
+#include <sys/errno.h>
+#include <sys/systm.h>
+#else
+#include <errno.h>
+#include <string.h>
+#endif
+static uint32_t rd(struct qbt_geni *g, uint32_t r) { return g->ops.read(g->ops.context,r); }
+static void wr(struct qbt_geni *g, uint32_t r, uint32_t v) { g->ops.write(g->ops.context,r,v); }
+static void barrier(struct qbt_geni *g) { g->ops.barrier(g->ops.context); }
+static void rfr(struct qbt_geni *g, bool ready) {
+    /* Stopped flow control deasserts RTS across a controller baud change, as Linux does. */
+    wr(g,G_MANUAL_RFR,ready&&g->flow?0:G_RFR_OFF);
+}
+static void arm_rx(struct qbt_geni *g) {
+    if (g->rx_busy || g->rx_ready == QBT_GENI_RX_COUNT || g->state != QBT_GENI_RUN) return;
+    unsigned i=(g->rx_head+g->rx_ready)%QBT_GENI_RX_COUNT;
+    const struct qbt_dma_buffer *b=&g->rx[i];
+    g->ops.sync(g->ops.context,b,QBT_GENI_RX_SIZE,true,false);
+    wr(g,G_RX_IRQ_SET,G_DONE|G_EOT|G_DMA_ERROR);
+    wr(g,G_RX_PTR_L,(uint32_t)b->address);wr(g,G_RX_PTR_H,(uint32_t)(b->address>>32));
+    wr(g,G_RX_ATTR,0);barrier(g);
+    g->rx_active=i;g->rx_busy=true;
+    wr(g,G_RX_DMA_LEN,QBT_GENI_RX_SIZE);barrier(g);rfr(g,true);
+}
+static bool valid_buffer(const struct qbt_dma_buffer *b, size_t n) {
+    return b->bytes && b->capacity>=n && !(b->address&63u) && b->address<=UINT64_MAX-n;
+}
+int qbt_geni_prepare(struct qbt_geni *g, const struct qbt_geni_ops *ops,
+    const struct qbt_dma_buffer *tx, const struct qbt_dma_buffer rx[QBT_GENI_RX_COUNT]) {
+    if (!g || !ops || !ops->read || !ops->write || !ops->barrier || !ops->sync ||
+        !ops->now_ns || !ops->irq_mask || !ops->wake_worker || !ops->receive ||
+        !tx || !rx || !valid_buffer(tx,QBT_GENI_TX_SIZE)) return -EINVAL;
+    for (unsigned i=0;i<QBT_GENI_RX_COUNT;i++) {
+        if (!valid_buffer(&rx[i],QBT_GENI_RX_SIZE)) return -EINVAL;
+        if (rx[i].address<tx->address+QBT_GENI_TX_SIZE && tx->address<rx[i].address+QBT_GENI_RX_SIZE) return -EINVAL;
+        for (unsigned j=0;j<i;j++)
+            if (rx[i].address<rx[j].address+QBT_GENI_RX_SIZE && rx[j].address<rx[i].address+QBT_GENI_RX_SIZE) return -EINVAL;
+    }
+    memset(g,0,sizeof(*g));g->ops=*ops;g->tx=*tx;memcpy(g->rx,rx,sizeof(g->rx));g->flow=true;
+    ops->irq_mask(ops->context,true);
+    if (((rd(g,G_FW_REV)>>8)&255u)!=2) return -ENXIO;
+    if (rd(g,G_STATUS)&(G_M_ACTIVE|G_S_ACTIVE)) return -EBUSY;
+    unsigned depth=(rd(g,G_HW_PARAM1)>>16)&255u;if(depth<4)return -ENXIO;
+    wr(g,G_IRQ_EN,0);wr(g,G_GSI_EVENT,0);
+    wr(g,G_M_IRQ_EN,0);wr(g,G_S_IRQ_EN,0);wr(g,G_TX_IRQ_UNSET,UINT32_MAX);wr(g,G_RX_IRQ_UNSET,UINT32_MAX);
+    wr(g,G_M_CLEAR,UINT32_MAX);wr(g,G_S_CLEAR,UINT32_MAX);
+    wr(g,G_TX_CLEAR,UINT32_MAX);wr(g,G_RX_CLEAR,UINT32_MAX);
+    wr(g,G_CGC,rd(g,G_CGC)|0x7f);wr(g,G_DMA_CFG,rd(g,G_DMA_CFG)|0x0f);
+    wr(g,G_OUTPUT,0x7f);wr(g,G_FORCE_DEFAULT,1);
+    wr(g,G_DMA_MODE,1);wr(g,G_DMA_IF_EN,rd(g,G_DMA_IF_EN)|1);
+    /* Four 8-bit words, low byte first, same packing as geni_se_config_packing. */
+    wr(g,G_TX_PACK0,0x4380e);wr(g,G_TX_PACK1,0xc3e0e);
+    wr(g,G_RX_PACK0,0x4380e);wr(g,G_RX_PACK1,0xc3e0e);wr(g,G_BYTE_GRAN,0);
+    wr(g,G_TX_WORD,8);wr(g,G_RX_WORD,8);wr(g,G_TX_STOP,0);
+    wr(g,G_TX_PARITY,0);wr(g,G_RX_PARITY,0);wr(g,G_TX_CFG,0);wr(g,G_RX_CFG,0);
+    wr(g,G_LOOPBACK,0);wr(g,G_RX_STALE,160);wr(g,G_RX_WM,2);wr(g,G_RX_RFR_WM,depth-2);
+    rfr(g,false);barrier(g);g->state=QBT_GENI_STOPPED;return 0;
+}
+int qbt_geni_set_rate(struct qbt_geni *g,uint32_t baud,uint32_t hz,unsigned sample) {
+    if (g->state!=QBT_GENI_STOPPED || !baud || !hz || (sample!=16 && sample!=32)) return -EINVAL;
+    uint64_t target=(uint64_t)baud*sample,div=((uint64_t)hz+target/2)/target;
+    if (!div || div>4095) return -ERANGE;
+    uint64_t actual=(uint64_t)hz/div,diff=actual>target?actual-target:target-actual;
+    if (diff*100>target) return -ERANGE;
+    wr(g,G_M_CLK,((uint32_t)div<<4)|1);wr(g,G_S_CLK,((uint32_t)div<<4)|1);wr(g,G_CLK_SEL,0);
+    barrier(g);g->baud=baud;g->source_hz=hz;g->oversampling=sample;return 0;
+}
+int qbt_geni_start(struct qbt_geni *g) {
+    if (g->state!=QBT_GENI_STOPPED || !g->baud || g->rx_ready) return -EINVAL;
+    /* Reset-time line state is stale when the board releases the controller. */
+    wr(g,G_M_CLEAR,UINT32_MAX);wr(g,G_S_CLEAR,UINT32_MAX);
+    wr(g,G_TX_CLEAR,UINT32_MAX);wr(g,G_RX_CLEAR,UINT32_MAX);
+    wr(g,G_M_IRQ_EN,G_DONE|G_CMD_ERRORS|(1u<<31));
+    wr(g,G_S_IRQ_EN,G_CMD_ERRORS|G_LINE_ERRORS|(1u<<4)|(1u<<5));
+    g->state=QBT_GENI_RUN;
+    /* Linux starts the secondary sequencer with UART_PARAM_RFR_OPEN. */
+    wr(g,G_S_CMD,(1u<<27)|(1u<<7));arm_rx(g);wr(g,G_IRQ_EN,G_IRQ_MASK);barrier(g);
+    __atomic_store_n(&g->irq_pending,false,__ATOMIC_RELEASE);
+    g->ops.irq_mask(g->ops.context,false);return 0;
+}
+void qbt_geni_irq(struct qbt_geni *g) {
+    g->ops.irq_mask(g->ops.context,true);
+    __atomic_store_n(&g->irq_pending,true,__ATOMIC_RELEASE);
+    g->ops.wake_worker(g->ops.context);
+}
+static bool deliver(struct qbt_geni *g) {
+    unsigned budget=QBT_GENI_RX_COUNT;
+    while(g->rx_ready && budget--) {
+        unsigned i=g->rx_head,remaining=g->rx_length[i]-g->rx_offset;
+        size_t n=g->ops.receive(g->ops.context,g->rx[i].bytes+g->rx_offset,remaining);
+        if(n>remaining)n=remaining;g->rx_offset+=(unsigned)n;
+        if(g->rx_offset!=g->rx_length[i]) {g->stats.rx_backpressure++;return n!=0;}
+        g->rx_head=(i+1)%QBT_GENI_RX_COUNT;g->rx_ready--;g->rx_offset=0;arm_rx(g);
+    }
+    return g->rx_ready!=0;
+}
+static void fail(struct qbt_geni *g,int error) {
+    g->error=error;g->state=QBT_GENI_FAILED;g->stop_deadline=0;
+    /* DMA buffers stay pinned until reset/power-off proves DMA is stopped. */
+    rfr(g,false);wr(g,G_IRQ_EN,0);barrier(g);g->ops.irq_mask(g->ops.context,true);
+}
+bool qbt_geni_service(struct qbt_geni *g) {
+    if(g->state==QBT_GENI_OFF || g->state==QBT_GENI_STOPPED || g->state==QBT_GENI_FAILED)return false;
+    bool irq=__atomic_exchange_n(&g->irq_pending,false,__ATOMIC_ACQ_REL);
+    uint32_t mi=rd(g,G_M_IRQ),si=rd(g,G_S_IRQ),ti=rd(g,G_TX_IRQ),ri=rd(g,G_RX_IRQ);
+    if(irq)g->stats.interrupts++;
+    wr(g,G_M_CLEAR,mi);wr(g,G_S_CLEAR,si);wr(g,G_TX_CLEAR,ti);wr(g,G_RX_CLEAR,ri);
+    if(((mi|si)&G_CMD_ERRORS) || ((ti|ri)&G_DMA_ERROR) || (si&G_LINE_ERRORS) || (ri&((1u<<5)|(3u<<7)))) {
+        g->fault_irq[0]=mi;g->fault_irq[1]=si;g->fault_irq[2]=ti;g->fault_irq[3]=ri;
+    }
+    if((mi|si)&G_CMD_ERRORS || (ti|ri)&G_DMA_ERROR) {g->stats.dma_errors++;fail(g,-EIO);return false;}
+    /* Line errors drop or mark received data; the transport keeps running, as in Linux. */
+    if((si&G_LINE_ERRORS) || (ri&((1u<<5)|(3u<<7))))g->stats.line_errors++;
+    if(g->tx_busy && (ti&G_DONE)) {
+        g->ops.sync(g->ops.context,&g->tx,g->tx_length,false,true);
+        g->stats.tx_bytes+=g->tx_length;g->stats.tx_dma++;g->tx_length=0;g->tx_busy=false;
+    }
+    if(g->rx_busy && (ri&(G_DONE|G_EOT))) {
+        unsigned n=rd(g,G_RX_LEN_IN),i=g->rx_active;
+        g->rx_busy=false;
+        if(n>QBT_GENI_RX_SIZE){g->stats.dma_errors++;fail(g,-EOVERFLOW);return false;}
+        g->ops.sync(g->ops.context,&g->rx[i],n,false,false);
+        if(ri&(1u<<5))n=0; /* Parity failure: drop this completion. */
+        g->stats.rx_dma++;g->stats.rx_bytes+=n;
+        if(n){g->rx_length[i]=n;g->rx_ready++;}
+        if(g->rx_ready==QBT_GENI_RX_COUNT){rfr(g,false);g->stats.rx_pauses++;}
+        arm_rx(g);
+    }
+    bool more=deliver(g);
+    if(g->state!=QBT_GENI_RUN) {
+        uint64_t t=g->ops.now_ns(g->ops.context);
+        if(!(rd(g,G_STATUS)&G_S_ACTIVE) && !g->rx_busy && g->state!=QBT_GENI_RESET) {
+            g->stop_deadline=0;
+            if(g->rx_ready)return more;
+            g->state=QBT_GENI_STOPPED;g->stop_deadline=0;wr(g,G_IRQ_EN,0);barrier(g);
+            g->ops.irq_mask(g->ops.context,true);return more;
+        }
+        if(g->state==QBT_GENI_RESET && (ri&G_RESET_DONE)) {
+            g->rx_busy=false;
+            if(rd(g,G_STATUS)&G_S_ACTIVE){fail(g,-ETIMEDOUT);return false;}
+            g->state=QBT_GENI_CANCEL;g->stop_deadline=0;
+            if(g->rx_ready)return more;
+            g->state=QBT_GENI_STOPPED;g->stop_deadline=0;wr(g,G_IRQ_EN,0);barrier(g);
+            g->ops.irq_mask(g->ops.context,true);return more;
+        }
+        if(g->stop_deadline && t>=g->stop_deadline) {
+            g->stats.cancel_timeouts++;g->stop_deadline=t+G_STOP_TIMEOUT_NS;
+            if(g->state==QBT_GENI_CANCEL){wr(g,G_S_CTRL,G_ABORT);g->state=QBT_GENI_ABORT;}
+            else if(g->state==QBT_GENI_ABORT){wr(g,G_RX_IRQ_SET,G_RESET_DONE);wr(g,G_RX_RESET,1);g->state=QBT_GENI_RESET;}
+            else {fail(g,-ETIMEDOUT);return false;}
+        }
+    }
+    barrier(g);g->ops.irq_mask(g->ops.context,false);return more;
+}
+bool qbt_geni_drained(struct qbt_geni *g) {
+    if(g->tx_busy)return false;
+    /* M_GP_LENGTH keeps the finished command's byte count; it is not a pending count. */
+    return !(rd(g,G_STATUS)&G_M_ACTIVE) && !rd(g,G_TX_FIFO_STATUS);
+}
+size_t qbt_geni_write(struct qbt_geni *g,const uint8_t *bytes,size_t n) {
+    if(g->state!=QBT_GENI_RUN || !bytes || !n || !qbt_geni_drained(g))return 0;
+    if(n>QBT_GENI_TX_SIZE)n=QBT_GENI_TX_SIZE;
+    memcpy(g->tx.bytes,bytes,n);g->ops.sync(g->ops.context,&g->tx,n,true,true);
+    g->tx_busy=true;g->tx_length=(unsigned)n;
+    wr(g,G_TX_LEN,(uint32_t)n);wr(g,G_M_CMD,1u<<27);
+    wr(g,G_TX_IRQ_SET,G_DONE|G_EOT|G_DMA_ERROR);
+    wr(g,G_TX_PTR_L,(uint32_t)g->tx.address);wr(g,G_TX_PTR_H,(uint32_t)(g->tx.address>>32));
+    wr(g,G_TX_ATTR,1);barrier(g);wr(g,G_TX_DMA_LEN,(uint32_t)n);barrier(g);return n;
+}
+void qbt_geni_set_flow(struct qbt_geni *g,bool enabled) {
+    g->flow=enabled;uint32_t cfg=rd(g,G_TX_CFG);
+    wr(g,G_TX_CFG,enabled?(cfg&~2u):(cfg|2u));
+    rfr(g,g->rx_busy && g->state==QBT_GENI_RUN);barrier(g);
+}
+int qbt_geni_quiesce(struct qbt_geni *g) {
+    if(g->state==QBT_GENI_STOPPED)return 0;
+    if(g->state==QBT_GENI_FAILED)return g->error;
+    if(g->state!=QBT_GENI_RUN)return -EINPROGRESS;
+    if(!qbt_geni_drained(g) || g->rx_ready)return -EBUSY;
+    g->state=QBT_GENI_CANCEL;rfr(g,false);
+    g->stop_deadline=g->ops.now_ns(g->ops.context)+G_STOP_TIMEOUT_NS;
+    wr(g,G_S_CTRL,G_CANCEL);barrier(g);return -EINPROGRESS;
+}
+int qbt_geni_resume(struct qbt_geni *g) { return qbt_geni_start(g); }
+uint64_t qbt_geni_deadline(const struct qbt_geni *g) { return g->stop_deadline?g->stop_deadline:UINT64_MAX; }
