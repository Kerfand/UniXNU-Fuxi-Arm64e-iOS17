++fn keep(device: &Device) {
++    let Some(_busy) = exit_guard::enter() else {
++        return;
++    };
++    device.age_parked();
++    let shared = device.shared();
++    crate::memory::age_spares(&shared.memory, shared.vk());
++    device.keep_room_now();
++}
