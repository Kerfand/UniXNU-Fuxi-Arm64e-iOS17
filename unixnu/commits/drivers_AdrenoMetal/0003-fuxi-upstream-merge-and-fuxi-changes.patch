++fn relaxed_decorations(words: &[u32]) -> usize {
++    let mut at = 5;
++    let mut n = 0;
++    while let Some(first) = words.get(at) {
++        let (count, op) = ((first >> 16) as usize, first & 0xFFFF);
++        // OpDecorate %target RelaxedPrecision
++        if op == 71 && words.get(at + 2) == Some(&0) {
++            n += 1;
++        }
++        at += count.max(1);
++    }
++    n
++}
