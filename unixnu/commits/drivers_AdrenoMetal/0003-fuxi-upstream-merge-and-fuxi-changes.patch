++#[derive(Default)]
++struct Shared {
++    state: Mutex<State>,
++    /// Room was asked for, or the thread is asked to stop.
++    work: Condvar,
++}
++
++#[derive(Default)]
++struct State {
++    asked: bool,
++    stopping: bool,
++}
