++/// once.
++pub(crate) fn diagnostics() -> bool {
++    // 0 not read yet, 1 off, 2 on.
++    static ON: AtomicU8 = AtomicU8::new(0);
++    match ON.load(Ordering::Relaxed) {
++        0 => {
