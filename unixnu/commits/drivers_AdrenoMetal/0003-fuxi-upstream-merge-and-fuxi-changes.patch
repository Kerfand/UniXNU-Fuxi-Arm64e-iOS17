++/// An opened system layer.
++#[derive(Debug)]
++pub struct SystemLayer {
++    root: OwnedFd,
++    path: PathBuf,
++    owners: Vec<u32>,
++    accepted: AtomicU64,
++    rejected: AtomicU64,
++    refused: AtomicU64,
++    accepted_bytes: AtomicU64,
++}
