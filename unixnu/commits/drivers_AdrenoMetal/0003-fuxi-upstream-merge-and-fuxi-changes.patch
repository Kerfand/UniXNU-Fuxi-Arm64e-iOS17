++    let fast = profile("lavapipe", DevicePolicy::default()).expect("profile");
++    let kept = profile("lavapipe", exact).expect("profile");
++    assert!(crate::lower::arith::narrow::relaxes(&fast));
++    assert!(!crate::lower::arith::narrow::relaxes(&kept));
