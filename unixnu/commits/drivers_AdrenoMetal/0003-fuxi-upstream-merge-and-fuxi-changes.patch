++            std::thread::Builder::new().name("metal2vulkan-room".into()),
++            move || run(&shared, &weak),
++        ) {
++            Ok(handle) => *thread = Some(handle),
++            Err(_) => {
++                drop(thread);
++                lock(&self.shared.state).asked = false;
++                keep(device);
++            }
++        }
++    }
