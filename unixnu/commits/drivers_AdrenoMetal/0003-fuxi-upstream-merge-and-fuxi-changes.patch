++        if unsafe { libc::clock_gettime(libc::CLOCK_UPTIME_RAW, &mut spec) } == 0 {
++            return spec.tv_sec as u64 * 1_000_000_000 + spec.tv_nsec as u64;
++        }
++        0
++    }
++    #[cfg(not(any(target_os = "macos", target_os = "ios")))]
++    {
++        crate::gpu_time::host_nanos()
