+    // The large divisors need normalization before a half reciprocal can stay normal.
+    let cases = [
+        [65504.0f32, 65504.0],
+        [65504.0, 32768.0],
+        [32768.0, 65504.0],
+        [16384.0, 16384.0],
+        [16392.0, 16392.0],
