++pub(crate) struct Room {
++    shared: Arc<Shared>,
++    thread: Mutex<Option<JoinHandle<()>>>,
++}
++
++#[derive(Default)]
++struct Shared {
++    state: Mutex<State>,
++    /// Room was asked for, or the thread is asked to stop.
++    work: Condvar,
++}
