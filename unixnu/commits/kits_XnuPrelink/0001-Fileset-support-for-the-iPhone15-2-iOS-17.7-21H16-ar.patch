From ddb7afa0046668b3d44efe0cc5c986f1c442644d Mon Sep 17 00:00:00 2001
From: Kerfand <Kerfand@users.noreply.github.com>
Date: Fri, 6 Nov 2026 14:39:38 +0800
Subject: [PATCH] Fileset support for the iPhone15,2 iOS 17.7 (21H16) arm64e
 kernelcache

- fileset_layout: UNIXNU_FILESET_KERNEL_FIRST places the native kernel's
  __TEXT_EXEC at the root of the collection's __TEXT_EXEC, as xnu-10063
  requires (segPLKTEXTEXECB = segLASTB + segSizeLAST); refuses to overlap
  retained kext code.
- fileset_segmented: the corecrypto __fips_hmacs seal is optional (21H16 has
  none); the collection header's cpusubtype follows com.apple.kernel, which
  the DarwinBoot loader checks.
- fixtures/fileset-21H16-symbols.json: 51 reviewed functions and 39 reviewed
  data identities for 21H16, each pinned by original digest and recorded
  evidence (probe boots, PAC discriminator signatures, vtable slot audit,
  co-references, vdesc_name). Includes 18 corrections of reference-order and
  pure-leaf pairings found by the vtable PAC audit.

With these, the arm64e kernel boots to the root-device wait on fuxi.
---
 fileset_layout.py                   |  38 +-
 fileset_segmented.py                |   9 +
 fixtures/fileset-21H16-symbols.json | 601 ++++++++++++++++++++++++++++
 3 files changed, 636 insertions(+), 12 deletions(-)
 create mode 100644 fixtures/fileset-21H16-symbols.json

diff --git a/fileset_layout.py b/fileset_layout.py
index 28b899d..84aaae8 100644
--- a/fileset_layout.py
+++ b/fileset_layout.py
@@ -4,6 +4,7 @@ The v2 record grammar is documented by Apple's dyld mach_o/SplitSeg.cpp.
 Section zero denotes the Mach-O header; other ordinals follow load-command order.
 """
 from collections import Counter
+import os
 import struct
 
 PAGE = 0x4000
@@ -95,18 +96,31 @@ class Layout:
         # All native code follows selected kext code; XNU derives the kext-code
         # range from the start of native __TEXT_EXEC.
         code = self.roots['__TEXT_EXEC']
-        end_kept = max([code['va']] + [end for begin, end in self.occupied
-                                      if code['va'] <= begin < code['va'] + code['size']])
-        self.reserve('__TEXT_EXEC', align(end_kept))
-        self.reserve('__KLD', align(self.end('__TEXT_EXEC')))
-        self.reserve('__LAST', self.end('__KLD'))
-        code_end = self.end('__KLD')
-        # The old kernel boot segment and prelink XML are replaceable, provided
-        # no retained kext uses them. Move XML into its own mapping below.
-        if code_end > self.roots['__DATA']['va']:
-            raise ValueError('Native code would collide with collection data')
-        self.roots.pop('__TEXT_BOOT_EXEC', None)
-        code['size'] = code['filesize'] = code_end - code['va']
+        if os.environ.get('UNIXNU_FILESET_KERNEL_FIRST') == '1':
+            # xnu-10063 (iOS 17) takes the kext code as everything in the collection __TEXT_EXEC after the
+            # kernel's __LAST (arm_vm_init: segPLKTEXTEXECB = segLASTB + segSizeLAST), Apple's own order.
+            # Native code goes where the original kernel code was, ahead of every retained kext.
+            self.reserve('__TEXT_EXEC', code['va'])
+            self.reserve('__KLD', align(self.end('__TEXT_EXEC')))
+            self.reserve('__LAST', self.end('__KLD'))
+            kept = [begin for begin, end in self.occupied if code['va'] <= begin < code['va'] + code['size']]
+            if kept and self.end('__KLD') > min(kept):
+                raise ValueError(f'Native code ({self.end("__KLD") - code["va"]:#x} bytes) does not fit ahead of the '
+                                 f'retained kext code ({min(kept) - code["va"]:#x} bytes)')
+            self.roots.pop('__TEXT_BOOT_EXEC', None)
+        else:
+            end_kept = max([code['va']] + [end for begin, end in self.occupied
+                                          if code['va'] <= begin < code['va'] + code['size']])
+            self.reserve('__TEXT_EXEC', align(end_kept))
+            self.reserve('__KLD', align(self.end('__TEXT_EXEC')))
+            self.reserve('__LAST', self.end('__KLD'))
+            code_end = self.end('__KLD')
+            # The old kernel boot segment and prelink XML are replaceable, provided
+            # no retained kext uses them. Move XML into its own mapping below.
+            if code_end > self.roots['__DATA']['va']:
+                raise ValueError('Native code would collide with collection data')
+            self.roots.pop('__TEXT_BOOT_EXEC', None)
+            code['size'] = code['filesize'] = code_end - code['va']
         self.reserve('__DATA', self.roots['__DATA']['va'])
         link = self.roots['__LINKEDIT']
         for name in ('__LINKINFO', '__LINKEDIT'):
diff --git a/fileset_segmented.py b/fileset_segmented.py
index 994b116..8a46190 100644
--- a/fileset_segmented.py
+++ b/fileset_segmented.py
@@ -288,6 +288,11 @@ class SegmentedEmit(Emit):
         # corecrypto authenticates the relocated __text bytes in a fileset.
         code = next(s for s in self.native.sections if s['segment'] == '__TEXT_EXEC' and s['name'] == '__text')
         seals = [s for s in self.native.sections if s['name'] == '__fips_hmacs']
+        if not seals:
+            # A kernel that leaves corecrypto to the prelinked com.apple.kec.corecrypto (crypto bootstrap
+            # "prelinked") carries no in-kernel FIPS field; there is nothing of the kernel's to seal.
+            self.report['corecrypto_hmac_sha256'] = None
+            return
         if len(seals) != 1 or seals[0]['size'] != 32:
             raise ValueError('Expected one 32-byte corecrypto HMAC field')
         code_at = self.layout.translate(code['va']) - self.cache.base
@@ -374,5 +379,9 @@ class SegmentedEmit(Emit):
             raise ValueError('Root commands exceed header mapping')
         self.data[32:limit] = payload + bytes(limit-32-len(payload))
         struct.pack_into('<II', self.data, 16, len(rebuilt), len(payload))
+        # The collection's CPU subtype names the kernel it carries: DarwinBoot loads a fileset only when the
+        # root header and com.apple.kernel agree (an original 21H16 collection says plain arm64, 0x2, around
+        # an arm64e kernel).
+        struct.pack_into('<I', self.data, 8, struct.unpack_from('<I', self.native.data, 8)[0])
         self.report['native_base'] = hex(self.layout.placements['__TEXT'])
         self.report['native_fileoff'] = hex(self.fileoff)
