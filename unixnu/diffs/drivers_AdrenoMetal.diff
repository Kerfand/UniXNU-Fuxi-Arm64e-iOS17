diff --git a/bridge/FuxiScanoutScaleAir.c b/bridge/FuxiScanoutScaleAir.c
new file mode 100644
index 0000000..4e49a62
--- /dev/null
+++ b/bridge/FuxiScanoutScaleAir.c
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: MIT
+// fuxi (2026-11-13): the AIR of shaders/scanout_convert.ll (scanout_convert, scanout_opaque, scanout_scale) inside the plug-in, so the
+// GPU scaling kernel ships without rebuilding the Rust bridge. FUXI_SCANOUT_AIR is the assembled file (llvm-as), set by the build.
+#include <stddef.h>
+#define FUXI_STR2(x) #x
+#define FUXI_STR(x) FUXI_STR2(x)
+__asm__(".section __TEXT,__const\n"
+        ".p2align 4\n"
+        "_fuxi_scanout_air_begin:\n"
+        ".incbin \"" FUXI_STR(FUXI_SCANOUT_AIR) "\"\n"
+        "_fuxi_scanout_air_end:\n"
+        ".text\n");
+extern const unsigned char fuxi_scanout_air_begin[] __asm__("_fuxi_scanout_air_begin");
+extern const unsigned char fuxi_scanout_air_end[] __asm__("_fuxi_scanout_air_end");
+__attribute__((visibility("default"))) const void *fuxi_scanout_scale_air(size_t *length) {
+    if (length) *length = (size_t)(fuxi_scanout_air_end - fuxi_scanout_air_begin);
+    return fuxi_scanout_air_begin;
+}
