+/* The cache mode of the uncached views a client maps (the scanout and the BO views below). Write-combining is normal non-cacheable memory:
+ * the CPU still never caches the pages (so nothing changes for the GPU's non-cacheable PTEs or for the scan-out), but unlike device memory
+ * (kIOMapInhibitCache) it allows the unaligned accesses and DC ZVA that memcpy/bzero use. On fuxi backboardd's software renderer died in
+ * bzero clearing the primary display surface, an alignment fault (EXC_BAD_ACCESS 0x101, CA::OGL::SWContext::set_surface; log 203236).
+ * agx-inhibit=1 restores device memory for comparison. */
+static IOOptionBits clientUncachedMode()
+{
+    static int inhibit=-1;
+    if(inhibit<0) {unsigned value=0;PE_parse_boot_argn("agx-inhibit",&value,sizeof value);inhibit=value==1;}
+    return inhibit?kIOMapInhibitCache:kIOMapWriteCombineCache;
+}
