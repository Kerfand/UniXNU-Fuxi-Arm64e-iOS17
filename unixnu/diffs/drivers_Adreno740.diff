 #include "NativeAdrenoUserClient.h"
 #include <kern/task.h>
 #include <sys/resource_private.h>   /* PRIO_DARWIN_GPU_*: the process's GPU role, set by the system */
+// Darwin 23 has task background policy, but predates the separate GPU role API.
+// Preserve queue priorities using that real policy; report the unavailable GPU
+// role as -1 in diagnostics rather than fabricate a task_get_gpu_role export.
+#if !defined(PRIO_DARWIN_GPU_BACKGROUND) || !defined(PRIO_DARWIN_GPU_UTILITY)
+#include <sys/kdebug.h>
+// Exact XNU 10063 policy_internal.h prototype; its full header is C-only.
+extern "C" int proc_get_effective_task_policy(task_t, int);
+static int32_t nativeAdrenoTaskGpuRole(task_t) { return -1; }
+static bool nativeAdrenoTaskGpuBackground(task_t task) {
+    return proc_get_effective_task_policy(task, IMP_TASK_POLICY_DARWIN_BG) != 0;
+}
+#else
+static int32_t nativeAdrenoTaskGpuRole(task_t task) { return task_get_gpu_role(task); }
+static bool nativeAdrenoTaskGpuBackground(task_t task) {
+    const auto role = task_get_gpu_role(task);
+    return role == PRIO_DARWIN_GPU_BACKGROUND || role == PRIO_DARWIN_GPU_UTILITY;
+}
+#endif
