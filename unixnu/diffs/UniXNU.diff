++		for (uint32_t k = i; k < unixnu_sample_count && k < i + 4 && used < (int)sizeof(line) - 18; k++) {
++			used += snprintf(line + used, sizeof(line) - used, " %llx", unixnu_sample_frames[k]);
++		}
